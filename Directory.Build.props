<Project>
  <!--
    Proprietes communes a tous les projets du depot. Un projet n'y ajoute que ce
    qui lui est propre (UseWPF, OutputType...). RootNamespace, lui, se pose dans
    chaque projet : le SDK lui donne sa valeur par defaut apres ce fichier.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <OptionCompare>Binary</OptionCompare>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>

    <!-- Une seule version pour tout le depot : voir CLAUDE.md, « Les versions ». -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>Mourad KERRAM</Authors>
    <Product>mkm-wpf</Product>
    <Copyright>Copyright © 2026 Mourad KERRAM</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- Assemblies de reference de .NET Framework 4.8 : la compilation ne depend pas
         du Developer Pack installe sur le poste (ni de l'image de la CI). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
  </ItemGroup>
</Project>
