<Application x:Class="Mkm.Wpf.Showcase.Application"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mkm="urn:mkm-wpf"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- La configuration de mkm-wpf : le thème (Dashboard par défaut ; la barre de
                     la vitrine en change) et la langue (sans Language, celle de Windows, la plus
                     proche des langues de la vitrine ; Language="fr" l'imposerait). -->
                <mkm:MkmResources />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
