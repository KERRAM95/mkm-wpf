<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <!-- Vide : chaque fichier ecrit son espace de noms en entier, x:Class compris. -->
    <RootNamespace></RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Mkm.Wpf\Mkm.Wpf.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Les pages de la documentation (une par composant), lues au démarrage : doc/<id>.xml. -->
    <EmbeddedResource Include="Documentation\Pages\*.xml" LogicalName="doc/%(Filename)%(Extension)" />
    <!-- Le code des comportements d'exemple, compilé, et embarqué aussi pour être montré : comportement/<nom>.vb. -->
    <EmbeddedResource Include="Documentation\Exemples\*.vb" LogicalName="comportement/%(Filename)%(Extension)" />
    <!-- Les photos des exemples (celles de la documentation d'ui-kit) : pack://application:,,,/Documentation/Images/… -->
    <Resource Include="Documentation\Images\*" />
  </ItemGroup>

</Project>
