<!--
    La page des conteneurs : Tabs en groupe et en facettes (Strip), Fieldset simple et repliable.
-->
<UserControl x:Class="Mkm.Wpf.Showcase.ConteneursPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mkm="urn:mkm-wpf">
    <UserControl.Resources>
        <Style x:Key="Titre" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,16,0,8" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="Libelle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource mkm.text.muted.color}" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource mkm.primary.color}" Text="{mkm:T showcase.containers.title}" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource mkm.text.muted.color}" Text="{mkm:T showcase.containers.help}" />

            <TextBlock Style="{StaticResource Titre}" Text="{mkm:T showcase.containers.group}" />
            <Border BorderThickness="1" BorderBrush="{DynamicResource mkm.content.border.color}">
                <mkm:Tabs Height="140">
                    <mkm:Tab Header="{mkm:T showcase.containers.titleBlock}">
                        <TextBlock TextWrapping="Wrap" Text="{mkm:T showcase.containers.titleBlockText}" />
                    </mkm:Tab>
                    <mkm:Tab Header="{mkm:T showcase.containers.notes}">
                        <TextBlock TextWrapping="Wrap" Text="{mkm:T showcase.containers.notesText}" />
                    </mkm:Tab>
                    <mkm:Tab Header="{mkm:T showcase.containers.history}">
                        <TextBlock TextWrapping="Wrap" Text="{mkm:T showcase.containers.historyText}" />
                    </mkm:Tab>
                </mkm:Tabs>
            </Border>

            <TextBlock Style="{StaticResource Titre}" Text="{mkm:T showcase.containers.strip}" />
            <Border BorderThickness="1" BorderBrush="{DynamicResource mkm.content.border.color}">
                <mkm:Tabs Height="140" Variant="Strip">
                    <mkm:Tab Header="{mkm:T showcase.containers.properties}" Icon="{x:Static mkm:Icons.Properties}">
                        <TextBlock TextWrapping="Wrap" Text="{mkm:T showcase.containers.titleBlockText}" />
                    </mkm:Tab>
                    <mkm:Tab Header="{mkm:T showcase.containers.relations}" Icon="{x:Static mkm:Icons.Structure}">
                        <TextBlock TextWrapping="Wrap" Text="{mkm:T showcase.containers.notesText}" />
                    </mkm:Tab>
                    <mkm:Tab Header="{mkm:T showcase.containers.history}" Icon="{x:Static mkm:Icons.History}">
                        <TextBlock TextWrapping="Wrap" Text="{mkm:T showcase.containers.historyText}" />
                    </mkm:Tab>
                </mkm:Tabs>
            </Border>

            <TextBlock Style="{StaticResource Titre}" Text="{mkm:T showcase.containers.fieldsets}" />
            <mkm:Fieldset Header="{mkm:T showcase.containers.drawing}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Libelle}" Text="{mkm:T showcase.fields.reference}" />
                    <mkm:InputText Text="HS-00042" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource Libelle}" Text="{mkm:T showcase.fields.designation}" />
                    <mkm:InputText Text="{mkm:T showcase.fields.designationValue}" />
                </StackPanel>
            </mkm:Fieldset>
            <mkm:Fieldset Margin="0,16,0,0" Header="{mkm:T showcase.containers.toggleable}" Toggleable="True">
                <mkm:Checkbox Content="{mkm:T showcase.containers.option}" IsChecked="True" />
            </mkm:Fieldset>
            <mkm:Fieldset Margin="0,16,0,0" Header="{mkm:T showcase.containers.collapsed}" Toggleable="True" IsCollapsed="True">
                <mkm:Checkbox Content="{mkm:T showcase.containers.option}" />
            </mkm:Fieldset>
        </StackPanel>
    </ScrollViewer>
</UserControl>
