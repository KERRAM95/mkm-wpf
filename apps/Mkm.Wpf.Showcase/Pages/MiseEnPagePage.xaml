<!--
    La page de la mise en page : un Triptych (le panneau d'accueil à gauche, avec sa languette ; un séparateur et un
    écran vide au milieu ; des propriétés à droite), puis un écran vide seul, des séparateurs, et le panneau d'accueil
    déplié et replié.
-->
<UserControl x:Class="Mkm.Wpf.Showcase.MiseEnPagePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mkm="urn:mkm-wpf">
    <UserControl.Resources>
        <Style x:Key="Titre" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,16,0,8" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="Cadre" TargetType="Border">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource mkm.content.border.color}" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20">
            <TextBlock FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource mkm.primary.color}" Text="{mkm:T showcase.layout.title}" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                       Foreground="{DynamicResource mkm.text.muted.color}" Text="{mkm:T showcase.layout.help}" />

            <TextBlock Style="{StaticResource Titre}" Text="Triptych, WelcomePanel" />
            <Border Style="{StaticResource Cadre}" Height="360">
                <mkm:Triptych x:Name="Disposition" LeftVisible="True" LeftSize="220" RightVisible="True" RightSize="250"
                              ShowLeftToggle="True" ShowRightCloseIcon="True">
                    <mkm:Triptych.Left>
                        <mkm:WelcomePanel x:Name="Accueil" Title="HS CART" Description="{mkm:T showcase.layout.description}" Selection="recents">
                            <mkm:WelcomePanelSection Header="{mkm:T showcase.layout.drawings}">
                                <mkm:WelcomePanelItem Key="recents" Icon="{x:Static mkm:Icons.History}" Content="{mkm:T showcase.layout.recent}" />
                                <mkm:WelcomePanelItem Key="tous" Icon="{x:Static mkm:Icons.Drawings}" Content="{mkm:T showcase.layout.allDrawings}" />
                                <mkm:WelcomePanelItem Key="articles" Icon="{x:Static mkm:Icons.Documents}" Content="{mkm:T showcase.layout.parts}" />
                            </mkm:WelcomePanelSection>
                            <mkm:WelcomePanelSeparator />
                            <mkm:WelcomePanelSection>
                                <mkm:WelcomePanelItem Key="sync" Selectable="False" Icon="{x:Static mkm:Icons.Refresh}" Content="{mkm:T showcase.layout.sync}" />
                                <mkm:WelcomePanelItem Key="reglages" Icon="{x:Static mkm:Icons.Settings}" Content="{mkm:T showcase.actionbar.settings}" />
                            </mkm:WelcomePanelSection>
                        </mkm:WelcomePanel>
                    </mkm:Triptych.Left>
                    <mkm:Splitter BorderThickness="0">
                        <mkm:SplitterPanel Size="55">
                            <mkm:EmptyContent Size="Small" Icon="{x:Static mkm:Icons.Drawings}"
                                              Title="{mkm:T showcase.layout.emptyTitle}" Message="{mkm:T showcase.layout.emptyMessage}" />
                        </mkm:SplitterPanel>
                        <mkm:SplitterPanel Size="45" Padding="12">
                            <TextBlock TextWrapping="Wrap" Text="{mkm:T showcase.layout.splitterText}" />
                        </mkm:SplitterPanel>
                    </mkm:Splitter>
                    <mkm:Triptych.Right>
                        <StackPanel Margin="12,10">
                            <TextBlock FontWeight="Bold" Text="{mkm:T showcase.containers.properties}" />
                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{mkm:T showcase.layout.rightText}" />
                        </StackPanel>
                    </mkm:Triptych.Right>
                </mkm:Triptych>
            </Border>

            <TextBlock Style="{StaticResource Titre}" Text="EmptyContent" />
            <Border Style="{StaticResource Cadre}">
                <mkm:EmptyContent Icon="{x:Static mkm:Icons.Documents}" Title="{mkm:T showcase.layout.emptyTitle}"
                                  Message="{mkm:T showcase.layout.emptyMessage}">
                    <mkm:EmptyContentItem Icon="{x:Static mkm:Icons.Open}" Content="{mkm:T showcase.layout.openOne}" />
                    <mkm:EmptyContentItem Icon="{x:Static mkm:Icons.Add}" Content="{mkm:T showcase.layout.createOne}" />
                    <mkm:EmptyContent.Actions>
                        <mkm:Button Content="{mkm:T showcase.layout.open}" Icon="{x:Static mkm:Icons.Open}" />
                    </mkm:EmptyContent.Actions>
                </mkm:EmptyContent>
            </Border>

            <TextBlock Style="{StaticResource Titre}" Text="Splitter" />
            <mkm:Splitter x:Name="Partage" Height="90">
                <mkm:SplitterPanel Size="25" MinSize="10" Padding="8"><TextBlock Text="25 %" /></mkm:SplitterPanel>
                <mkm:SplitterPanel Size="50" Padding="8"><TextBlock Text="50 %" /></mkm:SplitterPanel>
                <mkm:SplitterPanel Size="25" Padding="8"><TextBlock Text="25 %" /></mkm:SplitterPanel>
            </mkm:Splitter>
            <mkm:Splitter Orientation="Vertical" Height="140" Margin="0,8,0,0">
                <mkm:SplitterPanel Padding="8"><TextBlock Text="{mkm:T showcase.layout.top}" /></mkm:SplitterPanel>
                <mkm:SplitterPanel Padding="8"><TextBlock Text="{mkm:T showcase.layout.bottom}" /></mkm:SplitterPanel>
            </mkm:Splitter>

            <TextBlock Style="{StaticResource Titre}" Text="{mkm:T showcase.layout.welcomeStates}" />
            <StackPanel Orientation="Horizontal">
                <Border Style="{StaticResource Cadre}" Width="220" Height="230">
                    <mkm:WelcomePanel Selection="tous">
                        <mkm:WelcomePanelSection Header="{mkm:T showcase.layout.drawings}">
                            <mkm:WelcomePanelItem Key="recents" Icon="{x:Static mkm:Icons.History}" Content="{mkm:T showcase.layout.recent}" />
                            <mkm:WelcomePanelItem Key="tous" Icon="{x:Static mkm:Icons.Drawings}" Content="{mkm:T showcase.layout.allDrawings}" />
                            <mkm:WelcomePanelItem Key="off" Icon="{x:Static mkm:Icons.Blocked}" Content="{mkm:T showcase.buttons.disabled}" IsEnabled="False" />
                        </mkm:WelcomePanelSection>
                    </mkm:WelcomePanel>
                </Border>
                <Border Style="{StaticResource Cadre}" Height="230" Margin="16,0,0,0" HorizontalAlignment="Left">
                    <mkm:WelcomePanel Selection="tous" IsCollapsed="True">
                        <mkm:WelcomePanelSection Header="{mkm:T showcase.layout.drawings}">
                            <mkm:WelcomePanelItem Key="recents" Icon="{x:Static mkm:Icons.History}" Content="{mkm:T showcase.layout.recent}" />
                            <mkm:WelcomePanelItem Key="tous" Icon="{x:Static mkm:Icons.Drawings}" Content="{mkm:T showcase.layout.allDrawings}" />
                            <mkm:WelcomePanelItem Key="off" Icon="{x:Static mkm:Icons.Blocked}" Content="{mkm:T showcase.buttons.disabled}" IsEnabled="False" />
                        </mkm:WelcomePanelSection>
                    </mkm:WelcomePanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
