<!--
    La page du texte, de la date et de la confirmation : Textarea (3 lignes, qui grandit, invalide, grisée),
    DatePicker (vide, choisie, invalide, grisé) et ConfirmDialog.
-->
<UserControl x:Class="Mkm.Wpf.Showcase.SaisiePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mkm="urn:mkm-wpf">
    <UserControl.Resources>
        <Style x:Key="Titre" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,16,0,8" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="Libelle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource mkm.text.muted.color}" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource mkm.primary.color}" Text="{mkm:T showcase.inputs.title}" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource mkm.text.muted.color}" Text="{mkm:T showcase.inputs.help}" />

            <WrapPanel>
                <StackPanel Width="280" Margin="0,0,32,0">
                    <TextBlock Style="{StaticResource Titre}" Text="Textarea" />
                    <TextBlock Style="{StaticResource Libelle}" Text="{mkm:T showcase.inputs.notes}" />
                    <mkm:Textarea Rows="3" Placeholder="{mkm:T showcase.inputs.notesHint}" />
                    <TextBlock Style="{StaticResource Libelle}" Text="{mkm:T showcase.inputs.autoResize}" />
                    <mkm:Textarea AutoResize="True" Text="{mkm:T showcase.properties.notesValue}" />
                    <TextBlock Style="{StaticResource Libelle}" Text="{mkm:T showcase.fields.invalid}" />
                    <mkm:Textarea Invalid="True" Placeholder="{mkm:T showcase.inputs.notesHint}" />
                    <TextBlock Style="{StaticResource Libelle}" Text="{mkm:T showcase.fields.disabled}" />
                    <mkm:Textarea IsEnabled="False" Text="{mkm:T showcase.properties.notesValue}" />
                </StackPanel>
                <StackPanel Width="280">
                    <TextBlock Style="{StaticResource Titre}" Text="DatePicker" />
                    <TextBlock Style="{StaticResource Libelle}" Text="{mkm:T showcase.inputs.date}" />
                    <mkm:DatePicker Placeholder="{mkm:T showcase.inputs.dateHint}" />
                    <TextBlock Style="{StaticResource Libelle}" Text="{mkm:T showcase.properties.date}" />
                    <mkm:DatePicker x:Name="Choisie" />
                    <TextBlock Style="{StaticResource Libelle}" Text="{mkm:T showcase.fields.invalid}" />
                    <mkm:DatePicker Invalid="True" Placeholder="{mkm:T showcase.inputs.dateHint}" />
                    <TextBlock Style="{StaticResource Libelle}" Text="{mkm:T showcase.fields.disabled}" />
                    <mkm:DatePicker x:Name="Grisee" IsEnabled="False" />
                </StackPanel>
            </WrapPanel>

            <TextBlock Style="{StaticResource Titre}" Text="{mkm:T showcase.inputs.confirm}" />
            <StackPanel Orientation="Horizontal">
                <mkm:Button x:Name="Demander" Content="{mkm:T showcase.inputs.ask}" Click="Demander_Click" />
                <TextBlock x:Name="Reponse" Margin="12,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource mkm.text.muted.color}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
