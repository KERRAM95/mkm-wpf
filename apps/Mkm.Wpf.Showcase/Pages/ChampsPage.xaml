<!--
    La page des champs : InputText et Select dans leurs états (aide, lecture seule, grisé, invalide,
    éditable, longue liste virtualisée). Un libellé simple les nomme ici ; celui de mkm viendra avec
    la fiche de propriétés.
-->
<UserControl x:Class="Mkm.Wpf.Showcase.ChampsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mkm="urn:mkm-wpf">
    <UserControl.Resources>
        <Style x:Key="Libelle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,12,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource mkm.text.muted.color}" />
        </Style>
        <Style x:Key="Titre" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20">
            <TextBlock FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource mkm.primary.color}" Text="{mkm:T showcase.fields.title}" />
            <TextBlock Margin="0,6,0,16" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                       Foreground="{DynamicResource mkm.text.muted.color}" Text="{mkm:T showcase.fields.help}" />

            <WrapPanel>
                <StackPanel Width="280" Margin="0,0,32,0">
                    <TextBlock Style="{StaticResource Titre}" Text="InputText" />
                    <TextBlock Style="{StaticResource Libelle}" Text="{mkm:T showcase.fields.reference}" />
                    <mkm:InputText CharacterCasing="Upper" MaxLength="15" Placeholder="{mkm:T showcase.fields.referenceHint}" />
                    <TextBlock Style="{StaticResource Libelle}" Text="{mkm:T showcase.fields.designation}" />
                    <mkm:InputText Text="{mkm:T showcase.fields.designationValue}" />
                    <TextBlock Style="{StaticResource Libelle}" Text="{mkm:T showcase.fields.readonly}" />
                    <mkm:InputText IsReadOnly="True" Text="ABC-123" />
                    <TextBlock Style="{StaticResource Libelle}" Text="{mkm:T showcase.fields.disabled}" />
                    <mkm:InputText IsEnabled="False" Text="ABC-123" />
                    <TextBlock Style="{StaticResource Libelle}" Text="{mkm:T showcase.fields.invalid}" />
                    <mkm:InputText Invalid="True" Placeholder="{mkm:T showcase.fields.referenceHint}" />
                </StackPanel>

                <StackPanel Width="280">
                    <TextBlock Style="{StaticResource Titre}" Text="Select" />
                    <TextBlock Style="{StaticResource Libelle}" Text="{mkm:T showcase.fields.maturity}" />
                    <mkm:Select Placeholder="{mkm:T showcase.fields.choose}">
                        <ComboBoxItem Content="Private" />
                        <ComboBoxItem Content="In Work" />
                        <ComboBoxItem Content="Frozen" />
                        <ComboBoxItem Content="Released" />
                    </mkm:Select>
                    <TextBlock Style="{StaticResource Libelle}" Text="{mkm:T showcase.fields.scale}" />
                    <mkm:Select IsEditable="True" Text="1:3">
                        <ComboBoxItem Content="1:1" />
                        <ComboBoxItem Content="1:2" />
                        <ComboBoxItem Content="1:5" />
                        <ComboBoxItem Content="1:10" />
                        <ComboBoxItem Content="2:1" />
                    </mkm:Select>
                    <TextBlock Style="{StaticResource Libelle}" Text="{mkm:T showcase.fields.long}" />
                    <mkm:Select x:Name="Longue" Placeholder="{mkm:T showcase.fields.choose}" />
                    <TextBlock Style="{StaticResource Libelle}" Text="{mkm:T showcase.fields.disabled}" />
                    <mkm:Select IsEnabled="False" SelectedIndex="0">
                        <ComboBoxItem Content="Released" />
                    </mkm:Select>
                    <TextBlock Style="{StaticResource Libelle}" Text="{mkm:T showcase.fields.invalid}" />
                    <mkm:Select Invalid="True" Placeholder="{mkm:T showcase.fields.choose}">
                        <ComboBoxItem Content="Private" />
                    </mkm:Select>
                </StackPanel>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
