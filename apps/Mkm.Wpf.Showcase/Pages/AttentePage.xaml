<!--
    La page de l'attente et de l'aide : ProgressBar (une valeur qui avance, indéterminée), ProgressSpinner à trois
    tailles, BlockUI sur un groupe de champs, et l'info-bulle de mkm sur des boutons.
-->
<UserControl x:Class="Mkm.Wpf.Showcase.AttentePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mkm="urn:mkm-wpf">
    <UserControl.Resources>
        <Style x:Key="Titre" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,16,0,8" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource mkm.primary.color}" Text="{mkm:T showcase.waiting.title}" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource mkm.text.muted.color}" Text="{mkm:T showcase.waiting.help}" />

            <TextBlock Style="{StaticResource Titre}" Text="{mkm:T showcase.waiting.progress}" />
            <DockPanel>
                <mkm:Button DockPanel.Dock="Right" Margin="12,0,0,0" Severity="Secondary"
                            Content="{mkm:T showcase.waiting.advance}" Click="Avancer_Click" />
                <TextBlock x:Name="Pourcentage" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" Text="40 %" />
                <mkm:ProgressBar x:Name="Barre" Value="40" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Margin="0,12,0,6" Foreground="{DynamicResource mkm.text.muted.color}" Text="{mkm:T showcase.waiting.indeterminate}" />
            <mkm:ProgressBar IsIndeterminate="True" />

            <TextBlock Style="{StaticResource Titre}" Text="{mkm:T showcase.waiting.spinner}" />
            <StackPanel Orientation="Horizontal">
                <mkm:ProgressSpinner />
                <mkm:ProgressSpinner Width="40" Height="40" Margin="24,0" VerticalAlignment="Center" />
                <mkm:ProgressSpinner Width="24" Height="24" StrokeWidth="4" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Style="{StaticResource Titre}" Text="{mkm:T showcase.waiting.block}" />
            <mkm:BlockUI x:Name="Voile">
                <mkm:BlockUI.Overlay>
                    <StackPanel>
                        <mkm:ProgressSpinner Width="40" Height="40" Stroke="{DynamicResource mkm.mask.color}" />
                        <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Text="{mkm:T showcase.waiting.updating}" />
                    </StackPanel>
                </mkm:BlockUI.Overlay>
                <mkm:Fieldset Header="{mkm:T showcase.containers.drawing}">
                    <StackPanel>
                        <mkm:InputText x:Name="ChampVoile" Text="HS-00042" Margin="0,0,0,8" />
                        <mkm:InputText Text="{mkm:T showcase.fields.designationValue}" />
                    </StackPanel>
                </mkm:Fieldset>
            </mkm:BlockUI>
            <mkm:Button x:Name="Bloquer" Margin="0,8,0,0" HorizontalAlignment="Left" Content="{mkm:T showcase.waiting.blockNow}" Click="Bloquer_Click" />

            <TextBlock Style="{StaticResource Titre}" Text="{mkm:T showcase.waiting.tooltips}" />
            <StackPanel Orientation="Horizontal">
                <mkm:Button Content="{mkm:T showcase.waiting.hover}" ToolTip="{mkm:T showcase.waiting.tooltipText}" />
                <mkm:Button Margin="8,0,0,0" Icon="{x:Static mkm:Icons.Refresh}" Severity="Secondary"
                            ToolTip="{mkm:T showcase.actionbar.refresh}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
