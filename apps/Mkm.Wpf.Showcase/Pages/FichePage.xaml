<!--
    La page de la fiche de propriétés : une fiche d'un plan, ses sections Cartouche, Notes et Options ; son bouton
    Modifier montre les éditeurs, la marque des propriétés obligatoires et un message ; une case met les libellés
    devant les valeurs.
-->
<UserControl x:Class="Mkm.Wpf.Showcase.FichePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mkm="urn:mkm-wpf">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20" MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource mkm.primary.color}" Text="{mkm:T showcase.properties.title}" />
            <TextBlock Margin="0,6,0,8" TextWrapping="Wrap"
                       Foreground="{DynamicResource mkm.text.muted.color}" Text="{mkm:T showcase.properties.help}" />
            <mkm:Checkbox x:Name="EnLigne" Content="{mkm:T showcase.properties.inline}" Checked="Disposition_Changed" Unchecked="Disposition_Changed" />

            <mkm:PropertyPanel x:Name="Fiche" Margin="0,8,0,0" Editable="True" Save="Fiche_Save">
                <mkm:PropertyPanel.Header>
                    <TextBlock FontSize="14" FontWeight="Bold" Text="{mkm:T showcase.properties.drawing}" />
                </mkm:PropertyPanel.Header>
                <mkm:PropertySection Header="{mkm:T showcase.properties.titleBlock}" IsExpanded="True">
                    <mkm:PropertyRow Label="{mkm:T showcase.properties.reference}" Required="True"
                                     Value="{Binding Text, ElementName=Reference}">
                        <mkm:InputText x:Name="Reference" Text="HS-00042" CharacterCasing="Upper" />
                    </mkm:PropertyRow>
                    <mkm:PropertyRow Label="{mkm:T showcase.properties.designation}" Required="True"
                                     Value="{Binding Text, ElementName=Designation}">
                        <mkm:InputText x:Name="Designation" Text="{mkm:T showcase.fields.designationValue}" />
                    </mkm:PropertyRow>
                    <mkm:PropertyRow Label="{mkm:T showcase.properties.scale}" Value="{Binding Text, ElementName=Echelle}"
                                     Message="{mkm:T showcase.properties.scaleMessage}" MessageSeverity="Warn">
                        <mkm:Select x:Name="Echelle" IsEditable="True" Text="1:2">
                            <ComboBoxItem Content="1:1" />
                            <ComboBoxItem Content="1:2" />
                            <ComboBoxItem Content="1:5" />
                        </mkm:Select>
                    </mkm:PropertyRow>
                    <mkm:PropertyRow x:Name="LigneDate" Label="{mkm:T showcase.properties.date}">
                        <mkm:DatePicker x:Name="LaDate" />
                    </mkm:PropertyRow>
                    <mkm:PropertyRow Label="{mkm:T showcase.properties.revision}" Value="B" ReadOnly="True"
                                     Note="{mkm:T showcase.properties.revisionNote}" />
                </mkm:PropertySection>
                <mkm:PropertySection Header="{mkm:T showcase.properties.notes}">
                    <mkm:PropertyRow Label="{mkm:T showcase.properties.notes}" Value="{Binding Text, ElementName=LesNotes}">
                        <mkm:Textarea x:Name="LesNotes" Rows="3" Text="{mkm:T showcase.properties.notesValue}" />
                    </mkm:PropertyRow>
                </mkm:PropertySection>
                <mkm:PropertySection Header="{mkm:T showcase.properties.options}">
                    <mkm:PropertyRow Label="{mkm:T showcase.properties.sync}" Value="{mkm:T showcase.properties.yes}">
                        <mkm:Checkbox IsChecked="True" />
                    </mkm:PropertyRow>
                </mkm:PropertySection>
            </mkm:PropertyPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
