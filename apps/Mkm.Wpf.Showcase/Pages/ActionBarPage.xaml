<!--
    La page de l'ActionBar : la barre en bas de la page, comme dans 3DEXPERIENCE, avec deux
    sections et une troisième assez longue pour défiler, des commandes fixes, une bascule, une
    liste, un séparateur et une commande grisée ; au-dessus, le journal des commandes lancées.
-->
<UserControl x:Class="Mkm.Wpf.Showcase.ActionBarPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mkm="urn:mkm-wpf">
    <Grid>
        <DockPanel Margin="24,20,24,120">
            <TextBlock DockPanel.Dock="Top" FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource mkm.primary.color}" Text="{mkm:T showcase.actionbar.title}" />
            <TextBlock DockPanel.Dock="Top" Margin="0,6,0,16" TextWrapping="Wrap"
                       Foreground="{DynamicResource mkm.text.muted.color}" Text="{mkm:T showcase.actionbar.help}" />
            <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" FontWeight="Bold" Text="{mkm:T showcase.actionbar.log}" />
            <ItemsControl x:Name="Journal" />
        </DockPanel>

        <mkm:ActionBar ActiveSection="edit" ButtonBase.Click="Commande_Click">
            <mkm:ActionBar.FixedItems>
                <mkm:ActionBarButton Label="{mkm:T showcase.actionbar.save}" Icon="{x:Static mkm:Icons.Download}" />
            </mkm:ActionBar.FixedItems>

            <mkm:ActionBarSection Key="edit" Header="{mkm:T showcase.actionbar.edit}">
                <mkm:ActionBarButton Label="{mkm:T showcase.actionbar.add}" Icon="{x:Static mkm:Icons.Add}" />
                <mkm:ActionBarButton Label="{mkm:T showcase.actionbar.copy}" Icon="{x:Static mkm:Icons.Copy}" />
                <mkm:ActionBarButton Label="{mkm:T showcase.actionbar.delete}" Icon="{x:Static mkm:Icons.Delete}"
                                     Hint="{mkm:T showcase.actionbar.deleteHint}" IsEnabled="False" />
                <mkm:ActionBarSeparator />
                <mkm:ActionBarToggleButton Label="{mkm:T showcase.actionbar.lock}" Icon="{x:Static mkm:Icons.Locked}" />
                <mkm:ActionBarDropDown>
                    <mkm:ActionBarButton Label="{mkm:T showcase.actionbar.zoomIn}" Icon="{x:Static mkm:Icons.ZoomIn}" />
                    <mkm:ActionBarButton Label="{mkm:T showcase.actionbar.zoomOut}" Icon="{x:Static mkm:Icons.ZoomOut}" />
                    <mkm:ActionBarButton Label="{mkm:T showcase.actionbar.fit}" Icon="{x:Static mkm:Icons.Fit}" />
                </mkm:ActionBarDropDown>
            </mkm:ActionBarSection>

            <mkm:ActionBarSection Key="view" Header="{mkm:T showcase.actionbar.view}">
                <mkm:ActionBarToggleButton Label="{mkm:T showcase.actionbar.show}" Icon="{x:Static mkm:Icons.Show}" IsChecked="True" />
                <mkm:ActionBarButton Label="{mkm:T showcase.actionbar.refresh}" Icon="{x:Static mkm:Icons.Refresh}" />
                <mkm:ActionBarButton Label="{mkm:T showcase.actionbar.settings}" Icon="{x:Static mkm:Icons.Settings}" />
            </mkm:ActionBarSection>

            <mkm:ActionBarSection Key="tools" Header="{mkm:T showcase.actionbar.tools}">
                <mkm:ActionBarButton Label="{mkm:T showcase.actionbar.search}" Icon="{x:Static mkm:Icons.Search}" />
                <mkm:ActionBarButton Label="{mkm:T showcase.actionbar.filter}" Icon="{x:Static mkm:Icons.Filter}" />
                <mkm:ActionBarButton Label="{mkm:T showcase.actionbar.sort}" Icon="{x:Static mkm:Icons.Sort}" />
                <mkm:ActionBarSeparator />
                <mkm:ActionBarButton Label="{mkm:T showcase.actionbar.history}" Icon="{x:Static mkm:Icons.History}" />
                <mkm:ActionBarButton Label="{mkm:T showcase.actionbar.import}" Icon="{x:Static mkm:Icons.Import}" />
                <mkm:ActionBarButton Label="{mkm:T showcase.actionbar.export}" Icon="{x:Static mkm:Icons.Export}" />
                <mkm:ActionBarButton Label="{mkm:T showcase.actionbar.upload}" Icon="{x:Static mkm:Icons.Upload}" />
                <mkm:ActionBarButton Label="{mkm:T showcase.actionbar.download}" Icon="{x:Static mkm:Icons.Download}" />
                <mkm:ActionBarSeparator />
                <mkm:ActionBarButton Label="{mkm:T showcase.actionbar.structure}" Icon="{x:Static mkm:Icons.Structure}" />
                <mkm:ActionBarButton Label="{mkm:T showcase.actionbar.statistics}" Icon="{x:Static mkm:Icons.Statistics}" />
                <mkm:ActionBarButton Label="{mkm:T showcase.actionbar.settings}" Icon="{x:Static mkm:Icons.Settings}" />
            </mkm:ActionBarSection>
        </mkm:ActionBar>
    </Grid>
</UserControl>
