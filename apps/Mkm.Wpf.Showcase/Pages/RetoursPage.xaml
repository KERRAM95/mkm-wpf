<!--
    La page des retours : Message dans chaque gravité, chaque forme et chaque taille, un message qui se ferme ; les
    notifications (le Toast de la fenêtre) ; le dialogue, une vraie fenêtre modale.
-->
<UserControl x:Class="Mkm.Wpf.Showcase.RetoursPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mkm="urn:mkm-wpf">
    <UserControl.Resources>
        <Style x:Key="Titre" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,16,0,8" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style TargetType="mkm:Message">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style TargetType="mkm:Button">
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource mkm.primary.color}" Text="{mkm:T showcase.feedback.title}" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource mkm.text.muted.color}" Text="{mkm:T showcase.feedback.help}" />

            <TextBlock Style="{StaticResource Titre}" Text="{mkm:T showcase.feedback.messages}" />
            <mkm:Message Severity="Info" Icon="{x:Static mkm:Icons.Info}" Content="{mkm:T showcase.feedback.info}" />
            <mkm:Message Severity="Success" Icon="{x:Static mkm:Icons.Success}" Content="{mkm:T showcase.feedback.success}" />
            <mkm:Message Severity="Warn" Icon="{x:Static mkm:Icons.Warning}" Content="{mkm:T showcase.feedback.warn}" />
            <mkm:Message Severity="Error" Icon="{x:Static mkm:Icons.Error}" Content="{mkm:T showcase.feedback.error}" />
            <mkm:Message Severity="Secondary" Content="{mkm:T showcase.feedback.secondary}" />
            <mkm:Message Severity="Contrast" Content="{mkm:T showcase.feedback.contrast}" />

            <TextBlock Style="{StaticResource Titre}" Text="{mkm:T showcase.feedback.forms}" />
            <mkm:Message Severity="Warn" Variant="Outlined" Icon="{x:Static mkm:Icons.Warning}" Content="{mkm:T showcase.feedback.warn}" />
            <mkm:Message Severity="Error" Variant="Simple" Icon="{x:Static mkm:Icons.Error}" Content="{mkm:T showcase.feedback.error}" />
            <mkm:Message Severity="Info" Size="Small" Icon="{x:Static mkm:Icons.Info}" Content="{mkm:T showcase.feedback.info}" />
            <mkm:Message Severity="Info" Size="Large" Icon="{x:Static mkm:Icons.Info}" Content="{mkm:T showcase.feedback.info}" />

            <TextBlock Style="{StaticResource Titre}" Text="{mkm:T showcase.feedback.closable}" />
            <mkm:Message x:Name="Ephemere" Severity="Success" Closable="True" Life="0:0:5"
                         Icon="{x:Static mkm:Icons.Success}" Content="{mkm:T showcase.feedback.success}" />
            <WrapPanel>
                <mkm:Button Severity="Secondary" Content="{mkm:T showcase.feedback.again}" Click="Remontrer_Click" />
            </WrapPanel>

            <TextBlock Style="{StaticResource Titre}" Text="{mkm:T showcase.feedback.toasts}" />
            <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource mkm.text.muted.color}"
                       Text="{mkm:T showcase.feedback.toastHint}" />
            <WrapPanel>
                <mkm:Button Content="Info" Severity="Info" Tag="Info" Click="Notifier_Click" />
                <mkm:Button Content="Success" Severity="Success" Tag="Success" Click="Notifier_Click" />
                <mkm:Button Content="Warn" Severity="Warn" Tag="Warn" Click="Notifier_Click" />
                <mkm:Button Content="Error" Severity="Danger" Tag="Error" Click="Notifier_Click" />
                <mkm:Button Content="{mkm:T showcase.feedback.sticky}" Severity="Secondary" Click="Durable_Click" />
                <mkm:Button Content="{mkm:T showcase.feedback.clear}" Severity="Secondary" Variant="Outlined" Click="ToutFermer_Click" />
            </WrapPanel>

            <TextBlock Style="{StaticResource Titre}" Text="{mkm:T showcase.feedback.dialogs}" />
            <WrapPanel>
                <mkm:Button Content="{mkm:T showcase.feedback.open}" Click="Renommer_Click" />
                <mkm:Button Content="{mkm:T showcase.feedback.openResizable}" Severity="Secondary" Click="Etirable_Click" />
            </WrapPanel>
            <TextBlock x:Name="Resultat" Foreground="{DynamicResource mkm.text.muted.color}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
