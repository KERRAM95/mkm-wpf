<!--
    La page de l'arbre et du menu : un arbre de notes, dont le clic droit ouvre le menu contextuel de mkm (icônes,
    raccourcis, trait, commande grisée, sous-menu), et un menu sans icônes.
-->
<UserControl x:Class="Mkm.Wpf.Showcase.ArbrePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mkm="urn:mkm-wpf">
    <UserControl.Resources>
        <Style x:Key="Titre" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,16,0,8" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource mkm.primary.color}" Text="{mkm:T showcase.tree.title}" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource mkm.text.muted.color}" Text="{mkm:T showcase.tree.help}" />

            <TextBlock Style="{StaticResource Titre}" Text="Tree" />
            <Border BorderThickness="1" BorderBrush="{DynamicResource mkm.content.border.color}" Width="320" HorizontalAlignment="Left">
                <mkm:Tree x:Name="Arbre" Height="240">
                    <mkm:Tree.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{mkm:T showcase.tree.add}" Icon="{x:Static mkm:Icons.Add}" InputGestureText="Ctrl+N" />
                            <MenuItem Header="{mkm:T showcase.tree.copy}" Icon="{x:Static mkm:Icons.Copy}" InputGestureText="Ctrl+C" />
                            <MenuItem Header="{mkm:T showcase.tree.rename}" Icon="{x:Static mkm:Icons.Rename}" InputGestureText="F2" />
                            <Separator />
                            <MenuItem Header="{mkm:T showcase.tree.more}">
                                <MenuItem Header="{mkm:T showcase.tree.export}" Icon="{x:Static mkm:Icons.Export}" />
                                <MenuItem Header="{mkm:T showcase.tree.import}" Icon="{x:Static mkm:Icons.Import}" />
                            </MenuItem>
                            <MenuItem Header="{mkm:T showcase.tree.delete}" Icon="{x:Static mkm:Icons.Delete}" InputGestureText="Suppr" IsEnabled="False" />
                        </ContextMenu>
                    </mkm:Tree.ContextMenu>
                    <mkm:TreeNode Header="{mkm:T showcase.tree.notes}" Icon="{x:Static mkm:Icons.Documents}" IsExpanded="True">
                        <mkm:TreeNode Header="{mkm:T showcase.tree.general}" Icon="{x:Static mkm:Icons.Document}" IsExpanded="True">
                            <mkm:TreeNode Header="{mkm:T showcase.tree.note1}" IsSelected="True" />
                            <mkm:TreeNode Header="{mkm:T showcase.tree.note2}" />
                        </mkm:TreeNode>
                        <mkm:TreeNode Header="{mkm:T showcase.tree.welding}" Icon="{x:Static mkm:Icons.Document}">
                            <mkm:TreeNode Header="{mkm:T showcase.tree.note3}" />
                        </mkm:TreeNode>
                    </mkm:TreeNode>
                    <mkm:TreeNode Header="{mkm:T showcase.tree.history}" Icon="{x:Static mkm:Icons.History}">
                        <mkm:TreeNode Header="{mkm:T showcase.tree.revA}" />
                        <mkm:TreeNode Header="{mkm:T showcase.tree.revB}" />
                    </mkm:TreeNode>
                </mkm:Tree>
            </Border>

            <TextBlock Style="{StaticResource Titre}" Text="{mkm:T showcase.tree.noIcons}" />
            <Border Width="320" Height="60" HorizontalAlignment="Left" Background="{DynamicResource mkm.content.hover.background}">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{mkm:T showcase.tree.copy}" InputGestureText="Ctrl+C" />
                        <MenuItem Header="{mkm:T showcase.tree.rename}" />
                        <MenuItem Header="{mkm:T showcase.tree.delete}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource mkm.text.muted.color}" Text="{mkm:T showcase.tree.rightClick}" />
            </Border>

            <TextBlock Style="{StaticResource Titre}" Text="Menu, TieredMenu" />
            <StackPanel Orientation="Horizontal">
                <mkm:Menu x:Name="MenuPose">
                    <mkm:MenuGroup Header="{mkm:T showcase.tree.drawing}">
                        <MenuItem Header="{mkm:T showcase.layout.open}" Icon="{x:Static mkm:Icons.Open}" InputGestureText="Ctrl+O" />
                        <MenuItem Header="{mkm:T showcase.tree.export}" Icon="{x:Static mkm:Icons.Export}" />
                    </mkm:MenuGroup>
                    <mkm:MenuGroup Header="{mkm:T showcase.tree.notes}">
                        <MenuItem Header="{mkm:T showcase.tree.add}" Icon="{x:Static mkm:Icons.Add}" InputGestureText="Ctrl+N" />
                        <MenuItem Header="{mkm:T showcase.tree.delete}" IsEnabled="False" />
                    </mkm:MenuGroup>
                    <Separator />
                    <MenuItem Header="{mkm:T showcase.actionbar.settings}" Icon="{x:Static mkm:Icons.Settings}" />
                </mkm:Menu>
                <mkm:TieredMenu x:Name="MenuAEtages" Margin="24,0,0,0" VerticalAlignment="Top">
                    <MenuItem Header="{mkm:T showcase.tree.export}" Icon="{x:Static mkm:Icons.Export}">
                        <MenuItem Header="PDF" />
                        <MenuItem Header="DXF" />
                    </MenuItem>
                    <MenuItem Header="{mkm:T showcase.tree.import}" Icon="{x:Static mkm:Icons.Import}">
                        <MenuItem Header="{mkm:T showcase.tree.fromFile}" />
                        <MenuItem Header="{mkm:T showcase.tree.from3dx}" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="{mkm:T showcase.actionbar.refresh}" Icon="{x:Static mkm:Icons.Refresh}" InputGestureText="F5" />
                </mkm:TieredMenu>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
