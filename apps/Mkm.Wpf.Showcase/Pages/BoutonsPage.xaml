<!--
    La page des boutons : Button dans chaque gravité et chaque forme, avec une icône, d'icône seule, « lite » et
    grisé ; Checkbox dans ses états.
-->
<UserControl x:Class="Mkm.Wpf.Showcase.BoutonsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mkm="urn:mkm-wpf">
    <UserControl.Resources>
        <Style x:Key="Titre" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,16,0,8" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <!-- 8 px entre les boutons d'une ligne. -->
        <Style TargetType="mkm:Button">
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
        <Style TargetType="mkm:Checkbox">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20">
            <TextBlock FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource mkm.primary.color}" Text="{mkm:T showcase.buttons.title}" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"
                       Foreground="{DynamicResource mkm.text.muted.color}" Text="{mkm:T showcase.buttons.help}" />

            <TextBlock Style="{StaticResource Titre}" Text="{mkm:T showcase.buttons.severities}" />
            <WrapPanel>
                <mkm:Button Content="Primary" />
                <mkm:Button Content="Secondary" Severity="Secondary" />
                <mkm:Button Content="Success" Severity="Success" />
                <mkm:Button Content="Info" Severity="Info" />
                <mkm:Button Content="Warn" Severity="Warn" />
                <mkm:Button Content="Help" Severity="Help" />
                <mkm:Button Content="Danger" Severity="Danger" />
                <mkm:Button Content="Contrast" Severity="Contrast" />
            </WrapPanel>

            <TextBlock Style="{StaticResource Titre}" Text="{mkm:T showcase.buttons.outlined}" />
            <WrapPanel>
                <mkm:Button Variant="Outlined" Content="Primary" />
                <mkm:Button Variant="Outlined" Content="Secondary" Severity="Secondary" />
                <mkm:Button Variant="Outlined" Content="Success" Severity="Success" />
                <mkm:Button Variant="Outlined" Content="Info" Severity="Info" />
                <mkm:Button Variant="Outlined" Content="Warn" Severity="Warn" />
                <mkm:Button Variant="Outlined" Content="Help" Severity="Help" />
                <mkm:Button Variant="Outlined" Content="Danger" Severity="Danger" />
                <mkm:Button Variant="Outlined" Content="Contrast" Severity="Contrast" />
            </WrapPanel>

            <TextBlock Style="{StaticResource Titre}" Text="{mkm:T showcase.buttons.text}" />
            <WrapPanel>
                <mkm:Button Variant="Text" Content="Primary" />
                <mkm:Button Variant="Text" Content="Secondary" Severity="Secondary" />
                <mkm:Button Variant="Text" Content="Success" Severity="Success" />
                <mkm:Button Variant="Text" Content="Info" Severity="Info" />
                <mkm:Button Variant="Text" Content="Warn" Severity="Warn" />
                <mkm:Button Variant="Text" Content="Help" Severity="Help" />
                <mkm:Button Variant="Text" Content="Danger" Severity="Danger" />
                <mkm:Button Variant="Text" Content="Contrast" Severity="Contrast" />
            </WrapPanel>

            <TextBlock Style="{StaticResource Titre}" Text="{mkm:T showcase.buttons.link}" />
            <WrapPanel>
                <mkm:Button Variant="Link" Content="{mkm:T showcase.buttons.download}" />
            </WrapPanel>

            <TextBlock Style="{StaticResource Titre}" Text="{mkm:T showcase.buttons.icons}" />
            <WrapPanel>
                <mkm:Button Icon="{x:Static mkm:Icons.Download}" Content="{mkm:T showcase.buttons.download}" />
                <mkm:Button Icon="{x:Static mkm:Icons.Upload}" Content="{mkm:T showcase.buttons.save}" Severity="Secondary" />
                <mkm:Button Icon="{x:Static mkm:Icons.Edit}" Severity="Secondary" ToolTip="Edit" />
                <mkm:Button Icon="{x:Static mkm:Icons.Delete}" Severity="Danger" Variant="Outlined" ToolTip="Delete" />
                <mkm:Button Icon="{x:Static mkm:Icons.Settings}" Variant="Text" ToolTip="Settings" />
                <mkm:Button Icon="{x:Static mkm:Icons.Close}" Variant="Text" ToolTip="Close" />
                <mkm:Button Content="{mkm:T showcase.buttons.disabled}" IsEnabled="False" />
                <mkm:Button Content="{mkm:T showcase.buttons.disabled}" Severity="Secondary" IsEnabled="False" />
            </WrapPanel>

            <TextBlock Style="{StaticResource Titre}" Text="{mkm:T showcase.buttons.checkboxes}" />
            <mkm:Checkbox Content="{mkm:T showcase.buttons.unchecked}" />
            <mkm:Checkbox Content="{mkm:T showcase.buttons.checked}" IsChecked="True" />
            <mkm:Checkbox Content="{mkm:T showcase.buttons.indeterminate}" IsThreeState="True" IsChecked="{x:Null}" />
            <mkm:Checkbox Content="{mkm:T showcase.buttons.invalid}" Invalid="True" />
            <mkm:Checkbox Content="{mkm:T showcase.buttons.disabled}" IsEnabled="False" />
            <mkm:Checkbox Content="{mkm:T showcase.buttons.disabledChecked}" IsEnabled="False" IsChecked="True" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
