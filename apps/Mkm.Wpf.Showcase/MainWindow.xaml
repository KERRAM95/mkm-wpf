<!--
    Fenêtre de la vitrine : la liste des composants à gauche, la page du composant
    choisi à droite. Chaque composant y aura sa page (Pages/<Nom>Page.xaml).
-->
<Window x:Class="Mkm.Wpf.Showcase.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="mkm-wpf — Vitrine"
        Width="1100" Height="720"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Left" Width="220"
                BorderBrush="#DDDDDD" BorderThickness="0,0,1,0">
            <TextBlock Margin="12" FontWeight="Bold" Text="Composants" />
        </Border>
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="#666666" Text="Aucun composant pour l'instant." />
    </DockPanel>
</Window>
