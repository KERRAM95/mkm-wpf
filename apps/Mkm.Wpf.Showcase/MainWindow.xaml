<!--
    Fenêtre de la vitrine : sa barre (le choix de la langue, bientôt celui du thème), la liste
    des composants à gauche, la page du composant choisi à droite. Chaque composant y aura sa
    page (Pages/<Nom>Page.xaml). Tous les textes viennent de Textes/Vitrine*.resx par {mkm:T}.
-->
<Window x:Class="Mkm.Wpf.Showcase.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mkm="urn:mkm-wpf"
        Title="{mkm:T showcase.title}"
        Width="1100" Height="720"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="12,6"
                BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="{mkm:T showcase.language}" />
                <!-- Les langues des textes de la vitrine ; en choisir une change tous les textes. -->
                <ComboBox MinWidth="140"
                          DisplayMemberPath="NativeName"
                          ItemsSource="{Binding Languages, Source={x:Static mkm:Localizer.Current}}"
                          SelectedItem="{Binding Language, Source={x:Static mkm:Localizer.Current}}" />
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Left" Width="220"
                BorderBrush="#DDDDDD" BorderThickness="0,0,1,0">
            <TextBlock Margin="12" FontWeight="Bold" Text="{mkm:T showcase.components}" />
        </Border>
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="#666666" Text="{mkm:T showcase.empty}" />
    </DockPanel>
</Window>
