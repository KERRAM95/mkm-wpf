<!--
    La fenêtre de la documentation de mkm-wpf, sur le modèle d'ui-kit : sa barre (le nom, le thème, la langue), le menu
    des pages à gauche, rangées par catégorie, avec sa recherche ; la page choisie à droite (Documentation/), les
    notifications au-dessus (Toast). Les couleurs, la police et les tailles viennent du thème (mkm.<chemin>).
-->
<Window x:Class="Mkm.Wpf.Showcase.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mkm="urn:mkm-wpf"
        xmlns:local="clr-namespace:Mkm.Wpf.Showcase"
        Title="{mkm:T showcase.title}"
        Width="1280" Height="860"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource mkm.content.background}"
        Foreground="{DynamicResource mkm.text.color}"
        FontFamily="{DynamicResource mkm.font.family}"
        FontSize="{DynamicResource mkm.font.size}">
    <Grid>
        <DockPanel>
            <Border DockPanel.Dock="Top" Padding="16,8"
                    BorderBrush="{DynamicResource mkm.content.border.color}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="{mkm:T showcase.theme}" />
                        <!-- Les thèmes connus ; en choisir un change toute l'apparence, à chaud. -->
                        <ComboBox x:Name="ChoixDuTheme" MinWidth="120" Margin="0,0,16,0"
                                  DisplayMemberPath="Name"
                                  ItemsSource="{x:Static mkm:Themes.All}"
                                  SelectionChanged="ChoixDuTheme_SelectionChanged" />
                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="{mkm:T showcase.language}" />
                        <!-- La langue des textes propres aux composants (« Modifier », « Fermer »…) et de la vitrine. -->
                        <ComboBox MinWidth="140"
                                  DisplayMemberPath="NativeName"
                                  ItemsSource="{Binding Languages, Source={x:Static mkm:Localizer.Current}}"
                                  SelectedItem="{Binding Language, Source={x:Static mkm:Localizer.Current}}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="{DynamicResource mkm.primary.color}" Text="mkm-wpf" />
                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Bottom" Foreground="{DynamicResource mkm.text.muted.color}"
                                   Text="Documentation des composants WPF de mkm" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border DockPanel.Dock="Left" Width="250"
                    BorderBrush="{DynamicResource mkm.content.border.color}" BorderThickness="0,0,1,0">
                <DockPanel Margin="12">
                    <mkm:InputText x:Name="Recherche" DockPanel.Dock="Top" Margin="0,0,0,12"
                                   Placeholder="Rechercher un composant" TextChanged="Recherche_TextChanged" />
                    <!-- Une entrée par page, rangée dans sa catégorie ; sa page s'ouvre à droite. -->
                    <ListBox x:Name="Composants" BorderThickness="0" Background="Transparent"
                             AutomationProperties.Name="Pages de la documentation"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="Composants_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="AutomationProperties.AutomationId" Value="{Binding Automatisation}" />
                                <Setter Property="Padding" Value="12,5" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Titre}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="4,14,0,4" FontWeight="Bold" Text="{Binding Name}" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>
                </DockPanel>
            </Border>
            <ContentControl x:Name="Page" Focusable="False" />
        </DockPanel>
        <!-- Les notifications, au-dessus de tout, en haut à droite. -->
        <mkm:Toast x:Name="Notifications" HighlightDuration="0:0:1" FadeOutDuration="0:0:1" />
    </Grid>
</Window>
