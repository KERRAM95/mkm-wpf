<!--
    Fenêtre de la vitrine : sa barre (le choix du thème et de la langue), la liste des
    composants à gauche, la page du composant choisi à droite (Pages/<Nom>Page.xaml), les notifications
    au-dessus (Toast). Les textes viennent de Textes/Vitrine*.resx par {mkm:T} ; les
    couleurs, la police et les tailles, du thème (mkm.<chemin>).
-->
<Window x:Class="Mkm.Wpf.Showcase.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mkm="urn:mkm-wpf"
        xmlns:local="clr-namespace:Mkm.Wpf.Showcase"
        Title="{mkm:T showcase.title}"
        Width="1100" Height="720"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource mkm.content.background}"
        Foreground="{DynamicResource mkm.text.color}"
        FontFamily="{DynamicResource mkm.font.family}"
        FontSize="{DynamicResource mkm.font.size}">
    <Grid>
        <DockPanel>
            <Border DockPanel.Dock="Top" Padding="12,6"
                    BorderBrush="{DynamicResource mkm.content.border.color}" BorderThickness="0,0,0,1">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="{mkm:T showcase.theme}" />
                    <!-- Les thèmes connus ; en choisir un change toute l'apparence, à chaud. -->
                    <ComboBox x:Name="ChoixDuTheme" MinWidth="120" Margin="0,0,16,0"
                              DisplayMemberPath="Name"
                              ItemsSource="{x:Static mkm:Themes.All}"
                              SelectionChanged="ChoixDuTheme_SelectionChanged" />
                    <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="{mkm:T showcase.language}" />
                    <!-- Les langues des textes de la vitrine ; en choisir une change tous les textes. -->
                    <ComboBox MinWidth="140"
                              DisplayMemberPath="NativeName"
                              ItemsSource="{Binding Languages, Source={x:Static mkm:Localizer.Current}}"
                              SelectedItem="{Binding Language, Source={x:Static mkm:Localizer.Current}}" />
                </StackPanel>
            </Border>
            <Border DockPanel.Dock="Left" Width="220"
                    BorderBrush="{DynamicResource mkm.content.border.color}" BorderThickness="0,0,1,0">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" FontWeight="Bold"
                               Foreground="{DynamicResource mkm.primary.color}" Text="{mkm:T showcase.components}" />
                    <!-- Un composant par entrée ; sa page s'ouvre à droite. -->
                    <ListBox x:Name="Composants" BorderThickness="0" Background="Transparent"
                             SelectionChanged="Composants_SelectionChanged">
                        <ListBoxItem Tag="ActionBar" Content="{mkm:T showcase.actionbar.title}" />
                        <ListBoxItem Tag="Champs" Content="{mkm:T showcase.fields.title}" />
                        <ListBoxItem Tag="Boutons" Content="{mkm:T showcase.nav.buttons}" />
                        <ListBoxItem Tag="Conteneurs" Content="{mkm:T showcase.nav.containers}" />
                        <ListBoxItem Tag="Retours" Content="{mkm:T showcase.nav.feedback}" />
                        <ListBoxItem Tag="Attente" Content="{mkm:T showcase.nav.waiting}" />
                        <ListBoxItem Tag="Saisie" Content="{mkm:T showcase.nav.inputs}" />
                        <ListBoxItem Tag="Fiche" Content="{mkm:T showcase.nav.properties}" />
                        <ListBoxItem Tag="Arbre" Content="{mkm:T showcase.nav.tree}" />
                        <ListBoxItem Tag="Identite" Content="{mkm:T showcase.nav.identity}" />
                    </ListBox>
                </DockPanel>
            </Border>
            <ContentControl x:Name="Page" Focusable="False" />
        </DockPanel>
        <!-- Les notifications, au-dessus de tout, en haut à droite. -->
        <mkm:Toast x:Name="Notifications" HighlightDuration="0:0:1" FadeOutDuration="0:0:1" />
    </Grid>
</Window>
