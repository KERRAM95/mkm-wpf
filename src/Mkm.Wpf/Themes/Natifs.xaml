<!--
    Les styles implicites que mkm-wpf pose sur des contrôles de WPF eux-mêmes, pour toute l'application :
    MkmResources (la configuration de App.xaml) fusionne ce dictionnaire. Un style posé par l'application
    (Style="…" ou un style implicite plus proche) l'emporte.

    - ToolTip : l'info-bulle de mkm (presets dashboard et ara, tooltip) : un gris foncé, le texte blanc, 4 px sur
      8 de retrait, coins de 2 px, 150 px de large au plus, le texte à la ligne ; à droite de son élément, centrée,
      sa flèche de 3 px (tooltip.gutter) entre eux.

    Écarts avec mkm : l'info-bulle paraît après le délai de Windows (ToolTipService.InitialShowDelay), pas aussitôt ;
    passée à gauche faute de place, elle garde sa flèche à gauche.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Mkm.Wpf.Controls">

    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="Background" Value="{DynamicResource mkm.tooltip.background}" />
        <Setter Property="Foreground" Value="{DynamicResource mkm.tooltip.color}" />
        <Setter Property="Padding" Value="{DynamicResource mkm.tooltip.padding}" />
        <Setter Property="MaxWidth" Value="{DynamicResource mkm.tooltip.max.width}" />
        <Setter Property="FontFamily" Value="{DynamicResource mkm.font.family}" />
        <Setter Property="FontSize" Value="{DynamicResource mkm.font.size}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Placement" Value="Custom" />
        <Setter Property="CustomPopupPlacementCallback" Value="{x:Static local:TooltipPlacement.Right}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <!-- La place de l'ombre, transparente, autour de la bulle. -->
                    <Grid Margin="{DynamicResource mkm.tooltip.window.padding}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" VerticalAlignment="Center" Stretch="Fill" Data="M 1,0 L 0,1 L 1,2 Z"
                              Width="{DynamicResource mkm.tooltip.arrow.width}" Height="{DynamicResource mkm.tooltip.arrow.height}"
                              Fill="{TemplateBinding Background}" />
                        <Border Grid.Column="1" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource mkm.tooltip.border.radius}"
                                Effect="{DynamicResource mkm.tooltip.shadow}" />
                        <Border Grid.Column="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter>
                                <ContentPresenter.Resources>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
