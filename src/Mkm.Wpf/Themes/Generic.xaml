        <ResourceDictionary Source="/Mkm.Wpf;component/Controls/Tag/Tag.xaml" />
        <ResourceDictionary Source="/Mkm.Wpf;component/Controls/Textarea/Textarea.xaml" />
        <ResourceDictionary Source="/Mkm.Wpf;component/Controls/Toast/Toast.xaml" />
        <ResourceDictionary Source="/Mkm.Wpf;component/Controls/ToggleButton/ToggleButton.xaml" />
        <ResourceDictionary Source="/Mkm.Wpf;component/Controls/Toolbar/Toolbar.xaml" />
