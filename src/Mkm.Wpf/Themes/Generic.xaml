<!--
    Styles par défaut de tous les contrôles de Mkm.Wpf.

    Ce fichier ne fait que fusionner le dictionnaire de chaque contrôle, une ligne par
    contrôle, dans l'ordre alphabétique :
        <ResourceDictionary Source="/Mkm.Wpf;component/Controls/<Nom>/<Nom>.xaml" />
    Les tests (ConventionsTests) vérifient que chaque contrôle y trouve son style.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Mkm.Wpf;component/Controls/ActionBar/ActionBar.xaml" />
        <ResourceDictionary Source="/Mkm.Wpf;component/Controls/BlockUI/BlockUI.xaml" />
        <ResourceDictionary Source="/Mkm.Wpf;component/Controls/Button/Button.xaml" />
        <ResourceDictionary Source="/Mkm.Wpf;component/Controls/Checkbox/Checkbox.xaml" />
        <ResourceDictionary Source="/Mkm.Wpf;component/Controls/DataTable/DataTable.xaml" />
        <ResourceDictionary Source="/Mkm.Wpf;component/Controls/DatePicker/DatePicker.xaml" />
        <ResourceDictionary Source="/Mkm.Wpf;component/Controls/Dialog/Dialog.xaml" />
        <ResourceDictionary Source="/Mkm.Wpf;component/Controls/EmptyContent/EmptyContent.xaml" />
        <ResourceDictionary Source="/Mkm.Wpf;component/Controls/Fieldset/Fieldset.xaml" />
        <ResourceDictionary Source="/Mkm.Wpf;component/Controls/IdCard/IdCard.xaml" />
        <ResourceDictionary Source="/Mkm.Wpf;component/Controls/InputNumber/InputNumber.xaml" />
        <ResourceDictionary Source="/Mkm.Wpf;component/Controls/InputText/InputText.xaml" />
        <ResourceDictionary Source="/Mkm.Wpf;component/Controls/Message/Message.xaml" />
        <ResourceDictionary Source="/Mkm.Wpf;component/Controls/ProgressBar/ProgressBar.xaml" />
        <ResourceDictionary Source="/Mkm.Wpf;component/Controls/ProgressSpinner/ProgressSpinner.xaml" />
        <ResourceDictionary Source="/Mkm.Wpf;component/Controls/PropertyPanel/PropertyPanel.xaml" />
        <ResourceDictionary Source="/Mkm.Wpf;component/Controls/RadioButton/RadioButton.xaml" />
        <ResourceDictionary Source="/Mkm.Wpf;component/Controls/Select/Select.xaml" />
