<!--
    Le style d'Avatar et d'AvatarGroup, sur l'avatar de mkm (styles/avatar ; jetons de Nora en pixels pour Dashboard,
    preset ara) : 24 px, fond gris pâle (avatar.background), texte de 12 px, aux coins du thème ; un rond pour
    Shape="Circle" ; 36 et 48 px pour Large et XLarge. Une image remplit l'avatar. Dans un groupe, chaque avatar
    chevauche le précédent (avatar.group.offset), cerné de 2 px du fond de la page.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Mkm.Wpf.Controls">

    <Style TargetType="{x:Type local:Avatar}">
        <Setter Property="FontFamily" Value="{DynamicResource mkm.font.family}" />
        <Setter Property="FontSize" Value="{DynamicResource mkm.avatar.font.size}" />
        <Setter Property="Foreground" Value="{DynamicResource mkm.avatar.color}" />
        <Setter Property="Background" Value="{DynamicResource mkm.avatar.background}" />
        <Setter Property="Width" Value="{DynamicResource mkm.avatar.width}" />
        <Setter Property="Height" Value="{DynamicResource mkm.avatar.height}" />
        <Setter Property="BorderBrush" Value="{DynamicResource mkm.avatar.group.border.color}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Avatar}">
                    <Grid>
                        <Border x:Name="Carre" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource mkm.avatar.border.radius}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                        <Ellipse x:Name="Rond" Visibility="Collapsed" Fill="{TemplateBinding Background}"
                                 Stroke="{TemplateBinding BorderBrush}" StrokeThickness="0" />
                        <!-- L'image, aux mêmes contours : une Border (carrée) ou une Ellipse (ronde) peinte de l'image (par le code). -->
                        <Border x:Name="ImageCarree" Visibility="Collapsed" CornerRadius="{DynamicResource mkm.avatar.border.radius}" />
                        <Ellipse x:Name="ImageRonde" Visibility="Collapsed" />
                        <local:Icon x:Name="Icone" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Source="{TemplateBinding Icon}"
                                    Width="{DynamicResource mkm.avatar.icon.size}" Height="{DynamicResource mkm.avatar.icon.size}" />
                        <TextBlock x:Name="Texte" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{TemplateBinding Label}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Shape" Value="Circle">
                            <Setter TargetName="Carre" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Rond" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsInGroup" Value="True">
                            <Setter Property="BorderThickness" Value="2" />
                            <Setter TargetName="Rond" Property="StrokeThickness" Value="2" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Label" Value="{x:Null}" />
                                <Condition Property="Image" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Icone" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <!-- Une image remplit l'avatar, à la place du texte ; dans un groupe, en dedans de son cerne. -->
                        <Trigger Property="HasImage" Value="True">
                            <Setter TargetName="ImageCarree" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Texte" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="HasImage" Value="True" />
                                <Condition Property="Shape" Value="Circle" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ImageCarree" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ImageRonde" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="HasImage" Value="True" />
                                <Condition Property="IsInGroup" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ImageCarree" Property="Margin" Value="2" />
                            <Setter TargetName="ImageRonde" Property="Margin" Value="2" />
                        </MultiTrigger>
                        <Trigger Property="Size" Value="Large">
                            <Setter TargetName="Icone" Property="Width" Value="{DynamicResource mkm.avatar.lg.icon.size}" />
                            <Setter TargetName="Icone" Property="Height" Value="{DynamicResource mkm.avatar.lg.icon.size}" />
                        </Trigger>
                        <Trigger Property="Size" Value="XLarge">
                            <Setter TargetName="Icone" Property="Width" Value="{DynamicResource mkm.avatar.xl.icon.size}" />
                            <Setter TargetName="Icone" Property="Height" Value="{DynamicResource mkm.avatar.xl.icon.size}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Size" Value="Large">
                <Setter Property="Width" Value="{DynamicResource mkm.avatar.lg.width}" />
                <Setter Property="Height" Value="{DynamicResource mkm.avatar.lg.width}" />
                <Setter Property="FontSize" Value="{DynamicResource mkm.avatar.lg.font.size}" />
            </Trigger>
            <Trigger Property="Size" Value="XLarge">
                <Setter Property="Width" Value="{DynamicResource mkm.avatar.xl.width}" />
                <Setter Property="Height" Value="{DynamicResource mkm.avatar.xl.width}" />
                <Setter Property="FontSize" Value="{DynamicResource mkm.avatar.xl.font.size}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type local:AvatarGroup}">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:AvatarGroup}">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
