<!--
    Le style d'OverlayBadge, sur la pastille posée de mkm (styles/overlaybadge ; preset dashboard, ara) : la pastille
    centrée sur le coin haut-droit de son contenu, cernée de 2 px du fond de la page (overlaybadge.outline).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Mkm.Wpf.Controls">

    <Style TargetType="{x:Type local:OverlayBadge}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:OverlayBadge}">
                    <local:CoinDePastille>
                        <ContentPresenter />
                        <local:Badge x:Name="Pastille" Margin="0"
                                     Value="{TemplateBinding Value}" Severity="{TemplateBinding Severity}" Size="{TemplateBinding Size}"
                                     BorderThickness="{DynamicResource mkm.overlaybadge.border.width}"
                                     BorderBrush="{DynamicResource mkm.overlaybadge.outline.color}" />
                    </local:CoinDePastille>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
