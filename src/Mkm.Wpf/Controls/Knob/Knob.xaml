<!--
    Le style de Knob, sur le bouton rotatif de mkm (styles/knob ; jetons de Nora en pixels, dans les deux thèmes) : sur
    une grille de 100, un arc de rayon 40 et de 14 d'épaisseur, de 240° à -60° par le haut, gris (range.background) ;
    l'arc de la valeur de la couleur du thème ; la valeur au milieu, en gris (text.color), de 15,6 sur 100. Au clavier,
    l'anneau du focus autour. Grisé, à moitié pâle.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Mkm.Wpf.Controls">

    <Style TargetType="{x:Type local:Knob}">
        <Setter Property="ValueColor" Value="{DynamicResource mkm.knob.value.background}" />
        <Setter Property="RangeColor" Value="{DynamicResource mkm.knob.range.background}" />
        <Setter Property="Foreground" Value="{DynamicResource mkm.knob.text.color}" />
        <Setter Property="FontFamily" Value="{DynamicResource mkm.font.family}" />
        <Setter Property="FontSize" Value="{DynamicResource mkm.knob.text.font.size}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Knob}">
                    <Grid x:Name="Racine" Background="Transparent">
                        <local:DessinDeKnob x:Name="PART_Drawing" />
                        <Ellipse x:Name="Anneau" Visibility="Collapsed" IsHitTestVisible="False"
                                 Stroke="{DynamicResource mkm.knob.focus.ring.color}"
                                 StrokeThickness="{DynamicResource mkm.knob.focus.ring.width}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="local:FocusVisible.IsVisible" Value="True">
                            <Setter TargetName="Anneau" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Racine" Property="Opacity" Value="{DynamicResource mkm.disabled.opacity}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
