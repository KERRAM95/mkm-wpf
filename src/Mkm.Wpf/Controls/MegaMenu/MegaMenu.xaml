<!--
    Les styles de MegaMenu, sur le méga-menu de mkm (styles/megamenu ; jetons de Nora en pixels, dans les deux thèmes) :
    la barre de Menubar (le fond et la bordure du contenu, 6 px sur 9 de retrait, ses éléments à 6 px l'un de l'autre ;
    en colonne, la liste de navigation, 150 px au moins) ; ouvert, l'élément ouvre dessous (à droite en colonne) le
    panneau, au fond et à la bordure du contenu, ombré, ses colonnes de 150 px au moins à 6 px l'une de l'autre ; dans
    chaque colonne, les groupes du menu de mkm (leur libellé en gras, leurs liens).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Mkm.Wpf.Controls">

    <Style TargetType="{x:Type local:MegaMenuColumn}">
        <Setter Property="MinWidth" Value="{DynamicResource mkm.megamenu.submenu.min.width}" />
        <Setter Property="Padding" Value="{DynamicResource mkm.megamenu.submenu.padding}" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:MegaMenuColumn}">
                    <Border Padding="{TemplateBinding Padding}">
                        <local:GapStackPanel IsItemsHost="True" Gap="{DynamicResource mkm.megamenu.submenu.gap}"
                                             KeyboardNavigation.DirectionalNavigation="Continue" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:MegaMenuItem}">
        <Setter Property="Foreground" Value="{DynamicResource mkm.megamenu.item.color}" />
        <Setter Property="Padding" Value="{DynamicResource mkm.megamenu.item.padding}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:MegaMenuItem}">
                    <Grid>
                        <Border x:Name="Fond" Background="Transparent" Padding="{TemplateBinding Padding}"
                                CornerRadius="{DynamicResource mkm.megamenu.base.item.border.radius}">
                            <DockPanel>
                                <local:Icon x:Name="Fleche" DockPanel.Dock="Right" Visibility="Collapsed" VerticalAlignment="Center"
                                            Margin="{DynamicResource mkm.megamenu.submenu.icon.margin}"
                                            Source="{x:Static local:InternalIcons.AngleDown}"
                                            Width="{DynamicResource mkm.megamenu.submenu.icon.size}"
                                            Height="{DynamicResource mkm.megamenu.submenu.icon.size}"
                                            Foreground="{DynamicResource mkm.megamenu.submenu.icon.color}" />
                                <local:GapStackPanel Orientation="Horizontal" Gap="{DynamicResource mkm.megamenu.item.gap}">
                                    <ContentPresenter x:Name="Icone" Content="{TemplateBinding Icon}" VerticalAlignment="Center"
                                                      TextElement.Foreground="{DynamicResource mkm.megamenu.item.icon.color}">
                                        <ContentPresenter.Resources>
                                            <DataTemplate DataType="{x:Type Geometry}">
                                                <local:Icon Source="{Binding}" Width="{DynamicResource mkm.icon.size}" Height="{DynamicResource mkm.icon.size}" />
                                            </DataTemplate>
                                        </ContentPresenter.Resources>
                                    </ContentPresenter>
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                                </local:GapStackPanel>
                            </DockPanel>
                        </Border>
                        <Border x:Name="Anneau" Visibility="Collapsed" BorderThickness="2"
                                BorderBrush="{DynamicResource mkm.contextmenu.item.keyboard.border.color}" />
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" PopupAnimation="None" Placement="Bottom"
                               VerticalOffset="{DynamicResource mkm.anchor.gutter}"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Grid Margin="{DynamicResource mkm.megamenu.overlay.window.padding}">
                                <Border Background="{DynamicResource mkm.megamenu.overlay.background}"
                                        CornerRadius="{DynamicResource mkm.megamenu.overlay.border.radius}"
                                        Effect="{DynamicResource mkm.megamenu.overlay.shadow}" />
                                <Border BorderThickness="1" Background="{DynamicResource mkm.megamenu.overlay.background}"
                                        BorderBrush="{DynamicResource mkm.megamenu.overlay.border.color}"
                                        CornerRadius="{DynamicResource mkm.megamenu.overlay.border.radius}"
                                        Padding="{DynamicResource mkm.megamenu.overlay.padding}"
                                        TextElement.Foreground="{DynamicResource mkm.megamenu.overlay.color}">
                                    <local:GapStackPanel IsItemsHost="True" Orientation="Horizontal" Gap="{DynamicResource mkm.megamenu.overlay.gap}"
                                                         KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="Icone" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="Fleche" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Role" Value="TopLevelHeader" />
                                <Condition Property="local:MegaMenu.Orientation" Value="Vertical" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Fleche" Property="Source" Value="{x:Static local:InternalIcons.AngleRight}" />
                            <Setter TargetName="PART_Popup" Property="Placement" Value="Right" />
                            <Setter TargetName="PART_Popup" Property="VerticalOffset" Value="0" />
                        </MultiTrigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Fond" Property="Background" Value="{DynamicResource mkm.megamenu.item.focus.background}" />
                            <Setter Property="Foreground" Value="{DynamicResource mkm.megamenu.item.focus.color}" />
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="Fond" Property="Background" Value="{DynamicResource mkm.megamenu.item.active.background}" />
                            <Setter Property="Foreground" Value="{DynamicResource mkm.megamenu.item.active.color}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocused" Value="True" />
                                <Condition Property="IsMouseOver" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Anneau" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fond" Property="Opacity" Value="{DynamicResource mkm.disabled.opacity}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:MegaMenu}">
        <Setter Property="Background" Value="{DynamicResource mkm.megamenu.background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource mkm.megamenu.border.color}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource mkm.megamenu.color}" />
        <Setter Property="Padding" Value="{DynamicResource mkm.megamenu.horizontal.orientation.padding}" />
        <Setter Property="FontFamily" Value="{DynamicResource mkm.font.family}" />
        <Setter Property="FontSize" Value="{DynamicResource mkm.font.size}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:MegaMenu}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                            CornerRadius="{DynamicResource mkm.megamenu.border.radius}">
                        <DockPanel x:Name="Rangee">
                            <ContentPresenter x:Name="Debut" DockPanel.Dock="Left" VerticalAlignment="Center"
                                              Margin="{DynamicResource mkm.menubar.start.margin}" Content="{TemplateBinding Start}" />
                            <ContentPresenter x:Name="Fin" DockPanel.Dock="Right" VerticalAlignment="Center" Content="{TemplateBinding End}" />
                            <local:GapStackPanel x:Name="Elements" IsItemsHost="True" Orientation="Horizontal"
                                                 Gap="{DynamicResource mkm.megamenu.horizontal.orientation.gap}" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="local:MegaMenu.Orientation" Value="Vertical">
                            <Setter TargetName="Elements" Property="Orientation" Value="Vertical" />
                            <Setter Property="Padding" Value="{DynamicResource mkm.megamenu.vertical.orientation.padding}" />
                            <Setter Property="MinWidth" Value="{DynamicResource mkm.megamenu.vertical.orientation.min.width}" />
                            <Setter Property="HorizontalAlignment" Value="Left" />
                            <Setter TargetName="Debut" Property="DockPanel.Dock" Value="Top" />
                            <Setter TargetName="Fin" Property="DockPanel.Dock" Value="Bottom" />
                            <Setter TargetName="Elements" Property="Gap" Value="{DynamicResource mkm.megamenu.vertical.orientation.gap}" />
                        </Trigger>
                        <Trigger Property="Start" Value="{x:Null}">
                            <Setter TargetName="Debut" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="End" Value="{x:Null}">
                            <Setter TargetName="Fin" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
