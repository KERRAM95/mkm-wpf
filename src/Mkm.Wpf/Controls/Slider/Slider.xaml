<!--
    Le style de Slider, sur le curseur de mkm (styles/slider ; jetons de Nora en pixels, dans les deux thèmes) : une
    piste de 3 px, grise, aux coins du thème, colorée de la couleur du thème du début à la valeur ; une poignée ronde de
    16 px de cette couleur, son rond de 12 px au milieu, centrée sur la valeur (elle dépasse des bouts de la piste de
    sa moitié) ; au clavier, l'anneau du focus autour de la poignée. En colonne, la valeur monte de bas en haut, 100 px
    au moins. Grisé, à moitié pâle.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Mkm.Wpf.Controls">

    <!-- La plage, du début à la poignée : la piste dépasse de la moitié de la poignée, la plage commence au bout visible. -->
    <Style x:Key="mkm.Slider.Plage" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Grid Background="Transparent">
                        <Border Background="{TemplateBinding Background}" Margin="{TemplateBinding Padding}"
                                CornerRadius="{DynamicResource mkm.slider.track.border.radius}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- La poignée : 16 px, son rond de 12 px ; l'anneau du clavier quand le curseur le montre (Tag). -->
    <Style x:Key="mkm.Slider.Poignee" TargetType="{x:Type Thumb}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="{DynamicResource mkm.slider.handle.width}" />
        <Setter Property="Height" Value="{DynamicResource mkm.slider.handle.height}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid>
                        <Ellipse x:Name="Fond" Fill="{DynamicResource mkm.slider.handle.background}" />
                        <Ellipse x:Name="Rond" Fill="{DynamicResource mkm.slider.handle.content.background}"
                                 Width="{DynamicResource mkm.slider.handle.content.width}"
                                 Height="{DynamicResource mkm.slider.handle.content.height}" />
                        <Ellipse x:Name="Anneau" Visibility="Collapsed" Margin="-2" IsHitTestVisible="False"
                                 Stroke="{DynamicResource mkm.slider.handle.focus.ring.color}"
                                 StrokeThickness="{DynamicResource mkm.slider.handle.focus.ring.width}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fond" Property="Fill" Value="{DynamicResource mkm.slider.handle.hover.background}" />
                            <Setter TargetName="Rond" Property="Fill" Value="{DynamicResource mkm.slider.handle.content.hover.background}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="anneau">
                            <Setter TargetName="Anneau" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:Slider}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Slider}">
                    <Grid x:Name="Racine" Background="Transparent">
                        <Border x:Name="Piste" Height="{DynamicResource mkm.slider.track.size}" VerticalAlignment="Center"
                                Background="{DynamicResource mkm.slider.track.background}"
                                CornerRadius="{DynamicResource mkm.slider.track.border.radius}" />
                        <Track x:Name="PART_Track" Margin="{DynamicResource mkm.slider.track.horizontal.margin}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="Plage" Style="{StaticResource mkm.Slider.Plage}"
                                              Command="{x:Static Slider.DecreaseLarge}"
                                              Background="{DynamicResource mkm.slider.range.background}"
                                              Height="{DynamicResource mkm.slider.track.size}"
                                              Padding="{DynamicResource mkm.slider.range.horizontal.padding}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource mkm.Slider.Plage}" Command="{x:Static Slider.IncreaseLarge}"
                                              Background="Transparent" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Poignee" Style="{StaticResource mkm.Slider.Poignee}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter TargetName="Racine" Property="MinHeight" Value="{DynamicResource mkm.slider.vertical.min.height}" />
                            <Setter TargetName="Piste" Property="Height" Value="NaN" />
                            <Setter TargetName="Piste" Property="Width" Value="{DynamicResource mkm.slider.track.size}" />
                            <Setter TargetName="Piste" Property="VerticalAlignment" Value="Stretch" />
                            <Setter TargetName="Piste" Property="HorizontalAlignment" Value="Center" />
                            <Setter TargetName="PART_Track" Property="Margin" Value="{DynamicResource mkm.slider.track.vertical.margin}" />
                            <Setter TargetName="Plage" Property="Height" Value="NaN" />
                            <Setter TargetName="Plage" Property="Width" Value="{DynamicResource mkm.slider.track.size}" />
                            <Setter TargetName="Plage" Property="Padding" Value="{DynamicResource mkm.slider.range.vertical.padding}" />
                        </Trigger>
                        <Trigger Property="local:FocusVisible.IsVisible" Value="True">
                            <Setter TargetName="Poignee" Property="Tag" Value="anneau" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Racine" Property="Opacity" Value="{DynamicResource mkm.disabled.opacity}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
