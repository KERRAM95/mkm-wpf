<!--
    Le style de ProgressSpinner, sur le chargeur de mkm (presets dashboard et ara, progressspinner) : un arc de la
    couleur principale, qui ne change pas de couleur à chaque tour ; 100 px par défaut, comme PrimeVue. L'arc se
    dessine en code (ProgressSpinner.OnRender), sous le gabarit, vide.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Mkm.Wpf.Controls"
                    xmlns:loc="clr-namespace:Mkm.Wpf.Localization">

    <Style TargetType="{x:Type local:ProgressSpinner}">
        <Setter Property="Width" Value="{DynamicResource mkm.progressspinner.size}" />
        <Setter Property="Height" Value="{DynamicResource mkm.progressspinner.size}" />
        <Setter Property="Stroke" Value="{DynamicResource mkm.progressspinner.color.one}" />
        <Setter Property="AutomationProperties.Name" Value="{loc:T aria.busy}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ProgressSpinner}">
                    <Grid />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
