<!--
    Les styles du panneau d'accueil de mkm (preset dashboard/welcomepanel et sa feuille, preset ara) : sur un fond #f9f9f9,
    10 px en haut et en bas, 5 px de côté quand il est déplié ; le titre de 22 px gras et la description de 13 px gras,
    gris ; des rubriques (5 px sur 10), leur libellé de 13 px gras ; des entrées de 13 px grasses, grises, plus foncées
    au survol, leur icône de 18 px dans une ligne haute de 1,43 fois elle, 5 px de retrait et d'écart ; la choisie bleue,
    marquée d'un trait de 2 px à gauche ; au clavier, l'anneau du focus, dans l'entrée. Les libellés passent à la ligne.
    Replié : ni libellé de rubrique ni libellé d'entrée, des icônes de 24 px, 4 px de retrait, 2 px autour des rubriques.
    Un trait entre deux rubriques : gris clair, à 5 px dessus et dessous, à 10 % de chaque bord.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Mkm.Wpf.Controls">

    <Style TargetType="{x:Type local:WelcomePanelSeparator}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:WelcomePanelSeparator}">
                    <Grid Margin="{DynamicResource mkm.welcomepanel.separator.vertical.margin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="8*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="1" Height="1" Fill="{DynamicResource mkm.welcomepanel.separator.border.color}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:WelcomePanelItem}">
        <Setter Property="Padding" Value="{DynamicResource mkm.welcomepanel.item.padding}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{DynamicResource mkm.welcomepanel.item.side.border.width}" />
        <Setter Property="Foreground" Value="{DynamicResource mkm.welcomepanel.item.color}" />
        <Setter Property="FontSize" Value="{DynamicResource mkm.welcomepanel.item.font.size}" />
        <Setter Property="FontWeight" Value="{DynamicResource mkm.welcomepanel.item.font.weight}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTipService.Placement" Value="Right" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:WelcomePanelItem}">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource mkm.welcomepanel.item.border.radius}"
                                Padding="{TemplateBinding Padding}">
                            <DockPanel HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                                <Grid x:Name="Ligne" DockPanel.Dock="Left" VerticalAlignment="Top"
                                      Height="{DynamicResource mkm.welcomepanel.item.icon.line.height}">
                                    <local:Icon x:Name="Icone" Source="{TemplateBinding Icon}" VerticalAlignment="Center"
                                                Width="{DynamicResource mkm.welcomepanel.item.icon.size}"
                                                Height="{DynamicResource mkm.welcomepanel.item.icon.size}" />
                                </Grid>
                                <Rectangle x:Name="Ecart" DockPanel.Dock="Left" Width="{DynamicResource mkm.welcomepanel.item.gap}" />
                                <ContentPresenter x:Name="Libelle" VerticalAlignment="Center" RecognizesAccessKey="True">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                                            <Setter Property="LineHeight" Value="{DynamicResource mkm.welcomepanel.item.line.height}" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </DockPanel>
                        </Border>
                        <!-- L'anneau du focus : 1 px, dans l'entrée (outline-offset de -1 px). -->
                        <Rectangle x:Name="Anneau" Visibility="Collapsed"
                                   Stroke="{DynamicResource mkm.welcomepanel.item.focus.ring.color}"
                                   StrokeThickness="{DynamicResource mkm.welcomepanel.item.focus.ring.width}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="Ligne" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Ecart" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource mkm.welcomepanel.item.hover.background}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource mkm.welcomepanel.item.hover.border.color}" />
                            <Setter Property="Foreground" Value="{DynamicResource mkm.welcomepanel.item.hover.color}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource mkm.welcomepanel.item.selected.background}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource mkm.welcomepanel.item.selected.border.color}" />
                            <Setter Property="Foreground" Value="{DynamicResource mkm.welcomepanel.item.selected.color}" />
                        </Trigger>
                        <Trigger Property="IsFocusVisible" Value="True">
                            <Setter TargetName="Anneau" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <!-- Replié : l'icône seule, plus grande ; le libellé en info-bulle. -->
                        <Trigger Property="IsCollapsed" Value="True">
                            <Setter Property="Padding" Value="{DynamicResource mkm.welcomepanel.item.collapsed.padding}" />
                            <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
                            <Setter TargetName="Libelle" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Ecart" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Ligne" Property="Height" Value="{DynamicResource mkm.welcomepanel.item.collapsed.icon.line.height}" />
                            <Setter TargetName="Icone" Property="Width" Value="{DynamicResource mkm.welcomepanel.item.collapsed.icon.size}" />
                            <Setter TargetName="Icone" Property="Height" Value="{DynamicResource mkm.welcomepanel.item.collapsed.icon.size}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter Property="Opacity" Value="{DynamicResource mkm.disabled.opacity}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:WelcomePanelSection}">
        <Setter Property="Padding" Value="{DynamicResource mkm.welcomepanel.section.padding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:WelcomePanelSection}">
                    <StackPanel Margin="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="Libelle" ContentSource="Header"
                                          Margin="{DynamicResource mkm.welcomepanel.section.label.padding}"
                                          TextElement.Foreground="{DynamicResource mkm.welcomepanel.section.label.color}"
                                          TextElement.FontSize="{DynamicResource mkm.welcomepanel.section.label.font.size}"
                                          TextElement.FontWeight="{DynamicResource mkm.welcomepanel.section.label.font.weight}">
                            <ContentPresenter.Resources>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                                    <Setter Property="LineHeight" Value="{DynamicResource mkm.welcomepanel.section.label.line.height}" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                        <ItemsPresenter />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasHeader" Value="False">
                            <Setter TargetName="Libelle" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsCollapsed" Value="True">
                            <Setter Property="Padding" Value="{DynamicResource mkm.welcomepanel.section.collapsed.padding}" />
                            <Setter TargetName="Libelle" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:WelcomePanel}">
        <Setter Property="Background" Value="{DynamicResource mkm.welcomepanel.background}" />
        <Setter Property="Foreground" Value="{DynamicResource mkm.welcomepanel.color}" />
        <Setter Property="Padding" Value="{DynamicResource mkm.welcomepanel.expanded.padding}" />
        <Setter Property="FontFamily" Value="{DynamicResource mkm.font.family}" />
        <Setter Property="FontSize" Value="{DynamicResource mkm.font.size}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:WelcomePanel}">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <ContentPresenter x:Name="Pied" DockPanel.Dock="Bottom" Content="{TemplateBinding Footer}"
                                              Margin="{DynamicResource mkm.welcomepanel.footer.padding}" />
                            <ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Border x:Name="EnTete" Padding="{DynamicResource mkm.welcomepanel.header.padding}">
                                        <Grid>
                                            <StackPanel x:Name="TitreEtDescription">
                                                <TextBlock x:Name="Titre" Text="{TemplateBinding Title}" TextWrapping="Wrap"
                                                           Margin="{DynamicResource mkm.welcomepanel.title.padding}"
                                                           Foreground="{DynamicResource mkm.welcomepanel.title.color}"
                                                           FontSize="{DynamicResource mkm.welcomepanel.title.font.size}"
                                                           FontWeight="{DynamicResource mkm.welcomepanel.title.font.weight}" />
                                                <TextBlock x:Name="LaDescription" Text="{TemplateBinding Description}" TextWrapping="Wrap"
                                                           Margin="{DynamicResource mkm.welcomepanel.description.padding}"
                                                           Foreground="{DynamicResource mkm.welcomepanel.description.color}"
                                                           FontSize="{DynamicResource mkm.welcomepanel.description.font.size}"
                                                           FontWeight="{DynamicResource mkm.welcomepanel.description.font.weight}" />
                                            </StackPanel>
                                            <ContentPresenter x:Name="EnTetePropre" Content="{TemplateBinding Header}" />
                                        </Grid>
                                    </Border>
                                    <ItemsPresenter />
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Title" Value="{x:Null}">
                            <Setter TargetName="Titre" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="LaDescription" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Title" Value="{x:Null}" />
                                <Condition Property="Description" Value="{x:Null}" />
                                <Condition Property="Header" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="EnTete" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="EnTetePropre" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Footer" Value="{x:Null}">
                            <Setter TargetName="Pied" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <!-- Replié, il perd son en-tête et ses 5 px de côté. -->
                        <Trigger Property="IsCollapsed" Value="True">
                            <Setter Property="Padding" Value="{DynamicResource mkm.welcomepanel.padding}" />
                            <Setter TargetName="EnTete" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
