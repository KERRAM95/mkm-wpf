<!--
    Le style d'OrderList, sur la liste à ordonner de mkm (styles/orderlist ; jetons de Nora en pixels, dans les deux
    thèmes) : à gauche, au milieu de la hauteur, les quatre boutons secondaires d'icône (monter, tout en haut,
    descendre, tout en bas) à 6 px l'un de l'autre ; à 13,5 px, la liste de Listbox, qui prend la place.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Mkm.Wpf.Controls"
                    xmlns:loc="clr-namespace:Mkm.Wpf.Localization">

    <Style TargetType="{x:Type local:OrderList}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:OrderList}">
                    <DockPanel>
                        <local:GapStackPanel x:Name="Boutons" DockPanel.Dock="Left" VerticalAlignment="Center"
                                             Gap="{DynamicResource mkm.orderlist.controls.gap}" Margin="{DynamicResource mkm.orderlist.controls.margin}">
                            <local:Button x:Name="PART_MoveUp" Severity="Secondary" Icon="{x:Static local:InternalIcons.AngleUp}"
                                          ToolTip="{loc:T aria.moveUp}" />
                            <local:Button x:Name="PART_MoveTop" Severity="Secondary" Icon="{x:Static local:InternalIcons.AngleDoubleUp}"
                                          ToolTip="{loc:T aria.moveTop}" />
                            <local:Button x:Name="PART_MoveDown" Severity="Secondary" Icon="{x:Static local:InternalIcons.AngleDown}"
                                          ToolTip="{loc:T aria.moveDown}" />
                            <local:Button x:Name="PART_MoveBottom" Severity="Secondary" Icon="{x:Static local:InternalIcons.AngleDoubleDown}"
                                          ToolTip="{loc:T aria.moveBottom}" />
                        </local:GapStackPanel>
                        <ContentPresenter x:Name="EnTete" DockPanel.Dock="Top" Content="{TemplateBinding Header}"
                                          Margin="{DynamicResource mkm.orderlist.header.margin}" TextElement.FontWeight="SemiBold" />
                        <local:Listbox x:Name="PART_List" ItemsSource="{TemplateBinding ItemsSource}"
                                       ItemTemplate="{TemplateBinding ItemTemplate}" DisplayMemberPath="{TemplateBinding DisplayMemberPath}"
                                       SelectionMode="{TemplateBinding SelectionMode}"
                                       AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ControlsPosition" Value="Right">
                            <Setter TargetName="Boutons" Property="DockPanel.Dock" Value="Right" />
                            <Setter TargetName="Boutons" Property="Margin" Value="{DynamicResource mkm.orderlist.controls.right.margin}" />
                        </Trigger>
                        <Trigger Property="ShowControls" Value="False">
                            <Setter TargetName="Boutons" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="EnTete" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
