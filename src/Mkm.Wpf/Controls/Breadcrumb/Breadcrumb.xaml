<!--
    Le style de Breadcrumb, sur le fil d'Ariane de mkm (styles/breadcrumb ; jetons de Nora en pixels pour Dashboard,
    preset ara) : 12 px de retrait, les liens sur une ligne, 6 px entre un lien et son chevron ; un lien, son icône à
    8 px de son libellé, gris (text.muted.color), du gris du texte au survol ; au clavier, un anneau d'un pixel à un
    pixel autour du lien. Ce qui dépasse la largeur est coupé (mkm le fait défiler, sans barre).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Mkm.Wpf.Controls">

    <Style TargetType="{x:Type local:Breadcrumb}">
        <Setter Property="FontFamily" Value="{DynamicResource mkm.font.family}" />
        <Setter Property="FontSize" Value="{DynamicResource mkm.font.size}" />
        <Setter Property="Background" Value="{DynamicResource mkm.breadcrumb.background}" />
        <Setter Property="Padding" Value="{DynamicResource mkm.breadcrumb.padding}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <local:GapStackPanel Orientation="Horizontal" Gap="{DynamicResource mkm.breadcrumb.gap}" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Breadcrumb}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" ClipToBounds="True">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:BreadcrumbItem}">
        <Setter Property="Foreground" Value="{DynamicResource mkm.breadcrumb.item.color}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:BreadcrumbItem}">
                    <local:GapStackPanel Orientation="Horizontal" Gap="{DynamicResource mkm.breadcrumb.gap}">
                        <local:Icon x:Name="Separateur" VerticalAlignment="Center" IsHitTestVisible="False"
                                    Source="{x:Static local:InternalIcons.ChevronRight}"
                                    Width="{DynamicResource mkm.icon.size}" Height="{DynamicResource mkm.icon.size}"
                                    Foreground="{DynamicResource mkm.breadcrumb.separator.color}" />
                        <Grid>
                            <Border x:Name="Lien" Background="Transparent" CornerRadius="{DynamicResource mkm.breadcrumb.item.border.radius}">
                                <local:GapStackPanel Orientation="Horizontal" Gap="{DynamicResource mkm.breadcrumb.item.gap}">
                                    <local:Icon x:Name="Icone" VerticalAlignment="Center" Source="{TemplateBinding Icon}"
                                                Width="{DynamicResource mkm.icon.size}" Height="{DynamicResource mkm.icon.size}"
                                                Foreground="{DynamicResource mkm.breadcrumb.item.icon.color}" />
                                    <ContentPresenter x:Name="Libelle" VerticalAlignment="Center" RecognizesAccessKey="True" />
                                </local:GapStackPanel>
                            </Border>
                            <!-- L'anneau du clavier : focus.ring.width, à focus.ring.offset du lien. -->
                            <Rectangle x:Name="Anneau" Margin="-2" Visibility="Collapsed" IsHitTestVisible="False" SnapsToDevicePixels="True"
                                       RadiusX="2" RadiusY="2"
                                       Stroke="{DynamicResource mkm.breadcrumb.item.focus.ring.color}"
                                       StrokeThickness="{DynamicResource mkm.breadcrumb.item.focus.ring.width}" />
                        </Grid>
                    </local:GapStackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFirst" Value="True">
                            <Setter TargetName="Separateur" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="Icone" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Libelle" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger SourceName="Lien" Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource mkm.breadcrumb.item.hover.color}" />
                            <Setter TargetName="Icone" Property="Foreground" Value="{DynamicResource mkm.breadcrumb.item.icon.hover.color}" />
                        </Trigger>
                        <Trigger Property="local:FocusVisible.IsVisible" Value="True">
                            <Setter TargetName="Anneau" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Lien" Property="Opacity" Value="{DynamicResource mkm.disabled.opacity}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
