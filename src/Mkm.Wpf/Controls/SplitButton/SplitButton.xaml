<!--
    Le style de SplitButton, sur le bouton partagé de mkm (styles/splitbutton) : deux boutons de mkm accolés, de la même
    gravité et de la même forme ; le principal sans bordure à droite, ses coins de droite carrés ; le chevron, un bouton
    d'icône seule, ses coins de gauche carrés. Le menu s'ouvre dessous, aussi large que le bouton partagé au moins.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Mkm.Wpf.Controls"
                    xmlns:loc="clr-namespace:Mkm.Wpf.Localization">

    <Style TargetType="{x:Type local:SplitButton}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SplitButton}">
                    <StackPanel Orientation="Horizontal">
                        <local:Button x:Name="PART_Button" Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" Icon="{TemplateBinding Icon}"
                                      Severity="{TemplateBinding Severity}" Variant="{TemplateBinding Variant}"
                                      CornerRadius="{DynamicResource mkm.splitbutton.button.corner.radius}"
                                      BorderThickness="{DynamicResource mkm.splitbutton.button.border.width}" />
                        <local:ChevronDeSplitButton x:Name="PART_DropDown" Icon="{x:Static local:InternalIcons.ChevronDown}"
                                                    Severity="{TemplateBinding Severity}" Variant="{TemplateBinding Variant}"
                                                    CornerRadius="{DynamicResource mkm.splitbutton.dropdown.corner.radius}"
                                                    AutomationProperties.Name="{loc:T aria.moreCommands}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
