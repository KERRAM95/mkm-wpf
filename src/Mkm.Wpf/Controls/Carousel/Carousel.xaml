<!--
    Le style de Carousel, sur le carrousel de mkm (styles/carousel ; jetons de Nora en pixels, dans les deux thèmes) :
    les flèches (des boutons secondaires de texte, ronds) de part et d'autre de la piste ; les éléments côte à côte, à
    3 px l'un de l'autre ; dessous, à 12 px de retrait, les indicateurs de page : des barres de 24 sur 6 px, grises, à
    6 px l'une de l'autre, plus foncées au survol, de la couleur du thème pour la page montrée. En colonne, les flèches
    au-dessus et au-dessous.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Mkm.Wpf.Controls"
                    xmlns:loc="clr-namespace:Mkm.Wpf.Localization">

    <!-- Un indicateur de page : une barre. -->
    <Style x:Key="mkm.Carousel.Indicateur" TargetType="{x:Type Button}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Width" Value="{DynamicResource mkm.carousel.indicator.width}" />
        <Setter Property="Height" Value="{DynamicResource mkm.carousel.indicator.height}" />
        <Setter Property="Background" Value="{DynamicResource mkm.carousel.indicator.background}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource mkm.carousel.indicator.border.radius}" />
                        <Border x:Name="Anneau" Visibility="Collapsed" Margin="-2" BorderThickness="{DynamicResource mkm.carousel.indicator.ring.border.width}"
                                BorderBrush="{DynamicResource mkm.carousel.indicator.focus.ring.color}"
                                CornerRadius="{DynamicResource mkm.carousel.indicator.border.radius}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource mkm.carousel.indicator.hover.background}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <!-- La page montrée le dit aux lecteurs d'écran (aria-current de mkm). -->
                            <Setter Property="AutomationProperties.ItemStatus" Value="{loc:T aria.currentPage}" />
                            <Setter Property="Background" Value="{DynamicResource mkm.carousel.indicator.active.background}" />
                        </DataTrigger>
                        <Trigger Property="local:FocusVisible.IsVisible" Value="True">
                            <Setter TargetName="Anneau" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:Carousel}">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <local:PisteDeCarousel Gap="{DynamicResource mkm.carousel.content.gap}" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Carousel}">
                    <DockPanel>
                        <ItemsControl x:Name="PART_Indicators" DockPanel.Dock="Bottom" Focusable="False" HorizontalAlignment="Center"
                                      KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle"
                                      ItemsSource="{TemplateBinding Pages}" Margin="{DynamicResource mkm.carousel.indicator.list.padding}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <local:GapStackPanel Orientation="Horizontal" Gap="{DynamicResource mkm.carousel.indicator.list.gap}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource mkm.Carousel.Indicateur}" AutomationProperties.Name="{Binding Label}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <local:Button x:Name="PART_Previous" DockPanel.Dock="Left" Variant="Text" Severity="Secondary" VerticalAlignment="Center"
                                      Icon="{x:Static local:InternalIcons.ChevronLeft}" ToolTip="{loc:T aria.previousPage}"
                                      CornerRadius="{DynamicResource mkm.button.rounded.border.radius}"
                                      IsEnabled="{TemplateBinding CanGoPrevious}" />
                        <local:Button x:Name="PART_Next" DockPanel.Dock="Right" Variant="Text" Severity="Secondary" VerticalAlignment="Center"
                                      Icon="{x:Static local:InternalIcons.ChevronRight}" ToolTip="{loc:T aria.nextPage}"
                                      CornerRadius="{DynamicResource mkm.button.rounded.border.radius}"
                                      IsEnabled="{TemplateBinding CanGoNext}" />
                        <ItemsPresenter />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowIndicators" Value="False">
                            <Setter TargetName="PART_Indicators" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ShowNavigators" Value="False">
                            <Setter TargetName="PART_Previous" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_Next" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter TargetName="PART_Previous" Property="DockPanel.Dock" Value="Top" />
                            <Setter TargetName="PART_Previous" Property="HorizontalAlignment" Value="Center" />
                            <Setter TargetName="PART_Previous" Property="Icon" Value="{x:Static local:InternalIcons.ChevronUp}" />
                            <Setter TargetName="PART_Next" Property="DockPanel.Dock" Value="Bottom" />
                            <Setter TargetName="PART_Next" Property="HorizontalAlignment" Value="Center" />
                            <Setter TargetName="PART_Next" Property="Icon" Value="{x:Static local:InternalIcons.ChevronDown}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
