<!--
    Le style d'InputGroup, sur le groupe de saisie de mkm (styles/inputgroup) : des champs, des compléments et des
    boutons accolés sur une ligne, sans coins sauf aux deux bouts (inputgroup.addon.border.radius). Un complément : le
    fond et le gris des icônes d'un champ, 6 px de retrait, 30 px de large au moins, son contenu au milieu, bordé en
    haut et en bas, à gauche s'il est le premier ou suit un complément, à droite s'il est le dernier.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Mkm.Wpf.Controls">

    <Style TargetType="{x:Type local:InputGroup}">
        <Setter Property="FontFamily" Value="{DynamicResource mkm.font.family}" />
        <Setter Property="FontSize" Value="{DynamicResource mkm.font.size}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <local:RangeeDuGroupe />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:InputGroup}">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:InputGroupAddon}">
        <Setter Property="Background" Value="{DynamicResource mkm.inputgroup.addon.background}" />
        <Setter Property="Foreground" Value="{DynamicResource mkm.inputgroup.addon.color}" />
        <Setter Property="BorderBrush" Value="{DynamicResource mkm.inputgroup.addon.border.color}" />
        <Setter Property="BorderThickness" Value="{DynamicResource mkm.inputgroup.addon.border.width}" />
        <Setter Property="CornerRadius" Value="{DynamicResource mkm.inputgroup.addon.border.radius}" />
        <Setter Property="Padding" Value="{DynamicResource mkm.inputgroup.addon.padding}" />
        <Setter Property="MinWidth" Value="{DynamicResource mkm.inputgroup.addon.min.width}" />
        <Setter Property="FontFamily" Value="{DynamicResource mkm.font.family}" />
        <Setter Property="FontSize" Value="{DynamicResource mkm.font.size}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:InputGroupAddon}">
                    <Border x:Name="Bord" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="HasStartBorder" Value="True">
                <Setter Property="BorderThickness" Value="{DynamicResource mkm.inputgroup.addon.start.border.width}" />
            </Trigger>
            <Trigger Property="HasEndBorder" Value="True">
                <Setter Property="BorderThickness" Value="{DynamicResource mkm.inputgroup.addon.end.border.width}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="HasStartBorder" Value="True" />
                    <Condition Property="HasEndBorder" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="BorderThickness" Value="{DynamicResource mkm.inputgroup.addon.both.border.width}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
