<!--
    Le style de Button, sur le bouton de 3DEXPERIENCE de mkm (presets dashboard et ara, button) :
    24 px de haut (4 + 14 + 4 et la bordure), coins de 4 px, 8 px entre l'icône et le libellé, 65 px
    de large au moins avec un libellé ; l'icône de 16 px déborde d'un pixel sur le retrait ; le libellé
    tient une ligne, coupé de points de suspension. Les couleurs de chaque état viennent de la gravité
    et de la forme (Button.Colorer) ; ce gabarit ne connaît que repos, survol, focus clavier et enfoncé.

    Écarts avec mkm : un lien n'est pas souligné au survol ; les couleurs changent sans transition.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Mkm.Wpf.Controls">

    <Style TargetType="{x:Type local:Button}">
        <Setter Property="Height" Value="{DynamicResource mkm.button.height}" />
        <Setter Property="MinWidth" Value="{DynamicResource mkm.button.min.width}" />
        <Setter Property="Padding" Value="{DynamicResource mkm.button.padding}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource mkm.font.family}" />
        <Setter Property="FontSize" Value="{DynamicResource mkm.button.font.size}" />
        <Setter Property="FontWeight" Value="{DynamicResource mkm.button.label.font.weight}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Button}">
                    <Border x:Name="Fond"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource mkm.button.border.radius}"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                            <local:Icon x:Name="Icone" Width="16" Height="16" Margin="0,-1" Visibility="Collapsed"
                                        Source="{TemplateBinding Icon}" />
                            <Rectangle x:Name="Ecart" Width="{DynamicResource mkm.button.gap}" Visibility="Collapsed" />
                            <ContentPresenter x:Name="Libelle" VerticalAlignment="Center" RecognizesAccessKey="True">
                                <ContentPresenter.Resources>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasIcon" Value="True">
                            <Setter TargetName="Icone" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Ecart" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsIconOnly" Value="True">
                            <Setter TargetName="Ecart" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Libelle" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fond" Property="Background" Value="{Binding HoverBackground, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Fond" Property="BorderBrush" Value="{Binding HoverBorderBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter Property="Foreground" Value="{Binding HoverForeground, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsFocusVisible" Value="True">
                            <Setter TargetName="Fond" Property="Background" Value="{Binding FocusBackground, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Fond" Property="BorderBrush" Value="{Binding FocusBorderBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fond" Property="Background" Value="{Binding PressedBackground, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Fond" Property="BorderBrush" Value="{Binding PressedBorderBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter Property="Foreground" Value="{Binding PressedForeground, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <!-- Le bouton « lite » de 3DEXPERIENCE : en texte et d'icône seule, sans fond ni bordure,
                             gris, du gris du texte au survol et au clavier, bleu clair enfoncé. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="Text" />
                                <Condition Property="IsIconOnly" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Fond" Property="Background" Value="Transparent" />
                            <Setter TargetName="Fond" Property="BorderThickness" Value="0" />
                            <Setter Property="Foreground" Value="{DynamicResource mkm.button.icon.color}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="Text" />
                                <Condition Property="IsIconOnly" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource mkm.button.icon.hover.color}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="Text" />
                                <Condition Property="IsIconOnly" Value="True" />
                                <Condition Property="IsFocusVisible" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource mkm.button.icon.hover.color}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Variant" Value="Text" />
                                <Condition Property="IsIconOnly" Value="True" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource mkm.button.icon.active.color}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fond" Property="Opacity" Value="{DynamicResource mkm.disabled.opacity}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- La largeur de 65 px ne vaut que pour un bouton plein ou à contour, avec un libellé. -->
            <Trigger Property="Variant" Value="Text">
                <Setter Property="MinWidth" Value="0" />
            </Trigger>
            <Trigger Property="Variant" Value="Link">
                <Setter Property="MinWidth" Value="0" />
            </Trigger>
            <!-- Un bouton d'icône seule fait 24 px de côté : l'icône de 16 px, 3 px autour, la bordure. -->
            <Trigger Property="IsIconOnly" Value="True">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Width" Value="{DynamicResource mkm.button.icon.only.width}" />
                <Setter Property="Padding" Value="3" />
            </Trigger>
            <!-- Le bouton « lite » : 16 px de large, l'icône 5 px sous le haut. -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Variant" Value="Text" />
                    <Condition Property="IsIconOnly" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Width" Value="16" />
                <Setter Property="Padding" Value="0,5,0,3" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
