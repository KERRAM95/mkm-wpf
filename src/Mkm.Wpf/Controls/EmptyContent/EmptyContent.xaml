<!--
    Les styles d'EmptyContent et d'EmptyContentItem, sur l'écran vide de mkm (preset emptycontent et sa feuille) : un bloc
    centré, 24 px autour, de 420 px au plus ; une icône grise de 32 px, un titre de 16 px semi-gras, un message de 14 px
    gris, 8 px entre eux ; les possibilités, 16 px entre elles : une pastille ronde de 48 px de la couleur principale
    pâlie, son icône de 22 px, puis le message, 10 px dessous ; entre deux, « ou » (12 px semi-gras, gris) entre deux
    traits de 32 px. Les actions 16 px sous le bloc, 6 px entre elles. Petit : 24, 14, 12 px, une pastille de 36 px.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Mkm.Wpf.Controls"
                    xmlns:loc="clr-namespace:Mkm.Wpf.Localization">

    <!-- Les textes de l'écran vide : centrés, à la ligne. -->
    <Style x:Key="mkm.EmptyContent.Texte" TargetType="{x:Type TextBlock}">
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style TargetType="{x:Type local:EmptyContentItem}">
        <Setter Property="FontSize" Value="{DynamicResource mkm.emptycontent.message.font.size}" />
        <Setter Property="Foreground" Value="{DynamicResource mkm.emptycontent.message.color}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:EmptyContentItem}">
                    <local:GapStackPanel Gap="{DynamicResource mkm.emptycontent.item.gap}">
                        <Grid x:Name="Pastille" HorizontalAlignment="Center"
                              Width="{DynamicResource mkm.emptycontent.avatar.size}" Height="{DynamicResource mkm.emptycontent.avatar.size}">
                            <Ellipse Fill="{DynamicResource mkm.emptycontent.avatar.background}" />
                            <local:Icon x:Name="Icone" Source="{TemplateBinding Icon}"
                                        Width="{DynamicResource mkm.emptycontent.avatar.icon.size}"
                                        Height="{DynamicResource mkm.emptycontent.avatar.icon.size}"
                                        Foreground="{DynamicResource mkm.emptycontent.avatar.color}" />
                        </Grid>
                        <ContentPresenter HorizontalAlignment="Center">
                            <ContentPresenter.Resources>
                                <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource mkm.EmptyContent.Texte}" />
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                        <!-- « ou », entre deux traits courts : la séparation d'avec la possibilité suivante. -->
                        <StackPanel x:Name="Ou" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed">
                            <Rectangle Height="1" VerticalAlignment="Center"
                                       Width="{DynamicResource mkm.emptycontent.separator.line.width}"
                                       Fill="{DynamicResource mkm.emptycontent.separator.line.color}" />
                            <TextBlock VerticalAlignment="Center" Margin="{DynamicResource mkm.emptycontent.separator.margin}"
                                       FontSize="{DynamicResource mkm.emptycontent.separator.font.size}"
                                       FontWeight="{DynamicResource mkm.emptycontent.separator.font.weight}"
                                       Foreground="{DynamicResource mkm.emptycontent.separator.color}"
                                       Text="{loc:T locale.or}" />
                            <Rectangle Height="1" VerticalAlignment="Center"
                                       Width="{DynamicResource mkm.emptycontent.separator.line.width}"
                                       Fill="{DynamicResource mkm.emptycontent.separator.line.color}" />
                        </StackPanel>
                    </local:GapStackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="Pastille" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsLast" Value="False">
                            <Setter TargetName="Ou" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Size" Value="Small">
                            <Setter Property="FontSize" Value="{DynamicResource mkm.emptycontent.message.sm.font.size}" />
                            <Setter TargetName="Pastille" Property="Width" Value="{DynamicResource mkm.emptycontent.avatar.sm.size}" />
                            <Setter TargetName="Pastille" Property="Height" Value="{DynamicResource mkm.emptycontent.avatar.sm.size}" />
                            <Setter TargetName="Icone" Property="Width" Value="{DynamicResource mkm.emptycontent.avatar.icon.sm.size}" />
                            <Setter TargetName="Icone" Property="Height" Value="{DynamicResource mkm.emptycontent.avatar.icon.sm.size}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:EmptyContent}">
        <Setter Property="Background" Value="{DynamicResource mkm.emptycontent.background}" />
        <Setter Property="Foreground" Value="{DynamicResource mkm.emptycontent.color}" />
        <Setter Property="Padding" Value="{DynamicResource mkm.emptycontent.padding}" />
        <Setter Property="FontFamily" Value="{DynamicResource mkm.font.family}" />
        <Setter Property="FontSize" Value="{DynamicResource mkm.font.size}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <local:GapStackPanel Gap="{DynamicResource mkm.emptycontent.list.gap}" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:EmptyContent}">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <local:GapStackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Gap="{DynamicResource mkm.emptycontent.gap}">
                            <!-- Ce qui est annoncé aux lecteurs d'écran : l'icône, le titre, le message, les possibilités. -->
                            <local:GapStackPanel x:Name="Contenu" Gap="{DynamicResource mkm.emptycontent.content.gap}"
                                                 MaxWidth="{DynamicResource mkm.emptycontent.content.max.width}"
                                                 AutomationProperties.LiveSetting="Polite">
                                <local:Icon x:Name="Icone" Source="{TemplateBinding Icon}" HorizontalAlignment="Center"
                                            Width="{DynamicResource mkm.emptycontent.icon.size}"
                                            Height="{DynamicResource mkm.emptycontent.icon.size}"
                                            Foreground="{DynamicResource mkm.emptycontent.icon.color}" />
                                <TextBlock x:Name="Titre" Style="{StaticResource mkm.EmptyContent.Texte}"
                                           Text="{TemplateBinding Title}"
                                           FontSize="{DynamicResource mkm.emptycontent.title.font.size}"
                                           FontWeight="{DynamicResource mkm.emptycontent.title.font.weight}"
                                           Foreground="{DynamicResource mkm.emptycontent.title.color}" />
                                <ContentPresenter x:Name="Message" Content="{TemplateBinding Message}" HorizontalAlignment="Center"
                                                  TextElement.FontSize="{DynamicResource mkm.emptycontent.message.font.size}"
                                                  TextElement.Foreground="{DynamicResource mkm.emptycontent.message.color}">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource mkm.EmptyContent.Texte}" />
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                                <ItemsPresenter x:Name="Possibilites" />
                            </local:GapStackPanel>
                            <ContentPresenter x:Name="LesActions" Content="{TemplateBinding Actions}" HorizontalAlignment="Center" />
                        </local:GapStackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="Icone" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Title" Value="{x:Null}">
                            <Setter TargetName="Titre" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Message" Value="{x:Null}">
                            <Setter TargetName="Message" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Possibilites" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Actions" Value="{x:Null}">
                            <Setter TargetName="LesActions" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Size" Value="Small">
                            <Setter TargetName="Icone" Property="Width" Value="{DynamicResource mkm.emptycontent.icon.sm.size}" />
                            <Setter TargetName="Icone" Property="Height" Value="{DynamicResource mkm.emptycontent.icon.sm.size}" />
                            <Setter TargetName="Titre" Property="FontSize" Value="{DynamicResource mkm.emptycontent.title.sm.font.size}" />
                            <Setter TargetName="Message" Property="TextElement.FontSize" Value="{DynamicResource mkm.emptycontent.message.sm.font.size}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
