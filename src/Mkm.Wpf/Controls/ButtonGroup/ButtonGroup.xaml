<!--
    Le style de ButtonGroup, sur le groupe de boutons de mkm (styles/buttongroup) : les boutons en ligne, collés ; les
    coins et la bordure de chacun suivent sa place (le style de Button lit ButtonGroup.Position).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Mkm.Wpf.Controls">

    <Style TargetType="{x:Type local:ButtonGroup}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ButtonGroup}">
                    <StackPanel IsItemsHost="True" Orientation="Horizontal" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
