<!--
    Le style de Drawer, sur le tiroir de mkm (styles/drawer ; jetons de Nora en pixels pour Dashboard, preset ara) : le
    voile du thème (mask.background) sur tout son conteneur ; le panneau des fenêtres de mkm (overlay.modal), 240 px de
    large (120 px de haut en haut ou en bas), bordé d'un pixel du côté de la page, ombré ; son titre de 18 px en gras et
    sa croix, son contenu qui défile, son pied.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Mkm.Wpf.Controls"
                    xmlns:loc="clr-namespace:Mkm.Wpf.Localization">

    <Style TargetType="{x:Type local:Drawer}">
        <Setter Property="FontFamily" Value="{DynamicResource mkm.font.family}" />
        <Setter Property="FontSize" Value="{DynamicResource mkm.font.size}" />
        <Setter Property="Foreground" Value="{DynamicResource mkm.drawer.color}" />
        <Setter Property="Background" Value="{DynamicResource mkm.drawer.background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource mkm.drawer.border.color}" />
        <Setter Property="Panel.ZIndex" Value="900" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Drawer}">
                    <Grid>
                        <Rectangle x:Name="PART_Mask" Fill="{DynamicResource mkm.mask.background}" />
                        <Grid x:Name="PART_Panel" Width="{DynamicResource mkm.drawer.width}" HorizontalAlignment="Left"
                              KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
                            <Border Background="{TemplateBinding Background}" Effect="{DynamicResource mkm.drawer.shadow}" />
                            <Border x:Name="Cadre" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="0,0,1,0">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="{DynamicResource mkm.drawer.header.padding}">
                                        <local:Button x:Name="PART_Close" DockPanel.Dock="Right" Variant="Text" Severity="Secondary"
                                                      Icon="{x:Static local:InternalIcons.Times}" AutomationProperties.Name="{loc:T aria.close}" />
                                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"
                                                          TextElement.FontSize="{DynamicResource mkm.drawer.title.font.size}"
                                                          TextElement.FontWeight="{DynamicResource mkm.drawer.title.font.weight}" />
                                    </DockPanel>
                                    <ContentPresenter x:Name="Pied" DockPanel.Dock="Bottom" Content="{TemplateBinding Footer}"
                                                      Margin="{DynamicResource mkm.drawer.footer.padding}" />
                                    <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ContentPresenter Margin="{DynamicResource mkm.drawer.content.padding}" />
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Position" Value="Right">
                            <Setter TargetName="PART_Panel" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Cadre" Property="BorderThickness" Value="1,0,0,0" />
                        </Trigger>
                        <Trigger Property="Position" Value="Top">
                            <Setter TargetName="PART_Panel" Property="Width" Value="NaN" />
                            <Setter TargetName="PART_Panel" Property="HorizontalAlignment" Value="Stretch" />
                            <Setter TargetName="PART_Panel" Property="VerticalAlignment" Value="Top" />
                            <Setter TargetName="PART_Panel" Property="Height" Value="{DynamicResource mkm.drawer.height}" />
                            <Setter TargetName="Cadre" Property="BorderThickness" Value="0,0,0,1" />
                        </Trigger>
                        <Trigger Property="Position" Value="Bottom">
                            <Setter TargetName="PART_Panel" Property="Width" Value="NaN" />
                            <Setter TargetName="PART_Panel" Property="HorizontalAlignment" Value="Stretch" />
                            <Setter TargetName="PART_Panel" Property="VerticalAlignment" Value="Bottom" />
                            <Setter TargetName="PART_Panel" Property="Height" Value="{DynamicResource mkm.drawer.height}" />
                            <Setter TargetName="Cadre" Property="BorderThickness" Value="0,1,0,0" />
                        </Trigger>
                        <Trigger Property="Position" Value="Full">
                            <Setter TargetName="PART_Panel" Property="Width" Value="NaN" />
                            <Setter TargetName="PART_Panel" Property="HorizontalAlignment" Value="Stretch" />
                            <Setter TargetName="Cadre" Property="BorderThickness" Value="1" />
                        </Trigger>
                        <Trigger Property="Footer" Value="{x:Null}">
                            <Setter TargetName="Pied" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ShowCloseIcon" Value="False">
                            <Setter TargetName="PART_Close" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsOpen" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
