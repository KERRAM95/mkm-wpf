<!--
    Le style de Skeleton, sur la silhouette de mkm (styles/skeleton ; jetons de Nora en pixels pour Dashboard, preset
    ara) : un bloc gris pâle (skeleton.background) aux coins du thème, 12 px de haut par défaut (1rem) ; un rond pour
    Shape="Circle". La vague : une bande blanche à 40 % (skeleton.animation.background), dégradée sur ses bords, qui
    passe de gauche à droite en 1,2 s, sans fin, tant que la silhouette est visible.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Mkm.Wpf.Controls">

    <Style TargetType="{x:Type local:Skeleton}">
        <Setter Property="Height" Value="{DynamicResource mkm.skeleton.height}" />
        <Setter Property="CornerRadius" Value="{DynamicResource mkm.skeleton.border.radius}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Skeleton}">
                    <ControlTemplate.Resources>
                        <Storyboard x:Key="Vague">
                            <DoubleAnimation Storyboard.TargetName="Bande" From="-1" To="1" Duration="0:0:1.2" RepeatBehavior="Forever"
                                             Storyboard.TargetProperty="(UIElement.OpacityMask).(Brush.RelativeTransform).(TranslateTransform.X)" />
                            <DoubleAnimation Storyboard.TargetName="BandeRonde" From="-1" To="1" Duration="0:0:1.2" RepeatBehavior="Forever"
                                             Storyboard.TargetProperty="(UIElement.OpacityMask).(Brush.RelativeTransform).(TranslateTransform.X)" />
                        </Storyboard>
                    </ControlTemplate.Resources>
                    <Grid>
                        <Border x:Name="Forme" CornerRadius="{TemplateBinding CornerRadius}" Background="{DynamicResource mkm.skeleton.background}" />
                        <!-- La vague a la forme de la silhouette : une Border aux mêmes coins, que son masque dévoile. -->
                        <Border x:Name="Bande" CornerRadius="{TemplateBinding CornerRadius}" Background="{DynamicResource mkm.skeleton.animation.background}">
                            <Border.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <LinearGradientBrush.RelativeTransform>
                                        <TranslateTransform X="-1" />
                                    </LinearGradientBrush.RelativeTransform>
                                    <GradientStop Color="Transparent" Offset="0" />
                                    <GradientStop Color="Black" Offset="0.5" />
                                    <GradientStop Color="Transparent" Offset="1" />
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                        </Border>
                        <Ellipse x:Name="Rond" Visibility="Collapsed" Fill="{DynamicResource mkm.skeleton.background}" />
                        <Ellipse x:Name="BandeRonde" Visibility="Collapsed" Fill="{DynamicResource mkm.skeleton.animation.background}">
                            <Ellipse.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <LinearGradientBrush.RelativeTransform>
                                        <TranslateTransform X="-1" />
                                    </LinearGradientBrush.RelativeTransform>
                                    <GradientStop Color="Transparent" Offset="0" />
                                    <GradientStop Color="Black" Offset="0.5" />
                                    <GradientStop Color="Transparent" Offset="1" />
                                </LinearGradientBrush>
                            </Ellipse.OpacityMask>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Shape" Value="Circle">
                            <Setter TargetName="Forme" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Bande" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Rond" Property="Visibility" Value="Visible" />
                            <Setter TargetName="BandeRonde" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Animation" Value="None">
                            <Setter TargetName="Bande" Property="Opacity" Value="0" />
                            <Setter TargetName="BandeRonde" Property="Opacity" Value="0" />
                        </Trigger>
                        <!-- La vague ne tourne que visible et voulue : une silhouette cachée ne coûte rien. -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Animation" Value="Wave" />
                                <Condition Property="IsVisible" Value="True" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard x:Name="Defilement" Storyboard="{StaticResource Vague}" />
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="Defilement" />
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
