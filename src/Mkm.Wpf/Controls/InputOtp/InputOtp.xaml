<!--
    Le style d'InputOtp, sur le code à usage unique de mkm (styles/inputotp ; jetons de Nora en pixels, dans les deux
    thèmes) : des cases d'InputText de 30 px de large, le caractère au milieu, à 6 px l'une de l'autre.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Mkm.Wpf.Controls">

    <Style TargetType="{x:Type local:InputOtp}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:InputOtp}">
                    <local:GapStackPanel x:Name="PART_Inputs" Orientation="Horizontal" Gap="{DynamicResource mkm.inputotp.gap}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
