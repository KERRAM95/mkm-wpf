<!--
    Le style de Card, sur la carte de mkm (styles/card ; jetons de Nora en pixels pour Dashboard, preset ara) : blanche,
    ombrée (card.shadow), aux coins du thème ; son haut (Header) sans retrait ; dessous, à 15 px du bord, 6 px entre eux :
    le titre (15 px, demi-gras) et le sous-titre gris, le contenu, le pied.

    L'ombre est posée sur un fond à part, derrière la carte : posée sur la carte, elle flouterait aussi son texte.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Mkm.Wpf.Controls">

    <Style TargetType="{x:Type local:Card}">
        <Setter Property="FontFamily" Value="{DynamicResource mkm.font.family}" />
        <Setter Property="FontSize" Value="{DynamicResource mkm.font.size}" />
        <Setter Property="Foreground" Value="{DynamicResource mkm.card.color}" />
        <Setter Property="Background" Value="{DynamicResource mkm.card.background}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Card}">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource mkm.card.border.radius}"
                                Effect="{DynamicResource mkm.card.shadow}" />
                        <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource mkm.card.border.radius}">
                            <DockPanel>
                                <ContentPresenter x:Name="Haut" DockPanel.Dock="Top" Content="{TemplateBinding Header}" />
                                <local:GapStackPanel Margin="{DynamicResource mkm.card.body.padding}" Gap="{DynamicResource mkm.card.body.gap}">
                                    <local:GapStackPanel x:Name="Legende" Gap="{DynamicResource mkm.card.caption.gap}">
                                        <ContentPresenter x:Name="Titre" Content="{TemplateBinding Title}"
                                                          TextElement.FontSize="{DynamicResource mkm.card.title.font.size}"
                                                          TextElement.FontWeight="{DynamicResource mkm.card.title.font.weight}" />
                                        <ContentPresenter x:Name="SousTitre" Content="{TemplateBinding Subtitle}"
                                                          TextElement.Foreground="{DynamicResource mkm.card.subtitle.color}" />
                                    </local:GapStackPanel>
                                    <ContentPresenter x:Name="Corps" />
                                    <ContentPresenter x:Name="Pied" Content="{TemplateBinding Footer}" />
                                </local:GapStackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="Haut" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Title" Value="{x:Null}">
                            <Setter TargetName="Titre" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Subtitle" Value="{x:Null}">
                            <Setter TargetName="SousTitre" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <!-- Vide (une chaîne liée vide) comme absent : la partie disparaît. -->
                        <Trigger Property="Title" Value="">
                            <Setter TargetName="Titre" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Subtitle" Value="">
                            <Setter TargetName="SousTitre" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Title" Value="{x:Null}" />
                                <Condition Property="Subtitle" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Legende" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Title" Value="" />
                                <Condition Property="Subtitle" Value="" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Legende" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Title" Value="{x:Null}" />
                                <Condition Property="Subtitle" Value="" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Legende" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Title" Value="" />
                                <Condition Property="Subtitle" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Legende" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Corps" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Footer" Value="{x:Null}">
                            <Setter TargetName="Pied" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
