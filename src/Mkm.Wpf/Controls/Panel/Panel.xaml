<!--
    Le style de Panel, sur le panneau de mkm (styles/panel ; jetons de Nora en pixels pour Dashboard, preset ara) : bordé
    d'un pixel (panel.border.color), aux coins du thème ; l'en-tête, 13,5 px de retrait, son titre en gras, un trait
    dessous ; le contenu, 13,5 px de retrait ; le pied, sous le contenu. Repliable : un retrait d'en-tête réduit
    (panel.toggleable.header.padding) et un bouton de texte moins / plus à droite ; replié, le contenu et le pied
    disparaissent.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Mkm.Wpf.Controls">

    <Style TargetType="{x:Type local:Panel}">
        <Setter Property="FontFamily" Value="{DynamicResource mkm.font.family}" />
        <Setter Property="FontSize" Value="{DynamicResource mkm.font.size}" />
        <Setter Property="Foreground" Value="{DynamicResource mkm.panel.color}" />
        <Setter Property="Background" Value="{DynamicResource mkm.panel.background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource mkm.panel.border.color}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Panel}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource mkm.panel.border.radius}">
                        <DockPanel>
                            <Border x:Name="EnTete" DockPanel.Dock="Top" Padding="{DynamicResource mkm.panel.header.padding}"
                                    Background="{DynamicResource mkm.panel.header.background}"
                                    BorderThickness="{DynamicResource mkm.panel.header.border.width}"
                                    BorderBrush="{DynamicResource mkm.panel.header.border.color}"
                                    CornerRadius="{DynamicResource mkm.panel.header.border.radius}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ContentPresenter Content="{TemplateBinding Actions}" VerticalAlignment="Center" />
                                        <local:BoutonDeRepli x:Name="PART_Toggle" Visibility="Collapsed" Variant="Text" Severity="Secondary"
                                                             IsCollapsed="{TemplateBinding IsCollapsed}"
                                                             Icon="{x:Static local:InternalIcons.Minus}" />
                                    </StackPanel>
                                    <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"
                                                      TextElement.FontWeight="{DynamicResource mkm.panel.title.font.weight}"
                                                      TextElement.Foreground="{DynamicResource mkm.panel.header.color}" />
                                </DockPanel>
                            </Border>
                            <ContentPresenter x:Name="Pied" DockPanel.Dock="Bottom" Content="{TemplateBinding Footer}"
                                              Margin="{DynamicResource mkm.panel.footer.padding}" />
                            <ContentPresenter x:Name="Contenu" Margin="{DynamicResource mkm.panel.content.padding}" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Footer" Value="{x:Null}">
                            <Setter TargetName="Pied" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Toggleable" Value="True">
                            <Setter TargetName="PART_Toggle" Property="Visibility" Value="Visible" />
                            <Setter TargetName="EnTete" Property="Padding" Value="{DynamicResource mkm.panel.toggleable.header.padding}" />
                        </Trigger>
                        <Trigger Property="IsCollapsed" Value="True">
                            <Setter TargetName="PART_Toggle" Property="Icon" Value="{x:Static local:InternalIcons.Plus}" />
                            <Setter TargetName="Contenu" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Pied" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
