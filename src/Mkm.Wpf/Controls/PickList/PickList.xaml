<!--
    Le style de PickList, sur les deux listes de mkm (styles/picklist ; jetons de Nora en pixels, dans les deux
    thèmes) : la source (une OrderList, ses boutons à gauche), au milieu les quatre boutons secondaires d'icône (vers
    la cible, tout vers la cible, vers la source, tout vers la source) à 6 px l'un de l'autre, puis la cible (une
    OrderList, ses boutons à droite) ; 13,5 px entre eux. Les deux listes se partagent la largeur.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Mkm.Wpf.Controls"
                    xmlns:loc="clr-namespace:Mkm.Wpf.Localization">

    <Style TargetType="{x:Type local:PickList}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:PickList}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <local:OrderList x:Name="PART_Source" ItemsSource="{TemplateBinding Source}" Header="{TemplateBinding SourceHeader}"
                                         ItemTemplate="{TemplateBinding ItemTemplate}" DisplayMemberPath="{TemplateBinding DisplayMemberPath}"
                                         ShowControls="{TemplateBinding ShowSourceControls}" />
                        <local:GapStackPanel Grid.Column="1" VerticalAlignment="Center" Gap="{DynamicResource mkm.picklist.controls.gap}"
                                             Margin="{DynamicResource mkm.picklist.controls.margin}">
                            <local:Button x:Name="PART_MoveToTarget" Severity="Secondary" Icon="{x:Static local:InternalIcons.AngleRight}"
                                          ToolTip="{loc:T aria.moveToTarget}" />
                            <local:Button x:Name="PART_MoveAllToTarget" Severity="Secondary" Icon="{x:Static local:InternalIcons.AngleDoubleRight}"
                                          ToolTip="{loc:T aria.moveAllToTarget}" />
                            <local:Button x:Name="PART_MoveToSource" Severity="Secondary" Icon="{x:Static local:InternalIcons.AngleLeft}"
                                          ToolTip="{loc:T aria.moveToSource}" />
                            <local:Button x:Name="PART_MoveAllToSource" Severity="Secondary" Icon="{x:Static local:InternalIcons.AngleDoubleLeft}"
                                          ToolTip="{loc:T aria.moveAllToSource}" />
                        </local:GapStackPanel>
                        <local:OrderList x:Name="PART_Target" Grid.Column="2" ItemsSource="{TemplateBinding Target}" Header="{TemplateBinding TargetHeader}"
                                         ItemTemplate="{TemplateBinding ItemTemplate}" DisplayMemberPath="{TemplateBinding DisplayMemberPath}"
                                         ShowControls="{TemplateBinding ShowTargetControls}" ControlsPosition="Right" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
