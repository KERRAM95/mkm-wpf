<!--
    Le style de Tag, sur l'étiquette de la grille de 3DEXPERIENCE de mkm (presets dashboard et ara, tag) : 2 px sur 3
    de retrait (18 px de haut), à angles droits, un texte de 12 px en graisse normale, une icône de 12 px à 4 px de
    lui ; Rounded, des bouts ronds. Les couleurs viennent de la gravité ou de Color (Tag.Colorer).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Mkm.Wpf.Controls">

    <Style TargetType="{x:Type local:Tag}">
        <Setter Property="Padding" Value="{DynamicResource mkm.tag.padding}" />
        <Setter Property="FontFamily" Value="{DynamicResource mkm.font.family}" />
        <Setter Property="FontSize" Value="{DynamicResource mkm.tag.font.size}" />
        <Setter Property="FontWeight" Value="{DynamicResource mkm.tag.font.weight}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Tag}">
                    <Border x:Name="Fond" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                            CornerRadius="{DynamicResource mkm.tag.border.radius}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <local:Icon x:Name="Icone" Source="{TemplateBinding Icon}" VerticalAlignment="Center"
                                        Width="{DynamicResource mkm.tag.icon.size}" Height="{DynamicResource mkm.tag.icon.size}" />
                            <Rectangle x:Name="Ecart" Width="{DynamicResource mkm.tag.gap}" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="Icone" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Ecart" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Rounded" Value="True">
                            <Setter TargetName="Fond" Property="CornerRadius" Value="{DynamicResource mkm.tag.rounded.border.radius}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
