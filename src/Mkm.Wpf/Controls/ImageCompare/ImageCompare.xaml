<!--
    Le style d'ImageCompare, sur la comparaison d'images de mkm (styles/imagecompare ; jetons de Nora en pixels pour
    Dashboard, preset ara) : les deux images l'une sur l'autre, 16/9 de la largeur ; la poignée, un carré de 15 px aux
    coins du thème, bordé de 3 px de blanc à 30 %, qui grandit à 30 px au survol ; au clavier, l'anneau autour.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Mkm.Wpf.Controls"
                    xmlns:loc="clr-namespace:Mkm.Wpf.Localization">

    <!-- La poignée, curseur sans piste, sur toute la hauteur. -->
    <Style x:Key="mkm.ImageCompare.Poignee" TargetType="{x:Type Thumb}">
        <Setter Property="Width" Value="{DynamicResource mkm.imagecompare.handle.size}" />
        <Setter Property="Height" Value="{DynamicResource mkm.imagecompare.handle.size}" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Background="{DynamicResource mkm.imagecompare.handle.background}"
                            BorderBrush="{DynamicResource mkm.imagecompare.handle.border.color}"
                            BorderThickness="{DynamicResource mkm.imagecompare.handle.all.border.width}"
                            CornerRadius="{DynamicResource mkm.imagecompare.handle.border.radius}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Width" Value="{DynamicResource mkm.imagecompare.handle.hover.size}" />
                <Setter Property="Height" Value="{DynamicResource mkm.imagecompare.handle.hover.size}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="mkm.ImageCompare.Curseur" TargetType="{x:Type Slider}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Slider}">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" Margin="{DynamicResource mkm.imagecompare.track.margin}">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource mkm.ImageCompare.Poignee}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:ImageCompare}">
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ImageCompare}">
                    <Grid>
                        <Image Source="{TemplateBinding RightImage}" Stretch="UniformToFill" />
                        <Image x:Name="PART_Left" Source="{TemplateBinding LeftImage}" Stretch="UniformToFill" />
                        <Slider x:Name="Curseur" Style="{StaticResource mkm.ImageCompare.Curseur}" Minimum="0" Maximum="100"
                                SmallChange="1" LargeChange="10" AutomationProperties.Name="{loc:T aria.compare}"
                                Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                        <Rectangle x:Name="Anneau" Visibility="Collapsed" IsHitTestVisible="False"
                                   Stroke="{DynamicResource mkm.imagecompare.handle.focus.ring.color}"
                                   StrokeThickness="{DynamicResource mkm.imagecompare.handle.focus.ring.width}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger SourceName="Curseur" Property="local:FocusVisible.IsVisible" Value="True">
                            <Setter TargetName="Anneau" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
