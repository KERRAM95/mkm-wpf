<!--
    Le style de CascadeSelect, sur la liste déroulante en cascade de mkm (styles/cascadeselect ; jetons de Nora en
    pixels pour Dashboard, preset ara : le preset dashboard ne la redessine pas) : le champ de MultiSelect (fond,
    bordure d'un pixel, coins du thème ; le texte gris tant que rien n'est choisi ; le chevron dans 30 px à droite ; la
    bordure plus foncée au survol, au bleu du thème au clavier et liste ouverte). La liste s'ouvre dessous, aussi large
    que le champ au moins, dans un cadre ombré ; chaque option, le retrait et les coins des options de liste, la flèche
    d'un groupe à droite ; survolée ou sous le clavier, le fond de la surbrillance ; choisie, celui du choix ; la liste
    d'un groupe s'ouvre à sa droite, dans le même cadre.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Mkm.Wpf.Controls">

    <!-- Toute la surface du champ ouvre la liste. -->
    <Style x:Key="mkm.CascadeSelect.Zone" TargetType="{x:Type ToggleButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:CascadeSelect}">
        <Setter Property="Background" Value="{DynamicResource mkm.cascadeselect.background}" />
        <Setter Property="Foreground" Value="{DynamicResource mkm.cascadeselect.color}" />
        <Setter Property="BorderBrush" Value="{DynamicResource mkm.cascadeselect.border.color}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource mkm.font.family}" />
        <Setter Property="FontSize" Value="{DynamicResource mkm.font.size}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CascadeSelect}">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource mkm.cascadeselect.border.radius}">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Width="{DynamicResource mkm.cascadeselect.dropdown.width}">
                                    <local:Icon Source="{x:Static local:InternalIcons.ChevronDown}" HorizontalAlignment="Center"
                                                VerticalAlignment="Center" Width="{DynamicResource mkm.icon.size}"
                                                Height="{DynamicResource mkm.icon.size}"
                                                Foreground="{DynamicResource mkm.cascadeselect.dropdown.color}" />
                                </Border>
                                <Grid ClipToBounds="True">
                                    <TextBlock x:Name="Aide" Visibility="Collapsed" Margin="{DynamicResource mkm.cascadeselect.label.padding}"
                                               TextTrimming="CharacterEllipsis" Text="{TemplateBinding Placeholder}"
                                               Foreground="{DynamicResource mkm.cascadeselect.placeholder.color}" />
                                    <TextBlock x:Name="Libelle" Margin="{DynamicResource mkm.cascadeselect.label.padding}"
                                               TextTrimming="CharacterEllipsis" Text="{TemplateBinding SelectionText}" />
                                    <!-- La hauteur d'une ligne de texte, que le champ garde vide. -->
                                    <TextBlock Margin="{DynamicResource mkm.cascadeselect.label.padding}" Text=" " Visibility="Hidden" />
                                </Grid>
                            </DockPanel>
                        </Border>
                        <ToggleButton x:Name="PART_Field" Style="{StaticResource mkm.CascadeSelect.Zone}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasSelection" Value="False">
                            <Setter TargetName="Aide" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Libelle" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <!-- Refusé : le survol et le clavier l'emportent sur le rouge, comme mkm (:enabled:hover et :focus pèsent plus que .p-invalid). -->
                        <Trigger Property="Invalid" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource mkm.cascadeselect.invalid.border.color}" />
                            <Setter TargetName="Aide" Property="Foreground" Value="{DynamicResource mkm.cascadeselect.invalid.placeholder.color}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource mkm.cascadeselect.hover.border.color}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource mkm.cascadeselect.focus.border.color}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource mkm.cascadeselect.focus.border.color}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{DynamicResource mkm.cascadeselect.disabled.background}" />
                            <Setter TargetName="Libelle" Property="Foreground" Value="{DynamicResource mkm.cascadeselect.disabled.color}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Le cadre d'une liste : le fond, la bordure, les coins et l'ombre des listes de mkm ; ses options l'une sous l'autre. -->
    <ControlTemplate x:Key="mkm.CascadeSelect.Cadre" TargetType="{x:Type ContentControl}">
        <Grid Margin="{DynamicResource mkm.cascadeselect.overlay.window.padding}">
            <Border Background="{DynamicResource mkm.cascadeselect.overlay.background}"
                    CornerRadius="{DynamicResource mkm.cascadeselect.overlay.border.radius}"
                    Effect="{DynamicResource mkm.cascadeselect.overlay.shadow}" />
            <Border Background="{DynamicResource mkm.cascadeselect.overlay.background}" BorderThickness="1"
                    BorderBrush="{DynamicResource mkm.cascadeselect.overlay.border.color}"
                    CornerRadius="{DynamicResource mkm.cascadeselect.overlay.border.radius}"
                    Padding="{DynamicResource mkm.cascadeselect.list.padding}">
                <ContentPresenter />
            </Border>
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type local:ListeEnCascade}">
        <Setter Property="Foreground" Value="{DynamicResource mkm.cascadeselect.overlay.color}" />
        <Setter Property="FontFamily" Value="{DynamicResource mkm.font.family}" />
        <Setter Property="FontSize" Value="{DynamicResource mkm.font.size}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="VerticalOffset" Value="{DynamicResource mkm.anchor.gutter}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ListeEnCascade}">
                    <ContentControl Focusable="False" Template="{StaticResource mkm.CascadeSelect.Cadre}">
                        <local:GapStackPanel IsItemsHost="True" Gap="{DynamicResource mkm.cascadeselect.list.gap}"
                                             KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </ContentControl>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:CascadeSelectItem}">
        <Setter Property="Foreground" Value="{DynamicResource mkm.cascadeselect.option.color}" />
        <Setter Property="Padding" Value="{DynamicResource mkm.cascadeselect.option.padding}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CascadeSelectItem}">
                    <Grid>
                        <Border x:Name="Fond" Background="Transparent" Padding="{TemplateBinding Padding}"
                                CornerRadius="{DynamicResource mkm.cascadeselect.option.border.radius}">
                            <DockPanel>
                                <local:Icon x:Name="Fleche" DockPanel.Dock="Right" Visibility="Collapsed" VerticalAlignment="Center"
                                            Margin="{DynamicResource mkm.cascadeselect.option.icon.margin}"
                                            Source="{x:Static local:InternalIcons.AngleRight}"
                                            Width="{DynamicResource mkm.cascadeselect.option.icon.size}"
                                            Height="{DynamicResource mkm.cascadeselect.option.icon.size}"
                                            Foreground="{DynamicResource mkm.cascadeselect.option.icon.color}" />
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" PopupAnimation="None"
                               Placement="Right" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <ContentControl Focusable="False" Template="{StaticResource mkm.CascadeSelect.Cadre}">
                                <local:GapStackPanel IsItemsHost="True" Gap="{DynamicResource mkm.cascadeselect.list.gap}"
                                                     KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </ContentControl>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Fleche" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Fond" Property="Background" Value="{DynamicResource mkm.cascadeselect.option.focus.background}" />
                            <Setter Property="Foreground" Value="{DynamicResource mkm.cascadeselect.option.focus.color}" />
                            <Setter TargetName="Fleche" Property="Foreground" Value="{DynamicResource mkm.cascadeselect.option.icon.focus.color}" />
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="Fond" Property="Background" Value="{DynamicResource mkm.cascadeselect.option.focus.background}" />
                            <Setter Property="Foreground" Value="{DynamicResource mkm.cascadeselect.option.focus.color}" />
                        </Trigger>
                        <Trigger Property="IsChosen" Value="True">
                            <Setter TargetName="Fond" Property="Background" Value="{DynamicResource mkm.cascadeselect.option.selected.background}" />
                            <Setter Property="Foreground" Value="{DynamicResource mkm.cascadeselect.option.selected.color}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChosen" Value="True" />
                                <Condition Property="IsHighlighted" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Fond" Property="Background" Value="{DynamicResource mkm.cascadeselect.option.selected.focus.background}" />
                            <Setter Property="Foreground" Value="{DynamicResource mkm.cascadeselect.option.selected.focus.color}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fond" Property="Opacity" Value="{DynamicResource mkm.disabled.opacity}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
