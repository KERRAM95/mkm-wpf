<!--
    Le style de Dock, sur le dock de mkm (styles/dock ; jetons de Nora en pixels, dans les deux thèmes) : posé au milieu
    d'un bord de son conteneur, un cadre translucide (un voile blanc à 10 %, bordé à 20 %), aux grands coins, 6 px de
    retrait ; ses applications de 36 px, 6 px de retrait chacune, aux coins du contenu ; au clavier, l'anneau du focus.
    Il se pose sur un fond (une image, un bureau) : seul sur du blanc, il ne se voit pas.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Mkm.Wpf.Controls">

    <Style TargetType="{x:Type local:DockItem}">
        <Setter Property="Padding" Value="{DynamicResource mkm.dock.item.padding}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:DockItem}">
                    <Grid>
                        <Border x:Name="Fond" Background="Transparent" Padding="{TemplateBinding Padding}"
                                CornerRadius="{DynamicResource mkm.dock.item.border.radius}">
                            <ContentPresenter Content="{TemplateBinding Icon}"
                                              Width="{DynamicResource mkm.dock.item.size}" Height="{DynamicResource mkm.dock.item.size}">
                                <ContentPresenter.Resources>
                                    <DataTemplate DataType="{x:Type Geometry}">
                                        <local:Icon Source="{Binding}" Width="{DynamicResource mkm.dock.item.size}"
                                                    Height="{DynamicResource mkm.dock.item.size}" Foreground="White" />
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type ImageSource}">
                                        <Image Source="{Binding}" Stretch="Uniform" />
                                    </DataTemplate>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <Border x:Name="Anneau" Visibility="Collapsed" IsHitTestVisible="False"
                                BorderThickness="{DynamicResource mkm.dock.item.ring.border.width}"
                                BorderBrush="{DynamicResource mkm.dock.item.focus.ring.color}"
                                CornerRadius="{DynamicResource mkm.dock.item.border.radius}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="local:FocusVisible.IsVisible" Value="True">
                            <Setter TargetName="Anneau" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fond" Property="Opacity" Value="{DynamicResource mkm.disabled.opacity}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:Dock}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Dock}">
                    <Border Background="{DynamicResource mkm.dock.background}" BorderBrush="{DynamicResource mkm.dock.border.color}"
                            BorderThickness="1" Padding="{DynamicResource mkm.dock.padding}"
                            CornerRadius="{DynamicResource mkm.dock.border.radius}">
                        <StackPanel x:Name="Elements" IsItemsHost="True" Orientation="Horizontal"
                                    KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Once" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Position" Value="Top">
                            <Setter Property="VerticalAlignment" Value="Top" />
                        </Trigger>
                        <Trigger Property="Position" Value="Left">
                            <Setter Property="HorizontalAlignment" Value="Left" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter TargetName="Elements" Property="Orientation" Value="Vertical" />
                        </Trigger>
                        <Trigger Property="Position" Value="Right">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter TargetName="Elements" Property="Orientation" Value="Vertical" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
