<!--
    Le style de MeterGroup, sur le groupe de jauges de mkm (styles/metergroup ; jetons de Nora en pixels, dans les deux
    thèmes) : une barre de 6 px, grise, aux coins du thème, les jauges côte à côte, chacune de sa couleur ; à 12 px, la
    légende : pour chaque jauge, un rond de 6 px de sa couleur (ou son icône), son libellé et sa part, à 6 px ; 12 px
    entre elles. En colonne, la barre verticale et la légende à côté, l'une sous l'autre à 6 px.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Mkm.Wpf.Controls">

    <DataTemplate x:Key="mkm.MeterGroup.Legende" DataType="{x:Type local:MeterItem}">
        <local:GapStackPanel Orientation="Horizontal" Gap="{DynamicResource mkm.metergroup.label.gap}">
            <Ellipse x:Name="Repere" Width="{DynamicResource mkm.metergroup.label.marker.size}"
                     Height="{DynamicResource mkm.metergroup.label.marker.size}" Fill="{Binding Color}" VerticalAlignment="Center" />
            <local:Icon x:Name="Icone" Visibility="Collapsed" Source="{Binding Icon}" Foreground="{Binding Color}" VerticalAlignment="Center"
                        Width="{DynamicResource mkm.metergroup.label.icon.size}" Height="{DynamicResource mkm.metergroup.label.icon.size}" />
            <TextBlock Text="{Binding Legend}" VerticalAlignment="Center" />
        </local:GapStackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding HasIcon}" Value="True">
                <Setter TargetName="Repere" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Icone" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="mkm.MeterGroup.LegendeEnLigne">
        <local:GapWrapPanel Gap="{DynamicResource mkm.metergroup.label.list.horizontal.gap}" />
    </ItemsPanelTemplate>

    <ItemsPanelTemplate x:Key="mkm.MeterGroup.LegendeEnColonne">
        <local:GapStackPanel Gap="{DynamicResource mkm.metergroup.label.list.vertical.gap}" />
    </ItemsPanelTemplate>

    <Style TargetType="{x:Type local:MeterGroup}">
        <Setter Property="ItemTemplate" Value="{StaticResource mkm.MeterGroup.Legende}" />
        <Setter Property="ItemsPanel" Value="{StaticResource mkm.MeterGroup.LegendeEnLigne}" />
        <Setter Property="FontFamily" Value="{DynamicResource mkm.font.family}" />
        <Setter Property="FontSize" Value="{DynamicResource mkm.font.size}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:MeterGroup}">
                    <DockPanel>
                        <Border x:Name="Barre" DockPanel.Dock="Top" Height="{DynamicResource mkm.metergroup.meters.size}"
                                Background="{DynamicResource mkm.metergroup.meters.background}"
                                CornerRadius="{DynamicResource mkm.metergroup.border.radius}"
                                Margin="{DynamicResource mkm.metergroup.meters.end.margin}">
                            <local:BarreDeJauges x:Name="PART_Meters" CornerRadius="{DynamicResource mkm.metergroup.border.radius}" />
                        </Border>
                        <ItemsPresenter />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="LabelPosition" Value="Start">
                            <Setter TargetName="Barre" Property="DockPanel.Dock" Value="Bottom" />
                            <Setter TargetName="Barre" Property="Margin" Value="{DynamicResource mkm.metergroup.meters.start.margin}" />
                        </Trigger>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter TargetName="Barre" Property="DockPanel.Dock" Value="Left" />
                            <Setter TargetName="Barre" Property="Height" Value="NaN" />
                            <Setter TargetName="Barre" Property="Width" Value="{DynamicResource mkm.metergroup.meters.size}" />
                            <Setter TargetName="Barre" Property="Margin" Value="{DynamicResource mkm.metergroup.meters.vertical.margin}" />
                            <Setter TargetName="PART_Meters" Property="Orientation" Value="Vertical" />
                        </Trigger>
                        <Trigger Property="LabelOrientation" Value="Vertical">
                            <Setter Property="ItemsPanel" Value="{StaticResource mkm.MeterGroup.LegendeEnColonne}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
