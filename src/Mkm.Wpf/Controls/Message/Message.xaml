<!--
    Le style de Message, sur le message de mkm (presets dashboard et ara, message) : des coins de 8 px, un bord d'un
    pixel ; 10 px sur 12 de retrait (6 sur 10 en petit, 12 sur 14 en grand) ; l'icône, le texte et la croix à 10 px
    les uns des autres, en haut : le texte sur des lignes de 18 px, l'icône un pixel plus bas, la croix de 24 px
    remontée de 3 px et poussée de 4 vers la droite ; la croix sans fond, d'un fond de la gravité au survol, coins de
    6 px, et au clavier l'anneau de la couleur de la gravité à un pixel autour. Les couleurs de chaque gravité et de
    chaque forme viennent de Message.Colorer.

    Écart avec mkm : le message se ferme sans transition.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Mkm.Wpf.Controls"
                    xmlns:loc="clr-namespace:Mkm.Wpf.Localization">

    <Style TargetType="{x:Type local:Message}">
        <Setter Property="FontFamily" Value="{DynamicResource mkm.font.family}" />
        <Setter Property="FontWeight" Value="{DynamicResource mkm.message.text.font.weight}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Message}">
                    <Grid>
                        <!-- L'ombre a sa bordure à elle : sur le message, elle ombrerait aussi le texte. -->
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource mkm.message.border.radius}"
                                Effect="{TemplateBinding Shadow}" />
                        <Border BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource mkm.message.border.radius}"
                                Padding="{TemplateBinding Padding}">
                            <DockPanel>
                                <local:Icon x:Name="Icone" DockPanel.Dock="Left" VerticalAlignment="Top"
                                            Margin="{DynamicResource mkm.message.icon.margin}"
                                            Width="{TemplateBinding IconSize}" Height="{TemplateBinding IconSize}"
                                            Foreground="{TemplateBinding IconForeground}"
                                            Source="{TemplateBinding Icon}" />
                                <Rectangle x:Name="EcartIcone" DockPanel.Dock="Left" Width="{DynamicResource mkm.message.content.gap}" />
                                <Button x:Name="PART_CloseButton" DockPanel.Dock="Right" VerticalAlignment="Top"
                                        Visibility="Collapsed" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                        Margin="{DynamicResource mkm.message.close.button.margin}"
                                        Width="{DynamicResource mkm.message.close.button.width}"
                                        Height="{DynamicResource mkm.message.close.button.height}"
                                        AutomationProperties.Name="{loc:T aria.close}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Grid>
                                                <Border x:Name="Fond" Background="Transparent"
                                                        CornerRadius="{DynamicResource mkm.message.close.button.border.radius}" />
                                                <Border x:Name="Anneau" Margin="-2" BorderThickness="1" Visibility="Collapsed"
                                                        CornerRadius="{DynamicResource mkm.message.close.button.border.radius}"
                                                        BorderBrush="{Binding FocusRingBrush, RelativeSource={RelativeSource AncestorType={x:Type local:Message}}}" />
                                                <local:Icon Source="{x:Static local:Icons.Close}"
                                                            Width="{Binding CloseIconSize, RelativeSource={RelativeSource AncestorType={x:Type local:Message}}}"
                                                            Height="{Binding CloseIconSize, RelativeSource={RelativeSource AncestorType={x:Type local:Message}}}" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Fond" Property="Background"
                                                            Value="{Binding CloseHoverBackground, RelativeSource={RelativeSource AncestorType={x:Type local:Message}}}" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="Anneau" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Rectangle x:Name="EcartCroix" DockPanel.Dock="Right" Visibility="Collapsed"
                                           Width="{DynamicResource mkm.message.content.gap}" />
                                <ContentPresenter VerticalAlignment="Top"
                                                  TextBlock.LineHeight="{DynamicResource mkm.message.text.line.height}"
                                                  TextBlock.LineStackingStrategy="BlockLineHeight">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </DockPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="Icone" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="EcartIcone" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Closable" Value="True">
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Visible" />
                            <Setter TargetName="EcartCroix" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource mkm.disabled.opacity}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
