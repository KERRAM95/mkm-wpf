<!--
    Le style d'InputNumber, sur la saisie d'un nombre de mkm (styles/inputnumber, jetons de Nora dans les deux
    thèmes) : le champ d'InputText ; ShowButtons, les boutons de 30 px, sans fond, la flèche grise, gris clair au
    survol, plus foncé enfoncés ; empilés (Stacked), l'un sur l'autre dans le champ, à l'intérieur de sa bordure, le
    texte s'arrêtant avant eux ; à l'horizontale (Horizontal), moins à gauche et plus à droite, bordés, le champ sans
    coins entre eux.

    Écart avec mkm : pas de disposition verticale (buttonLayout="vertical").
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Mkm.Wpf.Controls"
                    xmlns:loc="clr-namespace:Mkm.Wpf.Localization">

    <!-- Un bouton de la saisie : sans fond, la flèche grise ; il répète tant qu'on le tient (après 500 ms, toutes les 40). -->
    <Style x:Key="MkmInputNumberBouton" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Delay" Value="500" />
        <Setter Property="Interval" Value="40" />
        <Setter Property="Width" Value="{DynamicResource mkm.inputnumber.button.width}" />
        <Setter Property="Background" Value="{DynamicResource mkm.inputnumber.button.background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource mkm.inputnumber.button.border.color}" />
        <Setter Property="Foreground" Value="{DynamicResource mkm.inputnumber.button.color}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border x:Name="Fond" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding local:InputNumber.ButtonCornerRadius}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fond" Property="Background" Value="{DynamicResource mkm.inputnumber.button.hover.background}" />
                            <Setter TargetName="Fond" Property="BorderBrush" Value="{DynamicResource mkm.inputnumber.button.hover.border.color}" />
                            <Setter Property="Foreground" Value="{DynamicResource mkm.inputnumber.button.hover.color}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fond" Property="Background" Value="{DynamicResource mkm.inputnumber.button.active.background}" />
                            <Setter TargetName="Fond" Property="BorderBrush" Value="{DynamicResource mkm.inputnumber.button.active.border.color}" />
                            <Setter Property="Foreground" Value="{DynamicResource mkm.inputnumber.button.active.color}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:InputNumber}">
        <Setter Property="Height" Value="{DynamicResource mkm.inputtext.height}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:InputNumber}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <local:InputText x:Name="PART_TextBox" Grid.Column="0" Grid.ColumnSpan="3" Height="{TemplateBinding Height}"
                                         Placeholder="{TemplateBinding Placeholder}" Invalid="{TemplateBinding Invalid}"
                                         IsReadOnly="{TemplateBinding IsReadOnly}"
                                         AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}" />
                        <!-- Empilés : dans le champ, à l'intérieur de sa bordure. -->
                        <Grid x:Name="Empiles" Grid.Column="2" Margin="0,1,1,1" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <RepeatButton x:Name="PART_Increment" Grid.Row="0" Style="{StaticResource MkmInputNumberBouton}"
                                          local:InputNumber.ButtonCornerRadius="{DynamicResource mkm.inputnumber.stacked.up.border.radius}"
                                          AutomationProperties.Name="{loc:T aria.increment}">
                                <local:Icon Source="{x:Static local:InternalIcons.AngleUp}"
                                            Width="{DynamicResource mkm.inputnumber.button.icon.size}"
                                            Height="{DynamicResource mkm.inputnumber.button.icon.size}" />
                            </RepeatButton>
                            <RepeatButton x:Name="PART_Decrement" Grid.Row="1" Style="{StaticResource MkmInputNumberBouton}"
                                          local:InputNumber.ButtonCornerRadius="{DynamicResource mkm.inputnumber.stacked.down.border.radius}"
                                          AutomationProperties.Name="{loc:T aria.decrement}">
                                <local:Icon Source="{x:Static local:InternalIcons.AngleDown}"
                                            Width="{DynamicResource mkm.inputnumber.button.icon.size}"
                                            Height="{DynamicResource mkm.inputnumber.button.icon.size}" />
                            </RepeatButton>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ShowButtons" Value="True" />
                                <Condition Property="ButtonLayout" Value="Stacked" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Empiles" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_TextBox" Property="Padding" Value="{DynamicResource mkm.inputnumber.stacked.input.padding}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Empiles" Property="IsEnabled" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- À l'horizontale : moins à gauche, plus à droite, bordés, le champ sans coins entre eux. -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="ShowButtons" Value="True" />
                    <Condition Property="ButtonLayout" Value="Horizontal" />
                </MultiTrigger.Conditions>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type local:InputNumber}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <RepeatButton x:Name="PART_Decrement" Grid.Column="0" Style="{StaticResource MkmInputNumberBouton}"
                                              BorderThickness="1,1,0,1"
                                              local:InputNumber.ButtonCornerRadius="{DynamicResource mkm.inputnumber.horizontal.decrement.border.radius}"
                                              AutomationProperties.Name="{loc:T aria.decrement}">
                                    <local:Icon Source="{x:Static local:InternalIcons.AngleDown}"
                                                Width="{DynamicResource mkm.icon.size}" Height="{DynamicResource mkm.icon.size}" />
                                </RepeatButton>
                                <local:InputText x:Name="PART_TextBox" Grid.Column="1" CornerRadius="0" Height="{TemplateBinding Height}"
                                                 Placeholder="{TemplateBinding Placeholder}" Invalid="{TemplateBinding Invalid}"
                                                 IsReadOnly="{TemplateBinding IsReadOnly}"
                                                 AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}" />
                                <RepeatButton x:Name="PART_Increment" Grid.Column="2" Style="{StaticResource MkmInputNumberBouton}"
                                              BorderThickness="0,1,1,1"
                                              local:InputNumber.ButtonCornerRadius="{DynamicResource mkm.inputnumber.horizontal.increment.border.radius}"
                                              AutomationProperties.Name="{loc:T aria.increment}">
                                    <local:Icon Source="{x:Static local:InternalIcons.AngleUp}"
                                                Width="{DynamicResource mkm.icon.size}" Height="{DynamicResource mkm.icon.size}" />
                                </RepeatButton>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </MultiTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
