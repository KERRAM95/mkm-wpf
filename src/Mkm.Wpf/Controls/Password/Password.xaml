<!--
    Le style de Password, sur le champ de mot de passe de mkm (styles/password ; jetons de Nora en pixels, dans les deux
    thèmes) : le champ d'InputText (24 px, bordé de gris, la bordure au bleu du thème au clavier) ; l'œil à 7 px du bord
    droit, gris ; le temps de la saisie, sous le champ, un cadre ombré : la jauge de 9 px, grise, remplie au tiers en
    rouge (faible), aux deux tiers en jaune (moyen), en entier en vert (fort), et le texte de la force, à 6 px dessous.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Mkm.Wpf.Controls">

    <!-- Le champ masqué : celui d'InputText, pour un PasswordBox. -->
    <Style x:Key="mkm.Password.Saisie" TargetType="{x:Type PasswordBox}">
        <Setter Property="Height" Value="{DynamicResource mkm.inputtext.height}" />
        <Setter Property="Padding" Value="{DynamicResource mkm.inputtext.padding}" />
        <Setter Property="Background" Value="{DynamicResource mkm.inputtext.background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource mkm.inputtext.border.color}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource mkm.inputtext.color}" />
        <Setter Property="CaretBrush" Value="{DynamicResource mkm.inputtext.color}" />
        <Setter Property="FontFamily" Value="{DynamicResource mkm.font.family}" />
        <Setter Property="FontSize" Value="{DynamicResource mkm.inputtext.font.size}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type PasswordBox}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource mkm.inputtext.border.radius}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource mkm.inputtext.hover.border.color}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource mkm.inputtext.focus.border.color}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{DynamicResource mkm.inputtext.disabled.background}" />
                            <Setter Property="Foreground" Value="{DynamicResource mkm.inputtext.disabled.color}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource mkm.inputtext.disabled.border.color}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- L'œil : une icône, sans arrêt du clavier, comme mkm. -->
    <Style x:Key="mkm.Password.Oeil" TargetType="{x:Type Button}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource mkm.password.icon.color}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:Password}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Password}">
                    <Grid x:Name="Racine">
                        <PasswordBox x:Name="PART_PasswordBox" Style="{StaticResource mkm.Password.Saisie}" />
                        <local:InputText x:Name="PART_TextBox" Visibility="Collapsed" Invalid="{TemplateBinding Invalid}"
                                         Placeholder="{TemplateBinding Placeholder}" />
                        <!-- Le texte d'aide du champ masqué : son retrait, sa bordure, et les 2 px dont WPF retire le texte. -->
                        <TextBlock x:Name="Aide" Visibility="Collapsed" IsHitTestVisible="False" VerticalAlignment="Top"
                                   Margin="{DynamicResource mkm.password.placeholder.margin}" Padding="2,0,0,0"
                                   TextTrimming="CharacterEllipsis" Text="{TemplateBinding Placeholder}"
                                   FontFamily="{DynamicResource mkm.font.family}" FontSize="{DynamicResource mkm.inputtext.font.size}"
                                   Foreground="{DynamicResource mkm.inputtext.placeholder.color}" />
                        <Button x:Name="PART_Toggle" Style="{StaticResource mkm.Password.Oeil}" Visibility="Collapsed"
                                HorizontalAlignment="Right" Margin="{DynamicResource mkm.password.toggle.margin}">
                            <local:Icon x:Name="IconeOeil" Source="{x:Static local:InternalIcons.Eye}"
                                        Width="{DynamicResource mkm.icon.size}" Height="{DynamicResource mkm.icon.size}" />
                        </Button>
                        <Popup x:Name="Jauge" AllowsTransparency="True" Focusable="False" StaysOpen="True" Placement="Bottom"
                               PlacementTarget="{Binding ElementName=Racine}" PopupAnimation="None"
                               VerticalOffset="{DynamicResource mkm.anchor.gutter}" IsOpen="{TemplateBinding IsFeedbackOpen}">
                            <Grid Margin="{DynamicResource mkm.password.overlay.window.padding}"
                                  MinWidth="{Binding ActualWidth, ElementName=Racine}">
                                <Border Background="{DynamicResource mkm.password.overlay.background}"
                                        CornerRadius="{DynamicResource mkm.password.overlay.border.radius}"
                                        Effect="{DynamicResource mkm.password.overlay.shadow}" />
                                <Border Background="{DynamicResource mkm.password.overlay.background}" BorderThickness="1"
                                        BorderBrush="{DynamicResource mkm.password.overlay.border.color}"
                                        CornerRadius="{DynamicResource mkm.password.overlay.border.radius}"
                                        Padding="{DynamicResource mkm.password.overlay.padding}"
                                        TextElement.Foreground="{DynamicResource mkm.password.overlay.color}"
                                        TextElement.FontFamily="{DynamicResource mkm.font.family}"
                                        TextElement.FontSize="{DynamicResource mkm.font.size}">
                                    <local:GapStackPanel Gap="{DynamicResource mkm.password.content.gap}">
                                        <Grid Height="{DynamicResource mkm.password.meter.height}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.ColumnSpan="3" Background="{DynamicResource mkm.password.meter.background}"
                                                    CornerRadius="{DynamicResource mkm.password.meter.border.radius}" />
                                            <Border x:Name="Force" Visibility="Collapsed"
                                                    CornerRadius="{DynamicResource mkm.password.meter.border.radius}" />
                                        </Grid>
                                        <local:TexteAnnonce x:Name="TexteDeLaJauge" Text="{TemplateBinding StrengthText}"
                                                            AutomationProperties.LiveSetting="Polite" />
                                    </local:GapStackPanel>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasPassword" Value="False">
                            <Setter TargetName="Aide" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="ToggleMask" Value="True">
                            <Setter TargetName="PART_Toggle" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_PasswordBox" Property="Padding" Value="{DynamicResource mkm.password.input.toggle.padding}" />
                            <Setter TargetName="PART_TextBox" Property="Padding" Value="{DynamicResource mkm.password.input.toggle.padding}" />
                        </Trigger>
                        <Trigger Property="IsUnmasked" Value="True">
                            <Setter TargetName="PART_PasswordBox" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_TextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Aide" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="IconeOeil" Property="Source" Value="{x:Static local:InternalIcons.EyeSlash}" />
                        </Trigger>
                        <Trigger Property="Strength" Value="Weak">
                            <Setter TargetName="Force" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Force" Property="Background" Value="{DynamicResource mkm.password.strength.weak.background}" />
                        </Trigger>
                        <Trigger Property="Strength" Value="Medium">
                            <Setter TargetName="Force" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Force" Property="Grid.ColumnSpan" Value="2" />
                            <Setter TargetName="Force" Property="Background" Value="{DynamicResource mkm.password.strength.medium.background}" />
                        </Trigger>
                        <Trigger Property="Strength" Value="Strong">
                            <Setter TargetName="Force" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Force" Property="Grid.ColumnSpan" Value="3" />
                            <Setter TargetName="Force" Property="Background" Value="{DynamicResource mkm.password.strength.strong.background}" />
                        </Trigger>
                        <Trigger Property="Invalid" Value="True">
                            <Setter TargetName="PART_PasswordBox" Property="BorderBrush" Value="{DynamicResource mkm.inputtext.invalid.border.color}" />
                            <Setter TargetName="Aide" Property="Foreground" Value="{DynamicResource mkm.inputtext.invalid.placeholder.color}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Toggle" Property="IsEnabled" Value="False" />
                            <Setter TargetName="PART_Toggle" Property="Opacity" Value="{DynamicResource mkm.disabled.opacity}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
