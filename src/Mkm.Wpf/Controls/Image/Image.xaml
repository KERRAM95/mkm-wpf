<!--
    Le style d'Image, sur l'image de mkm (styles/image ; jetons de Nora en pixels pour Dashboard, preset ara) : l'image ;
    avec l'aperçu, au survol, le voile du thème et un œil de 18 px au milieu ; l'aperçu en grand, le voile, l'image et une
    barre claire en haut à droite (12 px du bord), ses boutons de 36 px.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Mkm.Wpf.Controls"
                    xmlns:loc="clr-namespace:Mkm.Wpf.Localization">

    <!-- Un bouton de la barre de l'aperçu. -->
    <Style x:Key="mkm.Image.Action" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="{DynamicResource mkm.image.action.size}" />
        <Setter Property="Height" Value="{DynamicResource mkm.image.action.size}" />
        <Setter Property="Foreground" Value="{DynamicResource mkm.image.action.color}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid>
                        <Border x:Name="Fond" Background="Transparent" CornerRadius="{DynamicResource mkm.image.action.border.radius}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Rectangle x:Name="Anneau" Visibility="Collapsed" IsHitTestVisible="False" RadiusX="3" RadiusY="3"
                                   Stroke="{DynamicResource mkm.image.action.focus.ring.color}"
                                   StrokeThickness="{DynamicResource mkm.image.action.focus.ring.width}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fond" Property="Background" Value="{DynamicResource mkm.image.action.hover.background}" />
                            <Setter Property="Foreground" Value="{DynamicResource mkm.image.action.hover.color}" />
                        </Trigger>
                        <Trigger Property="local:FocusVisible.IsVisible" Value="True">
                            <Setter TargetName="Anneau" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- L'œil de l'aperçu, sur toute l'image : le voile au survol et au clavier. -->
    <Style x:Key="mkm.Image.Apercu" TargetType="{x:Type Button}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Voile" Background="{DynamicResource mkm.image.preview.mask.background}" Opacity="0">
                        <local:Icon Source="{x:Static local:InternalIcons.Eye}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Width="{DynamicResource mkm.image.preview.icon.size}" Height="{DynamicResource mkm.image.preview.icon.size}"
                                    Foreground="{DynamicResource mkm.image.preview.mask.color}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Voile" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="local:FocusVisible.IsVisible" Value="True">
                            <Setter TargetName="Voile" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:Image}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Image}">
                    <Grid>
                        <Image Source="{TemplateBinding Source}" Stretch="{TemplateBinding Stretch}" />
                        <Button x:Name="PART_Preview" Visibility="Collapsed" Style="{StaticResource mkm.Image.Apercu}"
                                AutomationProperties.Name="{loc:T aria.preview}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Preview" Value="True">
                            <Setter TargetName="PART_Preview" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
