<!--
    Le style de ToggleButton, sur le bouton à bascule de 3DEXPERIENCE de mkm (presets dashboard et ara, togglebutton) :
    24 px de haut (4 + 14 + 4 et la bordure), 12 px de retrait de chaque côté, des coins de 4 px, un libellé de 12 px en
    graisse normale, une icône grise à 6 px de lui. Au repos blanc, bordé du gris du bouton secondaire ; survolé (relâché),
    gris clair ; enfoncé, le fond bleu pâle de la sélection, le texte et l'icône foncés, la bordure de la couleur
    principale ; refusé, la bordure d'erreur ; au clavier, l'anneau du focus, 1 px à 1 px du bord ; grisé, à moitié
    transparent. Petit : 2 px sur 8 ; grand : 6 px sur 16, un libellé de 14 px.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Mkm.Wpf.Controls">

    <Style TargetType="{x:Type local:ToggleButton}">
        <Setter Property="Height" Value="{DynamicResource mkm.togglebutton.height}" />
        <Setter Property="Padding" Value="{DynamicResource mkm.togglebutton.padding}" />
        <Setter Property="Background" Value="{DynamicResource mkm.togglebutton.background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource mkm.togglebutton.border.color}" />
        <Setter Property="Foreground" Value="{DynamicResource mkm.togglebutton.color}" />
        <Setter Property="FontFamily" Value="{DynamicResource mkm.font.family}" />
        <Setter Property="FontSize" Value="{DynamicResource mkm.togglebutton.font.size}" />
        <Setter Property="FontWeight" Value="{DynamicResource mkm.togglebutton.font.weight}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ToggleButton}">
                    <Grid>
                        <Border x:Name="Fond" BorderThickness="1"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                CornerRadius="{DynamicResource mkm.togglebutton.border.radius}"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                                <local:Icon x:Name="Icone" Source="{TemplateBinding CurrentIcon}" VerticalAlignment="Center"
                                            Width="{DynamicResource mkm.icon.size}" Height="{DynamicResource mkm.icon.size}"
                                            Foreground="{DynamicResource mkm.togglebutton.icon.color}" />
                                <Rectangle x:Name="Ecart" Width="{DynamicResource mkm.togglebutton.gap}" />
                                <ContentPresenter x:Name="Libelle" VerticalAlignment="Center" RecognizesAccessKey="True"
                                                  Content="{TemplateBinding CurrentLabel}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </StackPanel>
                        </Border>
                        <Rectangle x:Name="Anneau" Margin="-2" Visibility="Collapsed"
                                   RadiusX="{DynamicResource mkm.togglebutton.focus.ring.rounding}"
                                   RadiusY="{DynamicResource mkm.togglebutton.focus.ring.rounding}"
                                   Stroke="{DynamicResource mkm.togglebutton.focus.ring.color}"
                                   StrokeThickness="{DynamicResource mkm.togglebutton.focus.ring.width}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="CurrentIcon" Value="{x:Null}">
                            <Setter TargetName="Icone" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Ecart" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="CurrentLabel" Value="{x:Null}">
                            <Setter TargetName="Ecart" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Libelle" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource mkm.togglebutton.hover.background}" />
                            <Setter Property="Foreground" Value="{DynamicResource mkm.togglebutton.hover.color}" />
                            <Setter TargetName="Icone" Property="Foreground" Value="{DynamicResource mkm.togglebutton.icon.hover.color}" />
                        </MultiTrigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background" Value="{DynamicResource mkm.togglebutton.checked.background}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource mkm.togglebutton.checked.border.color}" />
                            <Setter Property="Foreground" Value="{DynamicResource mkm.togglebutton.checked.color}" />
                            <Setter TargetName="Icone" Property="Foreground" Value="{DynamicResource mkm.togglebutton.icon.checked.color}" />
                        </Trigger>
                        <Trigger Property="Invalid" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource mkm.togglebutton.invalid.border.color}" />
                        </Trigger>
                        <Trigger Property="IsFocusVisible" Value="True">
                            <Setter TargetName="Anneau" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Size" Value="Small">
                            <Setter Property="Height" Value="{DynamicResource mkm.togglebutton.sm.height}" />
                            <Setter Property="Padding" Value="{DynamicResource mkm.togglebutton.sm.padding}" />
                            <Setter Property="FontSize" Value="{DynamicResource mkm.togglebutton.sm.font.size}" />
                        </Trigger>
                        <Trigger Property="Size" Value="Large">
                            <Setter Property="Height" Value="{DynamicResource mkm.togglebutton.lg.height}" />
                            <Setter Property="Padding" Value="{DynamicResource mkm.togglebutton.lg.padding}" />
                            <Setter Property="FontSize" Value="{DynamicResource mkm.togglebutton.lg.font.size}" />
                        </Trigger>
                        <!-- Grisé, il garde ses couleurs, enfoncé compris, à moitié transparent (la feuille de mkm). -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter Property="Opacity" Value="{DynamicResource mkm.disabled.opacity}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
