<!--
    Le style d'InputText, sur le champ de 3DEXPERIENCE de mkm (presets dashboard et ara, inputtext) :
    24 px, bordé de gris, plus foncé au survol, la bordure au bleu du thème au focus, sans anneau ;
    grisé, un fond gris clair et le texte au gris de la bordure. Chaque valeur est un jeton du thème
    (mkm.inputtext.…), y compris ce que mkm écrit dans sa feuille (Tokens/<thème>.css.tokens).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Mkm.Wpf.Controls">

    <Style TargetType="{x:Type local:InputText}">
        <Setter Property="Height" Value="{DynamicResource mkm.inputtext.height}" />
        <Setter Property="Padding" Value="{DynamicResource mkm.inputtext.padding}" />
        <Setter Property="Background" Value="{DynamicResource mkm.inputtext.background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource mkm.inputtext.border.color}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource mkm.inputtext.color}" />
        <Setter Property="CaretBrush" Value="{DynamicResource mkm.inputtext.color}" />
        <Setter Property="FontFamily" Value="{DynamicResource mkm.font.family}" />
        <Setter Property="FontSize" Value="{DynamicResource mkm.inputtext.font.size}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="AllowDrop" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:InputText}">
                    <Border x:Name="Bord"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource mkm.inputtext.border.radius}">
                        <Grid>
                            <!-- Le texte d'aide, sur la ligne du texte saisi : le même retrait, et les 2 px dont
                                 WPF retire le texte. -->
                            <TextBlock x:Name="Aide" Margin="{TemplateBinding Padding}" Padding="2,0,0,0" VerticalAlignment="Top"
                                       IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource mkm.inputtext.placeholder.color}"
                                       Text="{TemplateBinding Placeholder}" />
                            <!-- Le TextBox pose lui-même son retrait (Padding) dans la zone de texte : la zone
                                 prend toute la place, et la ligne n'est pas rognée par le retrait du bas. -->
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Aide" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource mkm.inputtext.hover.border.color}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource mkm.inputtext.focus.border.color}" />
                        </Trigger>
                        <Trigger Property="Invalid" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource mkm.inputtext.invalid.border.color}" />
                            <Setter TargetName="Aide" Property="Foreground" Value="{DynamicResource mkm.inputtext.invalid.placeholder.color}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{DynamicResource mkm.inputtext.disabled.background}" />
                            <Setter Property="Foreground" Value="{DynamicResource mkm.inputtext.disabled.color}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource mkm.inputtext.disabled.border.color}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
