<!--
    Les styles de Splitter, SplitterPanel et SplitterGutter, sur le séparateur de mkm (styles/splitter ; jetons de Nora en
    pixels et preset dashboard, preset ara) : un cadre bordé du gris du contenu, coins de 4 px ; des gouttières gris clair
    de 4 px ; au milieu de chacune, une pilule de 24 px de long, invisible au repos, grise au survol, pendant qu'on la tire
    ou au clavier (avec l'anneau du focus).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Mkm.Wpf.Controls"
                    xmlns:loc="clr-namespace:Mkm.Wpf.Localization">

    <Style TargetType="{x:Type local:SplitterPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SplitterPanel}">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" ClipToBounds="True">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:SplitterGutter}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="AutomationProperties.Name" Value="{loc:T aria.resizePanel}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SplitterGutter}">
                    <Grid Background="{DynamicResource mkm.splitter.gutter.background}">
                        <Grid x:Name="Cadre" VerticalAlignment="Center" Height="{DynamicResource mkm.splitter.handle.size}">
                            <!-- L'anneau du focus, 1 px à 1 px de la pilule. -->
                            <Border x:Name="Anneau" Margin="-2" Visibility="Collapsed" CornerRadius="3"
                                    BorderThickness="{DynamicResource mkm.splitter.handle.focus.ring.border.width}"
                                    BorderBrush="{DynamicResource mkm.splitter.handle.focus.ring.color}" />
                            <local:Pill x:Name="Poignee" Background="{DynamicResource mkm.splitter.handle.background}" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Un séparateur vertical a des gouttières couchées : la pilule aussi. -->
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter TargetName="Cadre" Property="Height" Value="NaN" />
                            <Setter TargetName="Cadre" Property="VerticalAlignment" Value="Stretch" />
                            <Setter TargetName="Cadre" Property="HorizontalAlignment" Value="Center" />
                            <Setter TargetName="Cadre" Property="Width" Value="{DynamicResource mkm.splitter.handle.size}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Poignee" Property="Background" Value="{DynamicResource mkm.splitter.handle.hover.background}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Poignee" Property="Background" Value="{DynamicResource mkm.splitter.handle.hover.background}" />
                        </Trigger>
                        <Trigger Property="IsFocusVisible" Value="True">
                            <Setter TargetName="Poignee" Property="Background" Value="{DynamicResource mkm.splitter.handle.hover.background}" />
                            <Setter TargetName="Anneau" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:Splitter}">
        <Setter Property="Background" Value="{DynamicResource mkm.splitter.background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource mkm.splitter.border.color}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource mkm.splitter.color}" />
        <Setter Property="FontFamily" Value="{DynamicResource mkm.font.family}" />
        <Setter Property="FontSize" Value="{DynamicResource mkm.font.size}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Splitter}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource mkm.border.radius.md}">
                        <local:SplitterLayout x:Name="PART_Layout" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
