<!--
    Le style de Menubar, sur la barre de menus de mkm (styles/menubar ; jetons de Nora en pixels, dans les deux thèmes) :
    le fond et la bordure du contenu, aux coins du thème, 6 px sur 9 de retrait ; ses éléments à 6 px l'un de l'autre,
    5 px sur 8 de retrait, l'icône grise puis le libellé, le chevron d'un sous-menu ; survolés ou ouverts, le fond des
    éléments de navigation. Les sous-menus sont le menu de mkm (Themes/Natifs.xaml), à 2 px sous la barre.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Mkm.Wpf.Controls">

    <!-- Un élément de la barre : son icône, son libellé, le chevron de son sous-menu ; le sous-menu dessous. -->
    <Style x:Key="mkm.Menubar.Element" TargetType="{x:Type MenuItem}">
        <Setter Property="Foreground" Value="{DynamicResource mkm.menubar.item.color}" />
        <Setter Property="Padding" Value="{DynamicResource mkm.menubar.item.padding}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Grid>
                        <Border x:Name="Fond" Background="Transparent" Padding="{TemplateBinding Padding}"
                                CornerRadius="{DynamicResource mkm.menubar.base.item.border.radius}">
                            <local:GapStackPanel Orientation="Horizontal" Gap="{DynamicResource mkm.menubar.item.gap}">
                                <ContentPresenter x:Name="Icone" Content="{TemplateBinding Icon}" VerticalAlignment="Center"
                                                  TextElement.Foreground="{DynamicResource mkm.menubar.item.icon.color}">
                                    <ContentPresenter.Resources>
                                        <DataTemplate DataType="{x:Type Geometry}">
                                            <local:Icon Source="{Binding}" Width="{DynamicResource mkm.icon.size}" Height="{DynamicResource mkm.icon.size}" />
                                        </DataTemplate>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                                <local:Icon x:Name="Fleche" Visibility="Collapsed" VerticalAlignment="Center"
                                            Source="{x:Static local:InternalIcons.AngleDown}"
                                            Width="{DynamicResource mkm.menubar.submenu.icon.size}"
                                            Height="{DynamicResource mkm.menubar.submenu.icon.size}"
                                            Foreground="{DynamicResource mkm.menubar.submenu.icon.color}" />
                            </local:GapStackPanel>
                        </Border>
                        <Border x:Name="Anneau" Visibility="Collapsed" BorderThickness="2"
                                BorderBrush="{DynamicResource mkm.contextmenu.item.keyboard.border.color}" />
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" PopupAnimation="None" Placement="Bottom"
                               VerticalOffset="{DynamicResource mkm.anchor.gutter}"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Grid Grid.IsSharedSizeScope="True" Margin="{DynamicResource mkm.contextmenu.window.padding}">
                                <Border Background="{DynamicResource mkm.contextmenu.background}" Effect="{DynamicResource mkm.contextmenu.shadow}" />
                                <Border BorderThickness="1" BorderBrush="{DynamicResource mkm.contextmenu.border.color}"
                                        Background="{DynamicResource mkm.contextmenu.background}"
                                        MinWidth="{DynamicResource mkm.menubar.submenu.min.width}"
                                        Padding="{DynamicResource mkm.contextmenu.list.padding}">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="Icone" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="Fleche" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Fond" Property="Background" Value="{DynamicResource mkm.menubar.item.focus.background}" />
                            <Setter Property="Foreground" Value="{DynamicResource mkm.menubar.item.focus.color}" />
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="Fond" Property="Background" Value="{DynamicResource mkm.menubar.item.active.background}" />
                            <Setter Property="Foreground" Value="{DynamicResource mkm.menubar.item.active.color}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsKeyboardFocused" Value="True" />
                                <Condition Property="IsMouseOver" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Anneau" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fond" Property="Opacity" Value="{DynamicResource mkm.disabled.opacity}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:Menubar}">
        <Setter Property="Background" Value="{DynamicResource mkm.menubar.background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource mkm.menubar.border.color}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource mkm.menubar.color}" />
        <Setter Property="Padding" Value="{DynamicResource mkm.menubar.padding}" />
        <Setter Property="FontFamily" Value="{DynamicResource mkm.font.family}" />
        <Setter Property="FontSize" Value="{DynamicResource mkm.font.size}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource mkm.Menubar.Element}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Menubar}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                            CornerRadius="{DynamicResource mkm.menubar.border.radius}">
                        <DockPanel>
                            <ContentPresenter x:Name="Debut" DockPanel.Dock="Left" VerticalAlignment="Center"
                                              Margin="{DynamicResource mkm.menubar.start.margin}" Content="{TemplateBinding Start}" />
                            <ContentPresenter x:Name="Fin" DockPanel.Dock="Right" VerticalAlignment="Center" Content="{TemplateBinding End}" />
                            <local:GapStackPanel IsItemsHost="True" Orientation="Horizontal" Gap="{DynamicResource mkm.menubar.gap}" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Start" Value="{x:Null}">
                            <Setter TargetName="Debut" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="End" Value="{x:Null}">
                            <Setter TargetName="Fin" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
