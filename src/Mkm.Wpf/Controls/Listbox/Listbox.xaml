<!--
    Le style de Listbox, sur la liste de mkm (styles/listbox ; jetons de Nora en pixels pour Dashboard, preset ara) :
    un cadre de champ (fond, bordure d'un pixel, coins du thème), 2 px en haut et en bas de la liste ; une option,
    5 px sur 8 de retrait, grisée au survol et au clavier, choisie sur le fond du thème (highlight), plus foncé au
    clavier ; une coche devant l'option choisie (checkmark), une option sur deux grisée (striped) ; un en-tête de groupe
    en gras ; un champ de filtre en tête, sa loupe à droite ; une liste vide dit son message. Grisée, la liste prend
    le fond et le texte d'un champ désactivé.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Mkm.Wpf.Controls"
                    xmlns:loc="clr-namespace:Mkm.Wpf.Localization">

    <!-- L'en-tête d'un groupe. -->
    <DataTemplate x:Key="mkm.Listbox.Group">
        <TextBlock Text="{Binding Name}" Padding="{DynamicResource mkm.listbox.option.group.padding}"
                   Background="{DynamicResource mkm.listbox.option.group.background}"
                   Foreground="{DynamicResource mkm.listbox.option.group.color}"
                   FontWeight="{DynamicResource mkm.listbox.option.group.font.weight}" />
    </DataTemplate>

    <!-- Une option. -->
    <Style x:Key="mkm.Listbox.Option" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Padding" Value="{DynamicResource mkm.listbox.option.padding}" />
        <Setter Property="Foreground" Value="{DynamicResource mkm.listbox.option.color}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="Fond" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                            CornerRadius="{DynamicResource mkm.listbox.option.border.radius}">
                        <DockPanel>
                            <local:Icon x:Name="Coche" DockPanel.Dock="Left" Visibility="Collapsed" VerticalAlignment="Center"
                                        Source="{x:Static local:InternalIcons.Check}"
                                        Width="{DynamicResource mkm.icon.size}" Height="{DynamicResource mkm.icon.size}"
                                        Margin="{DynamicResource mkm.listbox.checkmark.margin}"
                                        Foreground="{DynamicResource mkm.listbox.checkmark.color}" />
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Checkmark, RelativeSource={RelativeSource AncestorType={x:Type local:Listbox}}}" Value="True">
                            <Setter TargetName="Coche" Property="Visibility" Value="Hidden" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Checkmark, RelativeSource={RelativeSource AncestorType={x:Type local:Listbox}}}" Value="True" />
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Coche" Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Striped, RelativeSource={RelativeSource AncestorType={x:Type local:Listbox}}}" Value="True" />
                                <Condition Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource Self}}" Value="1" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource mkm.listbox.option.striped.background}" />
                        </MultiDataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource mkm.listbox.option.focus.background}" />
                            <Setter Property="Foreground" Value="{DynamicResource mkm.listbox.option.focus.color}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="Background" Value="{DynamicResource mkm.listbox.option.focus.background}" />
                            <Setter Property="Foreground" Value="{DynamicResource mkm.listbox.option.focus.color}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource mkm.listbox.option.selected.background}" />
                            <Setter Property="Foreground" Value="{DynamicResource mkm.listbox.option.selected.color}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsKeyboardFocused" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="{DynamicResource mkm.listbox.option.selected.focus.background}" />
                            <Setter Property="Foreground" Value="{DynamicResource mkm.listbox.option.selected.focus.color}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fond" Property="Opacity" Value="{DynamicResource mkm.disabled.opacity}" />
                        </Trigger>
                        <!-- Toute la liste grisée : ses options gardent leur netteté, au gris d'un champ désactivé. -->
                        <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType={x:Type local:Listbox}}}" Value="False">
                            <Setter TargetName="Fond" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource mkm.listbox.disabled.color}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:Listbox}">
        <Setter Property="Background" Value="{DynamicResource mkm.listbox.background}" />
        <Setter Property="Foreground" Value="{DynamicResource mkm.listbox.color}" />
        <Setter Property="BorderBrush" Value="{DynamicResource mkm.listbox.border.color}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource mkm.listbox.list.padding}" />
        <Setter Property="FontFamily" Value="{DynamicResource mkm.font.family}" />
        <Setter Property="FontSize" Value="{DynamicResource mkm.font.size}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource mkm.Listbox.Option}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:Listbox}">
                    <Border x:Name="Bord" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource mkm.listbox.border.radius}">
                        <DockPanel>
                            <Border x:Name="EnTete" DockPanel.Dock="Top" Visibility="Collapsed"
                                    Padding="{DynamicResource mkm.listbox.list.header.padding}">
                                <local:IconField Icon="{x:Static local:InternalIcons.Search}" IconPosition="Right">
                                    <local:InputText x:Name="PART_Filter" Placeholder="{TemplateBinding FilterPlaceholder}"
                                                     AutomationProperties.Name="{loc:T aria.filter}"
                                                     Text="{Binding FilterText, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </local:IconField>
                            </Border>
                            <Grid>
                                <ScrollViewer x:Name="Defilement" Focusable="False" Padding="{TemplateBinding Padding}"
                                              CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                              HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                              VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                                    <ItemsPresenter />
                                </ScrollViewer>
                                <!-- Une liste vide : son message, celui de la langue sinon. -->
                                <TextBlock x:Name="Vide" Visibility="Collapsed" Margin="{DynamicResource mkm.listbox.empty.message.padding}"
                                           Text="{loc:T locale.emptyMessage}" />
                                <TextBlock x:Name="VideFiltre" Visibility="Collapsed" Margin="{DynamicResource mkm.listbox.empty.message.padding}"
                                           Text="{loc:T locale.emptyFilterMessage}" />
                                <TextBlock x:Name="VidePropre" Visibility="Collapsed" Margin="{DynamicResource mkm.listbox.empty.message.padding}"
                                           Text="{TemplateBinding EmptyMessage}" />
                            </Grid>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Filter" Value="True">
                            <Setter TargetName="EnTete" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Striped" Value="True">
                            <Setter Property="AlternationCount" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEmpty" Value="True">
                            <Setter TargetName="Vide" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEmpty" Value="True" />
                                <Condition Property="Filter" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Vide" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="VideFiltre" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsEmpty, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding FilterText, RelativeSource={RelativeSource Self}}" Value="" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="VideFiltre" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Vide" Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsEmpty, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding HasEmptyMessage, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Vide" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="VideFiltre" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="VidePropre" Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                        <Trigger Property="Invalid" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource mkm.listbox.invalid.border.color}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{DynamicResource mkm.listbox.disabled.background}" />
                            <Setter Property="Foreground" Value="{DynamicResource mkm.listbox.disabled.color}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
