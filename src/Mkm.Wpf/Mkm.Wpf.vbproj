<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <UseWPF>true</UseWPF>
    <!-- Vide : chaque fichier ecrit son espace de noms en entier (CLAUDE.md, « Conventions VB »). -->
    <RootNamespace></RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Bibliotheque de composants WPF neutre : controles, themes et commandes reutilisables.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Les jetons des thèmes, importés de mkm par outils/themes/importer-mkm.mjs. -->
    <EmbeddedResource Include="Theming\Tokens\*.tokens" LogicalName="Mkm.Wpf.Tokens.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
