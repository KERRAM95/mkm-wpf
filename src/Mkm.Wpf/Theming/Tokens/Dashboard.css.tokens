# Ce que la feuille CSS du preset de mkm (Dashboard, « css ») dit sans jeton, écrit en jetons pour mkm-wpf.
# Écrit à la main d'après ui-kit, packages/themes/src/presets/dashboard/(inputtext|select|button|checkbox|tabs|message|toast|dialog)/index.ts : à reprendre
# quand ces feuilles changent. Lu après Dashboard.tokens (outils/themes/importer-mkm.mjs ne touche pas ce fichier).
# Une marge, un retrait ou des coins à plusieurs valeurs s'écrivent dans l'ordre de CSS : haut, droite, bas, gauche
# (« 0 0 0 8px » : 8 px à gauche), comme les jetons importés.

# inputtext : 24 px de haut, le retrait du bas d'un pixel de plus que celui du haut.
inputtext.height = 24px
# Le retrait du bas : 5 px chez mkm, 4 dans mkm-wpf. Le champ garde 24 px et son texte la même place, mais le
# TextBox de WPF rogne ce qui dépasse sa zone de texte (13 px pour une ligne de 14 : la queue d'un g, d'un p),
# là où CSS laisse déborder.
inputtext.padding = 4px 6px 4px 6px
inputtext.disabled.border.color = {dspalette.pale.gray}

# select : le champ (bord gauche arrondi) et son bouton de 22 px, chacun bordé, de 24 px de haut.
select.height = 24px
select.label.padding = 4px 0 5px 6px
select.label.border.radius = {select.border.radius} 0 0 {select.border.radius}
select.dropdown.background = {surface.100}
select.dropdown.hover.background = {surface.200}
select.dropdown.focus.background = {dsblue.100}
select.dropdown.focus.color = {dsblue.600}
select.dropdown.pressed.background = {surface.300}
select.dropdown.pressed.border.color = {surface.700}
select.dropdown.icon.width = 10px
select.disabled.border.color = {dspalette.pale.gray}
# La liste : 4 px sous le champ, ses choix de 22 px séparés d'un trait, le choix actuel cerné.
select.overlay.gutter = 4px
select.list.background = {surface.50}
select.option.height = 22px
select.option.border.color = {surface.50}
select.option.selected.border.color = {dspalette.mist.gray}

# button (presets/dashboard/button) : 24 px de haut (4 + 14 + 4 et la bordure), 65 px de large au moins avec un
# libellé ; au clavier, le principal prend le bleu foncé de 3DX, enfoncé un bleu plus sombre ; en texte et d'icône seule, le
# bouton « lite » : sans fond ni bordure, gris, du gris du texte au survol, bleu clair enfoncé.
button.height = 24px
button.min.width = 65px
button.padding = {button.padding.y} {button.padding.x}
button.primary.focus.background = {dsblue.500}
button.primary.focus.border.color = {dsblue.600}
button.primary.pressed.background = {dsblue.600}
button.primary.pressed.border.color = {dspalette.deep.steel}
button.icon.color = {surface.500}
button.icon.hover.color = {text.color}
button.icon.active.color = {dspalette.pale.blue}

# checkbox (presets/dashboard/checkbox) : survolée ou au clavier, la case décochée prend un gris plus sombre ;
# enfoncée, elle fonce d'un pas de plus. Le libellé fait partie de la case (6 px entre eux, mesure de mkm-wpf :
# la case de mkm n'a pas de libellé à elle).
checkbox.hover.background = {surface.200}
checkbox.pressed.background = {surface.300}
checkbox.pressed.border.color = {surface.700}
checkbox.checked.pressed.background = {dsblue.600}
checkbox.checked.pressed.border.color = {dspalette.deep.steel}
checkbox.label.gap = 6px

# tabs (presets/dashboard/tabs) : le groupe d'onglets au milieu d'une barre de 26 px, 2 px sous son haut, dans un
# cadre de 25 px que la barre coupe en bas ; chaque onglet de 23 px, 65 px de large au moins, filet blanc en haut et
# gris en bas ; le premier et le dernier ont leur filet blanc de côté et leurs coins de 2 px.
tabs.bar.height = 26px
tabs.frame.height = 25px
tabs.frame.margin = 2px 0 0 0
tabs.frame.border.color = {surface.400}
tabs.frame.border.radius = 2px
tabs.frame.background = {surface.200}
tabs.frame.shadow = 0 0 4px color-mix(in srgb, {surface.700} 50%, transparent)
tabs.tab.height = 23px
tabs.tab.min.width = 65px
tabs.tab.top.border.color = #ffffff
tabs.tab.bottom.border.color = {surface.500}
tabs.tab.edge.border.radius = 2px
tabs.tab.first.border.radius = 2px 0 0 2px
tabs.tab.last.border.radius = 0 2px 2px 0
tabs.tab.line.height = 22px
# le style « strip », celui des facettes d'un panneau : des onglets sans cadre de 26 px, soulignés de 3 px, au
# milieu d'une barre dont le dernier pixel est un trait gris qu'ils recouvrent ; icône de 16 px.
tabs.strip.height = 26px
tabs.strip.line.color = {surface.300}
tabs.strip.tab.margin = 0 5px
tabs.strip.tab.padding = 1px 8px 0
tabs.strip.tab.bar.height = 3px
tabs.strip.tab.color = {surface.500}
tabs.strip.tab.hover.bar.color = {surface.500}
tabs.strip.tab.active.color = {dsblue.500}
tabs.tab.icon.size = 16px

# message (presets/dashboard/message) : le texte sur des lignes de 18 px ; l'icône (16 px) et la croix (24 px) centrées
# sur la première ligne ; l'icône de la couleur de la gravité assombrie (80 % et du noir), lisible à plus de 3:1.
message.text.line.height = 18px
message.icon.margin = 1px 0
message.close.button.margin = -3px -4px -3px 0
message.info.icon.color = color-mix(in srgb, {status.info} 80%, #000)
message.success.icon.color = color-mix(in srgb, {status.success} 80%, #000)
message.warn.icon.color = color-mix(in srgb, {status.warn} 80%, #000)
message.error.icon.color = color-mix(in srgb, {status.danger} 80%, #000)
message.secondary.icon.color = {message.secondary.color}
message.contrast.icon.color = {message.contrast.color}

# toast (presets/dashboard/toast) : en haut à droite, à 20 px des bords (le style en ligne de mkm), des cartes de 250 px
# à 7 px les unes des autres (les marges de mkm, fondues entre deux cartes), 200 px de haut au plus ; une bande de
# 5 px de la couleur de la gravité à gauche ; l'icône à 13 px du bord et 10 du haut ; le titre et le message à 3 px
# l'un de l'autre, sur la hauteur de ligne de 3DX (1,42857) ; la croix à 16 px du haut et 14 de la droite, grise,
# plus foncée au survol, bleue enfoncée ; une carte en relief à son apparition et sous le pointeur.
toast.margin = 20px
toast.list.padding = 0 0 7px 0
toast.message.width = 250px
toast.message.max.height = 200px
toast.message.margin = 7px 7px 0 7px
toast.band.width = 5px
toast.icon.margin = 10px 0 0 13px
toast.summary.margin = 3px 18px 3px 0
toast.summary.line.height = 20px
toast.detail.margin = 3px 0
toast.detail.alone.margin = 3px 18px 3px 0
toast.detail.line.height = 17.142857px
toast.close.button.margin = 16px 14px 0 0
toast.close.icon.color = {surface.500}
toast.close.icon.hover.color = #4d4d4d
toast.close.icon.active.color = {dsblue.600}
toast.highlighted.shadow = 0 1px 15px rgba(0, 0, 0, 0.39)
toast.highlighted.inset.color = rgba(255, 255, 255, 0.43)

# dialog (presets/dashboard/dialog) : la fenêtre n'a ni fond ni bord à elle ; la barre de titre de 26 px a les siens (le
# bas plus clair) et ses coins du haut, le titre en gras, coupé et fondu au blanc sur ses 12 derniers pixels ; la
# croix, un carré de 24 px sans fond, son dessin de 12 px, gris, foncé au survol ; le contenu a ses côtés (et le bas
# sans pied) ; le pied, le cadre blanc et dedans le bloc gris sous son trait, les boutons à droite, 10 px entre eux ;
# la poignée, une équerre de deux traits de 2 px au coin. dialog.window.padding est une mesure de mkm-wpf : la place
# de l'ombre autour de la fenêtre (sans calque à elle, une fenêtre WPF dessine son ombre dans ses bords).
dialog.window.padding = 10px 15px 20px 15px
dialog.header.height = 26px
dialog.header.bottom.border.color = {surface.200}
dialog.header.border.radius = {dialog.border.radius} {dialog.border.radius} 0 0
dialog.bottom.border.radius = 0 0 {dialog.border.radius} {dialog.border.radius}
dialog.title.padding = 0 8px
dialog.title.fade.width = 12px
dialog.close.button.size = 24px
dialog.close.icon.size = 12px
dialog.close.icon.color = {surface.500}
dialog.close.icon.hover.color = {surface.700}
dialog.content.line.height = 17.142857px
dialog.footer.background = {surface.100}
dialog.footer.border.color = {surface.200}
dialog.footer.button.margin = 0 0 0 10px
dialog.resize.handle.box.size = 20px
dialog.resize.handle.margin = 0 1px 1px 0
dialog.resize.handle.mark.size = 6px
dialog.resize.handle.mark.margin = 10px 0 0 10px

# tooltip (styles/tooltip, preset dashboard/tooltip) : à droite de son élément, la flèche dans l'écart (gutter), de
# 3 px sur 6 vers lui. tooltip.window.padding est une mesure de mkm-wpf : la place de l'ombre (0 1px 2px) autour.
tooltip.arrow.width = {tooltip.gutter}
tooltip.arrow.height = 6px
tooltip.window.padding = 1px 2px 3px 0

# progressspinner (styles/progressspinner) : 100 px de côté par défaut.
progressspinner.size = 100px

# textarea (styles/textarea) : le retrait des champs de mkm (padding-block, padding-inline) ; au focus, l'anneau de
# 1 px à -1 px recouvre la bordure : seule la couleur de la bordure change.
textarea.padding = {textarea.padding.y} {textarea.padding.x}

# confirmdialog (styles/confirmdialog) : l'icône et la question à 12 px l'une de l'autre (gap du contenu).
confirmdialog.icon.margin = 0 {confirmdialog.content.gap} 0 0

# confirmdialog (styles/confirmdialog) : l'icône et la question à 12 px l'une de l'autre (gap du contenu).
confirmdialog.icon.margin = 0 {confirmdialog.content.gap} 0 0

# datepicker (styles/datepicker) : le champ d'InputText, ses coins de droite carrés, accolé au bouton du calendrier
# bordé sauf à gauche ; le panneau 2 px sous le champ (absolutePosition de PrimeVue) ; chaque jour un cercle (50 %
# de 24 px) ; les flèches de l'en-tête, des boutons ronds d'icône seule. datepicker.panel.window.padding est une
# mesure de mkm-wpf : la place de l'ombre (0 1px 2px) autour du panneau.
datepicker.input.border.radius = {inputtext.border.radius} 0 0 {inputtext.border.radius}
datepicker.dropdown.radius = 0 {datepicker.dropdown.border.radius} {datepicker.dropdown.border.radius} 0
datepicker.overlay.gutter = 2px
datepicker.date.border.radius = 12px
datepicker.nav.button.size = {button.icon.only.width}
datepicker.nav.button.radius = 12px
datepicker.panel.window.padding = 0 2px 3px 2px

# propertypanel (styles/propertypanel) : 2 px entre les lignes (gap de la liste) ; la marque d'une propriété obligatoire
# 4 px après le libellé ; l'icône de la valeur 6 px avant elle.
propertypanel.row.margin = 0 0 {propertypanel.list.gap} 0
propertypanel.required.margin = 0 0 0 {propertypanel.required.gap}
propertypanel.value.icon.margin = 0 {propertypanel.value.icon.gap} 0 0

# tree (styles/tree) : 2 px sous chaque nœud (gap), les enfants décalés de 12 px (indent) ; la flèche dans un rond
# (50 % de 21 px), son dessin à la taille des icônes.
tree.node.margin = 0 0 {tree.gap} 0
tree.children.margin = 0 0 0 {tree.indent}
tree.node.toggle.button.radius = 10.5px
tree.node.toggle.icon.size = {icon.size}

# contextmenu (presets/dashboard/contextmenu) : l'icône de 16 px et 14 px d'écart (le libellé à 44 px, la colonne d'icône) ;
# le raccourci à 14 px du libellé, en 11 px ; un élément grisé, son gris de 3DX, son icône plus pâle ; au clavier,
# cerné de 2 px de gris ; un sous-menu collé à son élément (le bord de l'un sur celui de l'autre).
# contextmenu.window.padding est une mesure de mkm-wpf : la place de l'ombre (0 1px 2px) autour du menu.
contextmenu.item.icon.margin = 0 {contextmenu.item.gap} 0 0
contextmenu.item.shortcut.margin = 0 0 0 {contextmenu.item.gap}
contextmenu.item.shortcut.font.size = 11px
contextmenu.item.disabled.color = {dspalette.ash.gray}
contextmenu.item.icon.disabled.color = {dspalette.fog.gray}
contextmenu.item.keyboard.border.color = {surface.500}
contextmenu.submenu.offset = -1px
contextmenu.window.padding = 0 2px 3px 2px
# l'info-bulle au-dessus d'une commande de l'ActionBar (position « top ») : sa flèche dessous ; la place de l'ombre.
tooltip.top.window.padding = 1px 2px 0 2px

# idcard (styles/idcard, preset dashboard/idcard) : les écarts de la feuille (gap, margin-inline-start) en marges ; les
# détails à 12 px les uns des autres et 2 px entre leurs lignes (details.gap). idcard.thumbnail.icon.size est une
# mesure de mkm-wpf : une géométrie donnée pour vignette, dessinée à 40 px dans la tuile de 72.
idcard.thumbnail.margin = 0 {idcard.header.gap} 0 0
idcard.thumbnail.icon.size = 40px
idcard.revision.margin = 0 0 0 {idcard.revision.gap}
idcard.actions.margin = 0 0 0 {idcard.actions.gap}
idcard.actions.button.margin = 0 0 0 {idcard.actions.gap}
idcard.details.margin = {idcard.body.gap} 0 0 0
idcard.details.item.margin = 0 12px 2px 0
idcard.type.icon.margin = 0 {idcard.type.gap} 0 0

# togglebutton et selectbutton (presets dashboard/togglebutton, selectbutton) : 24 px de haut (4 + 14 + 4 et la bordure) ;
# dans un groupe, le bouton enfoncé recouvre de la couleur principale la bordure qu'il partage avec son voisin de
# gauche ; grisé, à moitié transparent.
togglebutton.height = 24px
togglebutton.first.border.radius = {selectbutton.border.radius} 0 0 {selectbutton.border.radius}
togglebutton.last.border.radius = 0 {selectbutton.border.radius} {selectbutton.border.radius} 0

# inputnumber (styles/inputnumber, jetons de Nora) : les boutons empilés dans le champ, à l'intérieur de sa bordure,
# coins de 1 px de moins ; le texte s'arrête avant eux (la largeur des boutons et le retrait des champs : 30 + 7 px) ;
# à l'horizontale, moins à gauche et plus à droite, bordés, le champ sans coins. inputnumber.button.icon.size est une
# mesure de mkm-wpf : la flèche tient dans la moitié d'un champ de 24 px.
inputnumber.stacked.input.padding = 4px 37px 4px 6px
inputnumber.stacked.up.border.radius = 0 1px 0 0
inputnumber.stacked.down.border.radius = 0 0 1px 0
inputnumber.button.icon.size = 10px
inputnumber.horizontal.decrement.border.radius = {inputnumber.button.border.radius} 0 0 {inputnumber.button.border.radius}
inputnumber.horizontal.increment.border.radius = 0 {inputnumber.button.border.radius} {inputnumber.button.border.radius} 0

# datatable (preset dashboard/datatable) : la hauteur des lignes, que PrimeVue ne porte pas en jeton (extend de mkm) ;
# l'icône de tri 6 px après le titre (gap des cellules de l'en-tête).
datatable.row.height = {datatable.extend.row.height}
datatable.sort.icon.margin = 0 0 0 {datatable.header.cell.gap}

# radiobutton (styles/radiobutton ; jetons de Nora en pixels) : le libellé à 6 px du rond, comme celui de la case
# (mesure de mkm-wpf : le bouton radio de mkm n'a pas de libellé à lui).
radiobutton.label.gap = 6px

# togglebutton seul (preset dashboard/togglebutton) : petit, 2 + 14 + 2 et la bordure ; grand, 6 + 16 (le texte de 14 px) + 6
# et la bordure. L'anneau du focus (1 px à 1 px du bord) arrondi de 4 + 1 + 1 px.
togglebutton.sm.height = 20px
togglebutton.lg.height = 30px
togglebutton.focus.ring.rounding = 6px

# toolbar (preset dashboard/toolbar, sa feuille) : le bouton « … », le bouton « lite » d'icône seule, fait 26 px de haut.
toolbar.overflow.button.height = 26px

# emptycontent (preset emptycontent, sa feuille) : « ou » à 10 px de chacun de ses deux traits.
emptycontent.separator.margin = 0 {emptycontent.separator.gap}

# splitter (styles/splitter) : l'anneau du focus de la pilule, 1 px tout autour.
splitter.handle.focus.ring.border.width = {splitter.handle.focus.ring.width} {splitter.handle.focus.ring.width} {splitter.handle.focus.ring.width} {splitter.handle.focus.ring.width}

# triptych (styles/triptych) : le bouton de fermeture à 3 px du haut et du bord ; le trait du panneau de gauche qui porte
# une languette commence sous elle.
triptych.close.button.margin = {triptych.close.button.offset} {triptych.close.button.offset} 0 0
triptych.left.border.margin = {triptych.toggle.height} 0 0 0

# triptych (feuille du preset dashboard) : le panneau de gauche n'a pas de bordure, sauf celui qui porte une languette,
# dont le contenu s'arrête 2 px avant elle.
triptych.left.plain.border.color = transparent
triptych.left.toggleable.content.margin = 0 2px 0 0

# welcomepanel (feuille du preset dashboard) : 5 px de plus de côté quand il est déplié ; des lignes de 1,42857 fois le
# texte (13 px : 18,57 px), l'icône d'une entrée dans une ligne aussi haute qu'elle (18 et 24 px : 25,71 et 34,29 px) ;
# le trait d'une entrée, à gauche ; 5 px au-dessus et au-dessous du trait entre deux rubriques (les 10 % de chaque bord
# sont dans son gabarit).
welcomepanel.expanded.padding = 10px 5px
welcomepanel.item.line.height = 18.57px
welcomepanel.section.label.line.height = 18.57px
welcomepanel.item.icon.line.height = 25.71px
welcomepanel.item.collapsed.icon.line.height = 34.29px
welcomepanel.item.side.border.width = 0 0 0 {welcomepanel.item.border.width}
welcomepanel.separator.vertical.margin = 5px 0

# treegrid (styles/treegrid) : l'icône d'un nœud à 7 px de sa case, son libellé à 7 px d'elle et du bord droit.
treegrid.node.icon.margin = 0 0 0 {treegrid.body.cell.gap}
treegrid.node.label.margin = 0 {treegrid.body.cell.gap} 0 {treegrid.body.cell.gap}

# confirmdialog : la question passe à la ligne à 420 px (mesure de mkm-wpf : une fenêtre à la taille de son contenu se
# mesure sur une largeur infinie ; 420 px, comme le bloc de l'écran vide).
confirmdialog.message.max.width = 420px

# toggleswitch : la poignée à « gap » du bord de l'interrupteur (inset-inline-start de mkm).
toggleswitch.handle.margin = 0 {toggleswitch.gap}

# scrollpanel : la poignée survolée ou tirée fonce (mkm-wpf : les barres de bureau restent visibles, elles se
# repèrent ainsi sous la souris).
scrollpanel.bar.hover.background = {surface.400}

# skeleton : 12 px de haut par défaut (1rem, la hauteur que mkm lui donne sans Height).
skeleton.height = 12px

# overlaybadge : le contour de la pastille, en épaisseur de bordure (outline.width est un nombre).
overlaybadge.border.width = {overlaybadge.outline.width} {overlaybadge.outline.width}

# toggleswitch : la bordure de la piste (« slider » chez mkm), en épaisseur (border.width est un nombre).
toggleswitch.slider.border.width = {toggleswitch.border.width} {toggleswitch.border.width}

# chip : ses retraits en épaisseurs (padding.x et padding.y sont des nombres) ; retirable, celui de droite est celui du
# haut ; avec une image, ceux du haut et du bas sont de moitié (calc(padding.y / 2) chez mkm : 3 px) et l'image mange
# le retrait de gauche.
chip.padding = {chip.padding.y} {chip.padding.x}
chip.removable.padding = {chip.padding.y} {chip.padding.y} {chip.padding.y} {chip.padding.x}
chip.image.padding = 3px {chip.padding.x} 3px {chip.padding.x}
chip.image.removable.padding = 3px {chip.padding.y} 3px {chip.padding.x}
chip.image.margin = 0 0 0 -{chip.padding.y}

# accordion : la première section bordée de tous côtés (first.border.width est un nombre) ; les coins de l'accordéon,
# ceux du haut sur la première section, ceux du bas sur la dernière (de coin carré quand elle est ouverte : son
# contenu dessous).
accordion.header.first.all.border.width = {accordion.header.first.border.width} {accordion.header.first.border.width}
accordion.header.first.corner.radius = {accordion.header.first.top.border.radius} {accordion.header.first.top.border.radius} 0 0
accordion.header.last.corner.radius = 0 0 {accordion.header.last.bottom.border.radius} {accordion.header.last.bottom.border.radius}
accordion.header.last.active.corner.radius = 0 0 {accordion.header.last.active.bottom.border.radius} {accordion.header.last.active.bottom.border.radius}
accordion.header.single.corner.radius = {accordion.header.first.top.border.radius} {accordion.header.first.top.border.radius} {accordion.header.last.bottom.border.radius} {accordion.header.last.bottom.border.radius}
accordion.header.single.active.corner.radius = {accordion.header.first.top.border.radius} {accordion.header.first.top.border.radius} {accordion.header.last.active.bottom.border.radius} {accordion.header.last.active.bottom.border.radius}

# splitbutton : le bouton principal sans bordure à droite, ses coins de droite carrés ; ceux de gauche du chevron aussi.
splitbutton.button.corner.radius = {button.border.radius} 0 0 {button.border.radius}
splitbutton.dropdown.corner.radius = 0 {button.border.radius} {button.border.radius} 0
splitbutton.button.border.width = 1px 0 1px 1px

# popover : la place de l'ombre (0 1px 2px) autour de la fenêtre (mesure de mkm-wpf, comme tooltip.window.padding) ;
# le cadre à « gutter » de son élément, dessous ou, retourné, dessus ; la flèche de 2 × gutter sur gutter, son milieu à
# arrow.offset du bord (15 − 10 px), posée sur la bordure du cadre qu'elle recouvre.
popover.window.padding = 2px 2px 3px 2px
popover.below.margin = {popover.gutter} 0 0 0
popover.above.margin = 0 0 {popover.gutter} 0
popover.arrow.width = 20px
popover.arrow.margin = 1px 0 0 5px
popover.arrow.flipped.margin = 0 0 1px 5px

# iconfield : l'icône à form.field.padding.x du bord ; le champ recule son texte de deux retraits et de l'icône
# (calc(form.field.padding.x × 2 + icon.size) chez mkm : 7 × 2 + 16 = 30 px), du côté de l'icône.
iconfield.icon.start.margin = 0 0 0 {form.field.padding.x}
iconfield.icon.end.margin = 0 {form.field.padding.x} 0 0
iconfield.start.padding = {inputtext.padding.y} {inputtext.padding.x} {inputtext.padding.y} 30px
iconfield.end.padding = {inputtext.padding.y} 30px {inputtext.padding.y} {inputtext.padding.x}

# inputgroup : les coins du groupe, à gauche sur le premier élément, à droite sur le dernier, aucun au milieu ;
# un complément bordé en haut et en bas, à gauche s'il est le premier ou suit un complément, à droite s'il est le
# dernier (border-block et border-inline chez mkm).
inputgroup.first.corner.radius = {inputgroup.addon.border.radius} 0 0 {inputgroup.addon.border.radius}
inputgroup.last.corner.radius = 0 {inputgroup.addon.border.radius} {inputgroup.addon.border.radius} 0
inputgroup.middle.corner.radius = 0
inputgroup.addon.border.width = 1px 0 1px 0
inputgroup.addon.start.border.width = 1px 0 1px 1px
inputgroup.addon.end.border.width = 1px 1px 1px 0
inputgroup.addon.both.border.width = 1px 1px 1px 1px
# Un complément prend la hauteur du champ de 3DEXPERIENCE (24 px) : son retrait de côté seulement.
inputgroup.addon.inline.padding = 0 {inputgroup.addon.padding}

# listbox : la coche de l'option choisie, ses gouttières en marge (gutter.start et gutter.end sont des nombres).
listbox.checkmark.margin = 0 {listbox.checkmark.gutter.end} 0 {listbox.checkmark.gutter.start}

# multiselect : le libellé du champ, padding.y sur padding.x ; avec des puces, leur moitié autour et entre elles
# (calc(padding / 2) chez mkm), chaque puce à la moitié du retrait vertical, aux coins du champ ; la case d'une option
# à option.gap de son texte ; la liste haute de 14rem au plus (scrollHeight de mkm, en pixels de Dashboard) ; la
# place de l'ombre autour de la liste (mesure de mkm-wpf, comme tooltip.window.padding).
multiselect.label.padding = {multiselect.padding.y} {multiselect.padding.x}
multiselect.chips.padding = 3px 3.5px
multiselect.chips.gap = 3px
multiselect.chip.padding = 3px {chip.padding.y} 3px {chip.padding.x}
multiselect.option.checkbox.margin = 0 {multiselect.option.gap} 0 0
multiselect.list.max.height = 168px
multiselect.overlay.window.padding = 0 2px 3px 2px

# autocomplete : avec le bouton, le champ perd ses coins de droite et le bouton ceux de gauche et sa bordure gauche
# (border-inline-start: 0 chez mkm) ; les suggestions hautes de 14rem au plus (scrollHeight de mkm, en pixels de
# Dashboard).
autocomplete.input.dropdown.corner.radius = {inputtext.border.radius} 0 0 {inputtext.border.radius}
autocomplete.dropdown.corner.radius = 0 {autocomplete.dropdown.border.radius} {autocomplete.dropdown.border.radius} 0
autocomplete.dropdown.border.width = 1px 1px 1px 0
autocomplete.list.max.height = 168px

# stepper : en ligne, le trait à step.gap de l'en-tête ; en colonne, le contenu en retrait du trait (steppanel.indent,
# un nombre).
stepper.separator.horizontal.margin = 0 0 0 {stepper.step.gap}
stepper.steppanel.vertical.margin = 0 0 0 {stepper.steppanel.indent}

# image : la barre de l'aperçu à toolbar.position.top et .right du coin (des nombres).
image.toolbar.margin = {image.toolbar.position.top} {image.toolbar.position.right} 0 0

# imagecompare : la bordure de la poignée en épaisseur (border.width est un nombre) ; la piste du curseur dépasse de
# la moitié de la poignée de chaque côté (calc(-1 * handle.size / 2) chez mkm), pour que la poignée aille aux bords.
imagecompare.handle.all.border.width = {imagecompare.handle.border.width} {imagecompare.handle.border.width}
imagecompare.track.margin = 0 -7.5px 0 -7.5px

# treeselect : le champ de MultiSelect ; la croix qui retire le choix, devant le chevron ; l'arbre s'ouvre sur 240 px
# au plus (scrollHeight 20rem chez mkm).
treeselect.label.padding = {treeselect.padding.y} {treeselect.padding.x}
treeselect.clear.icon.padding = 0 2px 0 2px
treeselect.clear.icon.margin = 0 {treeselect.dropdown.width} 0 0
treeselect.overlay.window.padding = 0 2px 3px 2px
treeselect.tree.max.height = 240px

# cascadeselect : le champ de MultiSelect ; chaque liste dans un cadre ombré, la suivante à droite de son option ;
# l'icône du groupe (option.icon.size) à 6 px du libellé.
cascadeselect.label.padding = {cascadeselect.padding.y} {cascadeselect.padding.x}
cascadeselect.overlay.window.padding = 0 2px 3px 2px
cascadeselect.option.icon.margin = 0 0 0 6px

# slider : la piste du Track dépasse de la moitié de la poignée (handle.width / 2) à chaque bout, pour que la poignée
# se centre sur les bouts comme chez mkm ; la plage commence au bout visible ; en colonne, 100 px au moins.
slider.track.horizontal.margin = 0 -8px 0 -8px
slider.track.vertical.margin = -8px 0 -8px 0
slider.range.horizontal.padding = 0 0 0 8px
slider.range.vertical.padding = 0 0 8px 0
slider.vertical.min.height = 100px

# password : le champ d'InputText ; l'œil à form.field.padding.x du bord droit, le texte s'arrête avant lui
# (padding.x * 2 + icon.size chez mkm) ; le texte d'aide du champ masqué, au retrait du champ plus sa bordure.
password.input.toggle.padding = 4px 30px 4px 6px
password.toggle.margin = 0 {form.field.padding.x} 0 0
password.placeholder.margin = 5px 7px 5px 7px
password.overlay.window.padding = 0 2px 3px 2px

# inputchips : le cadre des champs ; dedans, puces et saisie à padding.y / 2 l'une de l'autre et du bord (calc chez
# mkm) ; la saisie, 40 px au moins.
inputchips.input.padding = 3px {inputchips.padding.x} 3px {inputchips.padding.x}
inputchips.gap = 3px
inputchips.chip.padding = 3px {chip.padding.x} 3px {chip.padding.x}
inputchips.input.min.width = 40px

# floatlabel : le libellé à position.x du bord (plus la bordure) ; envolé, au-dessus (over.active.top), en haut dans
# le champ (in.active.top plus la bordure), ou sur la bordure (centré sur elle : la moitié de sa hauteur, 9 px) ; le
# champ « in » descend son texte sous lui (in.input.padding.top).
floatlabel.label.margin = 0 0 0 8px
floatlabel.over.active.margin = -15px 0 0 8px
floatlabel.in.active.margin = 7px 0 0 8px
floatlabel.on.active.margin = -5px 0 0 6px
floatlabel.in.input.all.padding = 18px 6px 6px 6px

# colorpicker : l'anneau du carré en épaisseur ; la place de l'ombre du panneau.
colorpicker.preview.ring.border.width = {colorpicker.preview.focus.ring.width} {colorpicker.preview.focus.ring.width}
colorpicker.overlay.window.padding = 0 2px 3px 2px

# menubar, megamenu : le début de la barre à gap de ses éléments ; le chevron d'un élément à 6 px de son libellé ; la
# place de l'ombre du panneau.
menubar.start.margin = 0 {menubar.gap} 0 0
megamenu.submenu.icon.margin = 0 0 0 6px
megamenu.overlay.window.padding = 0 2px 3px 2px

# panelmenu : la bordure d'un panneau du milieu en épaisseur ; les coins du premier (en haut), du dernier (en bas) et
# d'un panneau seul ; les éléments d'un élément décalés de submenu.indent ; le chevron à la taille des sous-menus.
panelmenu.panel.all.border.width = {panelmenu.panel.border.width} {panelmenu.panel.border.width}
panelmenu.panel.first.corner.radius = {panelmenu.panel.first.top.border.radius} {panelmenu.panel.first.top.border.radius} 0 0
panelmenu.panel.last.corner.radius = 0 0 {panelmenu.panel.last.bottom.border.radius} {panelmenu.panel.last.bottom.border.radius}
panelmenu.panel.single.corner.radius = {panelmenu.panel.first.top.border.radius} {panelmenu.panel.first.top.border.radius} {panelmenu.panel.last.bottom.border.radius} {panelmenu.panel.last.bottom.border.radius}
panelmenu.submenu.margin = 0 0 0 {panelmenu.submenu.indent}
panelmenu.submenu.icon.size = {navigation.submenu.icon.size}

# buttongroup : les coins du premier bouton (à gauche) et du dernier (à droite).
buttongroup.first.corner.radius = {button.border.radius} 0 0 {button.border.radius}
buttongroup.last.corner.radius = 0 {button.border.radius} {button.border.radius} 0

# dock : l'anneau du focus en épaisseur.
dock.item.ring.border.width = {dock.item.focus.ring.width} {dock.item.focus.ring.width}

# speeddial : le bouton rond de 2,5 rem (le bouton « rounded » de mkm, sans taille à lui).
speeddial.button.size = 30px

# dataview : la bordure du cadre en épaisseur.
dataview.all.border.width = {dataview.border.width} {dataview.border.width}

# orderlist, picklist : les boutons à gap de la liste (à gauche, ou à droite pour la cible d'un PickList) ; l'en-tête
# au-dessus de la liste ; les boutons du milieu d'un PickList à gap des deux listes.
orderlist.controls.margin = 0 {orderlist.gap} 0 0
orderlist.controls.right.margin = 0 0 0 {orderlist.gap}
orderlist.header.margin = 0 0 6px 0
picklist.controls.margin = 0 {picklist.gap} 0 {picklist.gap}

# metergroup : la barre à gap de la légende (dessous, dessus, ou à sa gauche en colonne).
metergroup.meters.end.margin = 0 0 {metergroup.gap} 0
metergroup.meters.start.margin = {metergroup.gap} 0 0 0
metergroup.meters.vertical.margin = 0 {metergroup.gap} 0 0

# organizationchart : le bouton qui replie un nœud, à cheval sur son bas (la moitié de sa taille dessous) ; son
# chevron.
organizationchart.node.toggle.button.margin = 0 0 -9px 0
organizationchart.node.toggle.icon.size = 10px
