toast.info.detail.color = {surface.700}
toast.info.shadow = 0 1px 1px rgba(0, 0, 0, 0.3)
toast.info.close.button.hover.background = transparent
toast.info.close.button.focus.ring.color = transparent
toast.info.close.button.focus.ring.shadow = none
toast.success.background = #edf6eb
toast.success.border.color = {status.success}
toast.success.color = {surface.700}
toast.success.detail.color = {surface.700}
toast.success.shadow = 0 1px 1px rgba(0, 0, 0, 0.3)
toast.success.close.button.hover.background = transparent
toast.success.close.button.focus.ring.color = transparent
toast.success.close.button.focus.ring.shadow = none
toast.warn.background = #fff3e9
toast.warn.border.color = {status.warn}
toast.warn.color = {surface.700}
toast.warn.detail.color = {surface.700}
toast.warn.shadow = 0 1px 1px rgba(0, 0, 0, 0.3)
toast.warn.close.button.hover.background = transparent
toast.warn.close.button.focus.ring.color = transparent
toast.warn.close.button.focus.ring.shadow = none
toast.error.background = #fff0ee
toast.error.border.color = {status.danger}
toast.error.color = {surface.700}
toast.error.detail.color = {surface.700}
toast.error.shadow = 0 1px 1px rgba(0, 0, 0, 0.3)
toast.error.close.button.hover.background = transparent
toast.error.close.button.focus.ring.color = transparent
toast.error.close.button.focus.ring.shadow = none
toast.secondary.background = {surface.200}
toast.secondary.border.color = {surface.200}
toast.secondary.color = {surface.700}
toast.secondary.detail.color = {surface.700}
toast.secondary.shadow = {overlay.popover.shadow}
toast.secondary.close.button.hover.background = {surface.50}
toast.secondary.close.button.focus.ring.color = {surface.700}
toast.secondary.close.button.focus.ring.shadow = none
toast.contrast.background = {surface.900}
toast.contrast.border.color = {surface.900}
toast.contrast.color = {surface.50}
toast.contrast.detail.color = {surface.0}
toast.contrast.shadow = 0px 4px 8px 0px color-mix(in srgb, {surface.950}, transparent 96%)
toast.contrast.close.button.hover.background = {surface.700}
toast.contrast.close.button.focus.ring.color = {surface.50}
toast.contrast.close.button.focus.ring.shadow = none

# tooltip
tooltip.max.width = 150px
tooltip.gutter = 3px
tooltip.shadow = {overlay.popover.shadow}
tooltip.padding = 4px 8px
tooltip.border.radius = {border.radius.xs}
tooltip.background = {surface.700}
tooltip.color = {surface.0}
