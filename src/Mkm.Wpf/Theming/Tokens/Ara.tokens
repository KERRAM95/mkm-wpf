treeselect.overlay.color = {overlay.select.color}
treeselect.overlay.shadow = {overlay.select.shadow}
treeselect.tree.padding = {list.padding}
treeselect.tree.loading.min.height = 36px
treeselect.empty.message.padding = {list.option.padding}
treeselect.chip.border.radius = {border.radius.sm}
treeselect.clear.icon.color = {form.field.icon.color}

# triptych
triptych.background = {surface.0}
triptych.color = {surface.700}
triptych.transition.duration = 0.4s
triptych.left.background = {surface.50}
triptych.left.color = {surface.700}
triptych.left.border.color = {surface.300}
triptych.main.background = {surface.0}
triptych.main.color = {surface.700}
triptych.right.background = {surface.0}
triptych.right.color = {surface.700}
triptych.right.border.color = {surface.300}
triptych.gutter.size = 10px
triptych.handle.width = 4px
triptych.handle.height = 40px
triptych.handle.background = transparent
triptych.handle.hover.background = {surface.400}
triptych.handle.border.radius = 999px
triptych.handle.transition.duration = 0.12s
triptych.handle.focus.ring.width = {focus.ring.width}
triptych.handle.focus.ring.style = {focus.ring.style}
triptych.handle.focus.ring.color = {focus.ring.color}
triptych.handle.focus.ring.offset = {focus.ring.offset}
triptych.handle.focus.ring.shadow = {focus.ring.shadow}
triptych.toggle.width = 25px
triptych.toggle.height = 45px
triptych.toggle.background = {surface.50}
triptych.toggle.border.color = {surface.300}
triptych.toggle.color = {surface.500}
triptych.toggle.hover.color = {text.color}
triptych.toggle.hover.background = {surface.50}
triptych.toggle.top = 0
triptych.toggle.border.width = 0 1px 1px 0
triptych.toggle.border.radius = 0
triptych.toggle.shadow = none
triptych.toggle.padding = 10px 5.8px 8px 0
triptych.toggle.icon.width = 18.2px
triptych.toggle.icon.height = 26px
triptych.close.button.offset = 3px
triptych.mask.left.background = rgba(0, 0, 0, 0.5)
triptych.mask.right.background = color-mix(in srgb, {surface.500} 60%, transparent)
triptych.mask.modal.background = rgba(0, 0, 0, 0.37)

# welcomepanel
welcomepanel.background = {surface.50}
welcomepanel.color = {surface.700}
welcomepanel.padding = 10px 0
welcomepanel.transition.duration = {transition.duration}
welcomepanel.header.padding = 5px 10px
welcomepanel.title.padding = 5px
welcomepanel.title.color = {surface.500}
welcomepanel.title.font.size = 22px
welcomepanel.title.font.weight = 700
welcomepanel.description.padding = 5px
welcomepanel.description.color = {surface.500}
welcomepanel.description.font.size = 13px
welcomepanel.description.font.weight = 700
welcomepanel.section.padding = 5px 10px
welcomepanel.section.collapsed.padding = 2px
welcomepanel.section.label.padding = 0 0 0 5px
welcomepanel.section.label.color = {surface.700}
welcomepanel.section.label.font.size = 13px
welcomepanel.section.label.font.weight = 700
welcomepanel.list.gap = 0
welcomepanel.item.padding = 5px
welcomepanel.item.gap = 5px
welcomepanel.item.border.radius = 0
welcomepanel.item.border.width = 2px
welcomepanel.item.font.size = 13px
welcomepanel.item.font.weight = 700
welcomepanel.item.color = {surface.500}
welcomepanel.item.hover.color = {surface.700}
welcomepanel.item.hover.background = transparent
welcomepanel.item.hover.border.color = transparent
welcomepanel.item.selected.color = {primary.500}
welcomepanel.item.selected.background = transparent
welcomepanel.item.selected.border.color = {primary.500}
welcomepanel.item.focus.ring.width = {focus.ring.width}
welcomepanel.item.focus.ring.style = {focus.ring.style}
welcomepanel.item.focus.ring.color = {focus.ring.color}
welcomepanel.item.focus.ring.offset = -1px
welcomepanel.item.focus.ring.shadow = {focus.ring.shadow}
welcomepanel.item.icon.size = 18px
welcomepanel.item.collapsed.padding = 4px
welcomepanel.item.collapsed.icon.size = 24px
welcomepanel.separator.margin = 5px 10%
welcomepanel.separator.border.color = {surface.200}
welcomepanel.footer.padding = 5px 10px
