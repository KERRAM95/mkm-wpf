menu.css = 
    .p-menu-item-link {
        min-height: dt('mkm.navigation.item.height');
    }

    .p-menu-item-link:not(:has(> .p-menu-item-icon)) {
        padding-inline-start: dt('mkm.navigation.icon.column.width');
    }

    .p-menu-item-shortcut {
        font-size: 11px;
    }


# tooltip
tooltip.max.width = 150px
tooltip.gutter = 3px
tooltip.shadow = {overlay.popover.shadow}
tooltip.padding = 4px 8px
tooltip.border.radius = {border.radius.xs}
tooltip.background = {surface.700}
tooltip.color = {surface.0}
