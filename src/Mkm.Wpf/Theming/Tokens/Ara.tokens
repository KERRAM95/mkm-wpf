# contextmenu
contextmenu.background = {content.background}
contextmenu.border.color = {content.border.color}
contextmenu.color = {content.color}
contextmenu.border.radius = {border.radius.none}
contextmenu.shadow = {overlay.navigation.shadow}
contextmenu.transition.duration = {transition.duration}
contextmenu.min.width = 90px
contextmenu.list.padding = {navigation.list.padding}
contextmenu.list.gap = {navigation.list.gap}
contextmenu.item.focus.background = {navigation.item.focus.background}
contextmenu.item.active.background = {navigation.item.active.background}
contextmenu.item.color = {navigation.item.color}
contextmenu.item.focus.color = {navigation.item.focus.color}
contextmenu.item.active.color = {navigation.item.active.color}
contextmenu.item.padding = 0 14px
contextmenu.item.border.radius = {navigation.item.border.radius}
contextmenu.item.gap = 14px
contextmenu.item.icon.color = {navigation.item.icon.color}
contextmenu.item.icon.focus.color = {navigation.item.icon.focus.color}
contextmenu.item.icon.active.color = {navigation.item.icon.active.color}
contextmenu.item.shortcut.color = {text.muted.color}
contextmenu.submenu.mobile.indent = 12px
contextmenu.submenu.icon.size = {navigation.submenu.icon.size}
contextmenu.submenu.icon.color = {navigation.submenu.icon.color}
contextmenu.submenu.icon.focus.color = {navigation.submenu.icon.focus.color}
contextmenu.submenu.icon.active.color = {navigation.submenu.icon.active.color}
contextmenu.separator.border.color = {surface.200}
contextmenu.css = 
    .p-contextmenu {
        --p-anchor-gutter: 0px;
        --p-anchor-overflow: viewport;
        will-change: auto;
    }

    .p-contextmenu:is(.p-anchored-overlay-enter-active, .p-anchored-overlay-leave-active) {
        animation: none;
    }

    .p-contextmenu-item-link {
        min-height: dt('mkm.navigation.item.height');
    }

    .p-contextmenu-item-link:not(:has(> .p-contextmenu-item-icon)) {
        padding-inline-start: dt('mkm.navigation.icon.column.width');
    }

    :is(.p-contextmenu-root-list, .p-contextmenu-submenu):not(:has(> .p-contextmenu-item > .p-contextmenu-item-content .p-contextmenu-item-icon))
        > .p-contextmenu-item
        > .p-contextmenu-item-content
        > .p-contextmenu-item-link {
        padding-inline-start: 14px;
    }

    .p-contextmenu-item-label {
        align-self: flex-start;
        overflow: hidden;
        line-height: dt('mkm.navigation.item.height');
        white-space: nowrap;
    }

    .p-contextmenu-item-label:last-child {
        flex: 1 1 auto;
        margin-inline-end: -14px;
        padding-inline-end: 14px;
    }

    :is(.p-contextmenu-root-list, .p-contextmenu-submenu) > .p-contextmenu-item:is(:first-child, :last-child) > .p-contextmenu-item-content > .p-contextmenu-item-link {
        height: calc(dt('mkm.navigation.item.height') - 1px);
        min-height: 0;
    }

    :is(.p-contextmenu-root-list, .p-contextmenu-submenu) > .p-contextmenu-item:first-child:last-child > .p-contextmenu-item-content > .p-contextmenu-item-link {
        height: calc(dt('mkm.navigation.item.height') - 2px);
    }

    .p-contextmenu-item.p-disabled {
        opacity: 1;
    }

    .p-contextmenu-item.p-disabled > .p-contextmenu-item-content {
        color: dt('surface.400');
    }

    .p-contextmenu-item.p-disabled > .p-contextmenu-item-content .p-contextmenu-item-icon {
        color: dt('surface.300');
        filter: grayscale(1) opacity(0.5);
    }

    :is(.p-contextmenu-root-list, .p-contextmenu-submenu) > .p-contextmenu-item.p-disabled:is(:first-child, :last-child) > .p-contextmenu-item-content::before {
        content: '';
        position: absolute;
        left: 0;
        width: dt('mkm.navigation.icon.column.width');
        height: 1px;
        background: dt('surface.200');
    }

    :is(.p-contextmenu-root-list, .p-contextmenu-submenu) > .p-contextmenu-item.p-disabled:first-child > .p-contextmenu-item-content::before {
        top: -1px;
    }

    :is(.p-contextmenu-root-list, .p-contextmenu-submenu) > .p-contextmenu-item.p-disabled:last-child:not(:first-child) > .p-contextmenu-item-content::before {
        bottom: -1px;
    }

    .p-contextmenu-keyboard :is(.p-contextmenu-root-list, .p-contextmenu-submenu) > .p-contextmenu-item.p-focus > .p-contextmenu-item-content::after {
        content: '';
        position: absolute;
        inset: 0 -1px -1px;
        z-index: 1;
        box-shadow: inset 0 0 0 2px dt('surface.500');
        pointer-events: none;
    }

    .p-contextmenu-keyboard :is(.p-contextmenu-root-list, .p-contextmenu-submenu) > .p-contextmenu-item.p-focus:first-child > .p-contextmenu-item-content::after {
        top: -1px;
    }

    .p-contextmenu-item-link:is(:hover, :focus) {
        text-decoration: none;
    }

    .p-contextmenu-item-shortcut {
        font-size: 11px;
    }


